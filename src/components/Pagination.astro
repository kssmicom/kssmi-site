---
/**
 * Pagination.astro - Shared pagination component with go-to-page input
 *
 * Props:
 *   currentPage  - Current active page number (1-based)
 *   lastPage     - Total number of pages
 *   basePath     - Base URL path without trailing slash (e.g., "/product", "/it/product")
 *   categorySlug - Optional category slug for category pages (e.g., "sunglasses")
 *   prevUrl      - Optional override URL for the Previous button
 *   nextUrl      - Optional override URL for the Next button
 *   prevLabel    - Label for Previous button (translated)
 *   nextLabel    - Label for Next button (translated)
 *   goToLabel    - Accessible label for the go-to-page input
 *   dir          - Text direction ("ltr" or "rtl")
 */

import { translations, getTranslations, type Translations } from '../translations';

export interface Props {
  currentPage: number;
  lastPage: number;
  basePath: string;
  categorySlug?: string;
  prevUrl?: string | undefined;
  nextUrl?: string | undefined;
  prevLabel?: string;
  nextLabel?: string;
  goToLabel?: string;
  goToButton?: string;
  dir?: string;
  lang?: string;
}

const {
  currentPage,
  lastPage,
  basePath,
  categorySlug,
  prevUrl,
  nextUrl,
  lang,
  dir = 'ltr',
} = Astro.props;

const isRTL = dir === 'rtl';
const t = lang ? (translations[lang as keyof typeof translations] || await getTranslations('en')) : null;

const prevLabel = Astro.props.prevLabel ?? (t?.product?.previousPage ?? 'Previous');
const nextLabel = Astro.props.nextLabel ?? (t?.product?.nextPage ?? 'Next');
const goToLabel = Astro.props.goToLabel ?? (t?.product?.goToPage ?? 'Go to page');
const goToButton = Astro.props.goToButton ?? (t?.product?.goToButton ?? 'Go');
---

{
  lastPage > 1 && (
    <nav class="mt-12 flex justify-center items-center gap-2" dir={dir} aria-label="Pagination">
      <!-- Previous Button -->
      {currentPage > 1 ? (
        <a
          href={prevUrl ?? (categorySlug
            ? `${basePath}/${categorySlug}/${currentPage - 1}`
            : currentPage === 2
              ? basePath
              : `${basePath}/${currentPage - 1}`
          )}
          class="flex items-center gap-1 px-2 py-1.5 sm:px-4 sm:py-2 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors"
          aria-label={prevLabel}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={isRTL ? "M9 5l7 7-7 7" : "M15 19l-7-7 7-7"} />
          </svg>
          <span class="hidden sm:inline">{prevLabel}</span>
        </a>
      ) : (
        <span class="flex items-center gap-1 px-2 py-1.5 sm:px-4 sm:py-2 border border-gray-200 rounded-lg text-gray-500 cursor-not-allowed">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={isRTL ? "M9 5l7 7-7 7" : "M15 19l-7-7 7-7"} />
          </svg>
          <span class="hidden sm:inline">{prevLabel}</span>
        </span>
      )}

      <!-- Page Numbers - Desktop -->
      <div class="hidden sm:flex items-center gap-1">
        <!-- First page -->
        <a
          href={categorySlug ? `${basePath}/${categorySlug}` : basePath}
          class={`w-10 h-10 flex items-center justify-center rounded-lg text-sm font-medium transition-colors ${
            currentPage === 1
              ? 'bg-[#5D4E37] text-white shadow-xs'
              : 'border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37]'
          }`}
          aria-current={currentPage === 1 ? 'page' : undefined}
          aria-label="Page 1"
        >
          1
        </a>

        <!-- Ellipsis before current if needed -->
        {currentPage > 3 && (
          <span class="px-2 text-gray-500">...</span>
        )}

        <!-- Pages around current -->
        {Array.from({ length: lastPage }, (_, i) => i + 1)
          .filter(p => p > 1 && p < lastPage && Math.abs(p - currentPage) <= 1)
          .map(p => (
            <a
              href={categorySlug ? `${basePath}/${categorySlug}/${p}` : `${basePath}/${p}`}
              class={`w-10 h-10 flex items-center justify-center rounded-lg text-sm font-medium transition-colors ${
                p === currentPage
                  ? 'bg-[#5D4E37] text-white shadow-xs'
                  : 'border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37]'
              }`}
            >
              {p}
            </a>
          ))}

        {/* Ellipsis after current if needed */}
        {currentPage < lastPage - 2 && (
          <span class="px-2 text-gray-500">...</span>
        )}

        {/* Last page */}
        {lastPage > 1 && (
          <a
            href={categorySlug ? `${basePath}/${categorySlug}/${lastPage}` : `${basePath}/${lastPage}`}
            class={`w-10 h-10 flex items-center justify-center rounded-lg text-sm font-medium transition-colors ${
              currentPage === lastPage
                ? 'bg-[#5D4E37] text-white shadow-xs'
                : 'border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37]'
            }`}
            aria-current={currentPage === lastPage ? 'page' : undefined}
          >
            {lastPage}
          </a>
        )}
      </div>

      <!-- Mobile Page Numbers (max 3 buttons) -->
      <div class="flex sm:hidden items-center gap-1 flex-nowrap">
        {currentPage !== lastPage ? (
          <>
            <span class="w-11 h-11 flex items-center justify-center rounded-sm text-xs font-medium bg-[#5D4E37] text-white shadow-xs" aria-current="page">
              {currentPage}
            </span>
            {currentPage + 1 < lastPage ? (
              <>
                <a
                  href={categorySlug ? `${basePath}/${categorySlug}/${currentPage + 1}` : `${basePath}/${currentPage + 1}`}
                  class="w-11 h-11 flex items-center justify-center rounded-sm text-xs font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors"
                >
                  {currentPage + 1}
                </a>
                {currentPage + 1 < lastPage - 1 ? (
                  <span class="text-gray-500 text-xs px-0.5">...</span>
                ) : currentPage + 2 === lastPage && (
                  <a
                    href={categorySlug ? `${basePath}/${categorySlug}/${currentPage + 2}` : `${basePath}/${currentPage + 2}`}
                    class="w-11 h-11 flex items-center justify-center rounded-sm text-xs font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors"
                  >
                    {currentPage + 2}
                  </a>
                )}
              </>
            ) : (
              currentPage + 1 === lastPage && (
                <a
                  href={categorySlug ? `${basePath}/${categorySlug}/${lastPage}` : `${basePath}/${lastPage}`}
                  class="w-11 h-11 flex items-center justify-center rounded-sm text-xs font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors"
                >
                  {lastPage}
                </a>
              )
            )}
            {currentPage + 1 < lastPage - 1 && (
              <a
                href={categorySlug ? `${basePath}/${categorySlug}/${lastPage}` : `${basePath}/${lastPage}`}
                class="w-11 h-11 flex items-center justify-center rounded-sm text-xs font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors"
              >
                {lastPage}
              </a>
            )}
          </>
        ) : (
          <>
            <a
              href={categorySlug ? `${basePath}/${categorySlug}` : basePath}
              class="w-11 h-11 flex items-center justify-center rounded-sm text-xs font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors"
            >
              1
            </a>
            {lastPage > 3 && (
              <span class="text-gray-500 text-xs px-0.5">...</span>
            )}
            {lastPage > 2 && (
              <a
                href={categorySlug ? `${basePath}/${categorySlug}/${lastPage - 1}` : `${basePath}/${lastPage - 1}`}
                class="w-11 h-11 flex items-center justify-center rounded-sm text-xs font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors"
              >
                {lastPage - 1}
              </a>
            )}
            <span class="w-11 h-11 flex items-center justify-center rounded-sm text-xs font-medium bg-[#5D4E37] text-white shadow-xs" aria-current="page">
              {lastPage}
            </span>
          </>
        )}
      </div>

      <!-- Go to Page Input -->
      <div class="pagination-goto-form flex items-center gap-1">
        <span class="hidden sm:inline text-gray-400 text-sm">|</span>
        <input
          type="text"
          inputmode="numeric"
          pattern="[0-9]*"
          maxlength={String(lastPage).length}
          placeholder="#"
          class="pagination-goto-input w-10 sm:w-14 h-10 text-center border border-gray-200 rounded-lg text-sm text-gray-600 focus:outline-hidden focus:border-[#8B7355] focus:ring-1 focus:ring-[#8B7355]"
          aria-label={goToLabel}
          data-base-path={basePath}
          data-category-slug={categorySlug || ''}
          data-last-page={lastPage}
        />
        <button
          type="button"
          class="pagination-goto-btn group px-2 h-10 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors cursor-pointer"
          aria-label={goToButton}
        >
          <svg class="w-4 h-4 transition-transform duration-200 motion-safe:group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </div>

      <!-- Next Button -->
      {currentPage < lastPage ? (
        <a
          href={nextUrl ?? (categorySlug ? `${basePath}/${categorySlug}/${currentPage + 1}` : `${basePath}/${currentPage + 1}`)}
          class="flex items-center gap-1 px-2 py-1.5 sm:px-4 sm:py-2 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 hover:border-[#8B7355] hover:text-[#5D4E37] transition-colors"
          aria-label={nextLabel}
        >
          <span class="hidden sm:inline">{nextLabel}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={isRTL ? "M15 19l-7-7 7-7" : "M9 5l7 7-7 7"} />
          </svg>
        </a>
      ) : (
        <span class="flex items-center gap-1 px-2 py-1.5 sm:px-4 sm:py-2 border border-gray-200 rounded-lg text-gray-500 cursor-not-allowed">
          <span class="hidden sm:inline">{nextLabel}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={isRTL ? "M15 19l-7-7 7-7" : "M9 5l7 7-7 7"} />
          </svg>
        </span>
      )}
    </nav>
  )
}

<script is:inline>
  // AbortController for cleanup on View Transition re-navigation
  if (window.__paginationAbort) {
    window.__paginationAbort.abort();
  }
  window.__paginationAbort = new AbortController();
  var paginationSignal = window.__paginationAbort.signal;

  function goToPage(input) {
    var raw = input.value.trim();
    if (!raw) return;
    var page = parseInt(raw, 10);
    if (isNaN(page)) return;
    var basePath = input.getAttribute('data-base-path') || '';
    var categorySlug = input.getAttribute('data-category-slug') || '';
    var lastPage = parseInt(input.getAttribute('data-last-page') || '1', 10);
    if (page < 1 || page > lastPage) return;
    var url;
    if (page === 1) {
      url = categorySlug ? basePath + '/' + categorySlug : basePath;
    } else {
      url = categorySlug ? basePath + '/' + categorySlug + '/' + page : basePath + '/' + page;
    }
    window.location.href = url;
  }

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.pagination-goto-btn');
    if (!btn) return;
    var container = btn.closest('.pagination-goto-form');
    if (!container) return;
    var input = container.querySelector('.pagination-goto-input');
    if (!input) return;
    goToPage(input);
  }, { signal: paginationSignal });

  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter') return;
    var input = e.target.closest('.pagination-goto-input');
    if (!input) return;
    e.preventDefault();
    goToPage(input);
  }, { signal: paginationSignal });
</script>
