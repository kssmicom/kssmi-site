---

import { translations } from '../translations';
import { cardSrc } from '../utils/image';

interface Props {
  product: any;
  lang: string;
  index?: number;
}

const { product, lang, index = -1 } = Astro.props;

// First 8 products load eager (covers visible viewport on most screens)
// Only index 0 gets sync decode + high fetchpriority (the true LCP candidate)
// Others use async decode to avoid blocking the main thread (reduces TBT)
const isEager = index >= 0 && index < 8;
const loadingStrategy = isEager ? "eager" : "lazy";
const fetchPriority = index === 0 ? "high" : "auto";
const decoding = index === 0 ? "sync" : "async";

// Skip rendering for cards below first 2 rows to reduce initial layout work
const belowFold = index >= 6;

// Access data correctly - slug and other fields are inside data
const { data } = product;
const {
  title,
  slug,      // slug is inside data, not at product level
  itemNo,
  cover,
  categories
} = data;

const isRTL = lang === 'ar';
const t = translations[lang] || translations.en;
const currentPath = lang === 'en' ? '' : `${lang}/`;

// Use slug from data, fallback to extracting from ID
const productSlug = slug || product.id.split('.')[0];

// Use 400px card variant when available (smaller file, faster load on listing grids)
const coverSrc = cardSrc(cover);

---

<a href={`/${currentPath}product/${productSlug}`} class="group block" dir={isRTL ? 'rtl' : 'ltr'}>
  <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-all duration-300" style={belowFold ? "content-visibility:auto;contain-intrinsic-size:auto 360px" : ""}>
    <!-- Product Image with Hover Overlay -->
    <div class="relative aspect-[4/3] overflow-hidden bg-gray-100" data-product-cover>
      {cover ? (
        <img
          src={coverSrc}
          alt={title}
          width="400"
          height="300"
          sizes="(min-width: 1280px) 33vw, (min-width: 1024px) 25vw, (min-width: 640px) 50vw, 50vw"
          class="w-full h-full object-cover motion-safe:group-hover:scale-105 transition-transform duration-500"
          decoding={decoding}
          loading={loadingStrategy}
          fetchpriority={fetchPriority}
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
          <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      )}

      <!-- Hover Overlay with "View Details" -->
      <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300 flex items-center justify-center">
        <span class="bg-black text-white px-4 py-2 rounded-lg font-semibold text-sm flex items-center gap-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
          {t.product?.viewDetails || 'View Details'}
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </div>

    <!-- Product Info - Center Aligned -->
    <div class="p-4 xl:p-5 text-center">
      <!-- Item No (main identifier) - Bold -->
      {itemNo && (
        <p class="text-xs xl:text-sm text-[#6B5340] font-bold mb-1 xl:mb-2">
          {itemNo}
        </p>
      )}

      <!-- Product Title -->
      <h2 class="text-xs font-semibold text-gray-900 group-hover:text-[#5D4E37] transition-colors leading-tight">
        {title}
      </h2>
    </div>
  </div>
</a>
