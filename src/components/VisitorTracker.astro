---
// VisitorTracker.astro - Injects the VJT tracking script on all pages
// Include this in Layout.astro before </body>
import { runtimeAssetUrl } from '../config/runtimeAssets.mjs';

const isDev = import.meta.env.DEV;
const allowLocalVjt = import.meta.env.PUBLIC_ENABLE_LOCAL_VJT === 'true';
const trackerScriptUrl = isDev
  ? 'http://localhost:4325/js/vjt-tracker.js'
  : runtimeAssetUrl('vjt-tracker');
const vjtLoaderUrl = isDev ? '/js/vjt-loader.js' : runtimeAssetUrl('vjt-loader');
const contactCoreUrl = isDev ? '/js/vjt-contact-core.js' : runtimeAssetUrl('vjt-contact-core');
const capabilityProofUrl = runtimeAssetUrl('vjt-capability-proof');
const contactIntentUrl = isDev
  ? 'http://localhost:4325/api/track-contact-intent.php'
  : '/api/track-contact-intent.php';
const capabilityUrl = isDev
  ? 'http://localhost:4325/api/vjt-capability.php'
  : '/api/vjt-capability.php';
// VJT capability proofs use their own Invisible Turnstile widget. Without
// this key the proof provider stays disabled (statistics only); it never
// falls back to the inquiry form's Managed key, which can show a checkbox.
const turnstileSiteKey = import.meta.env.PUBLIC_VJT_TURNSTILE_SITE_KEY;
---

{isDev && (
  <script is:inline>
    var vjtDevHostname = window.location.hostname === '127.0.0.1'
      ? '127.0.0.1'
      : ((window.location.hostname === '::1' || window.location.hostname === '[::1]') ? '[::1]' : 'localhost');
    var vjtDevApiOrigin = 'http://' + vjtDevHostname + ':4325';
    window.VJTTracker = {
      // Consent-gated: enabled only while ConsentController reports a current
      // analytics consent cycle (it also calls VJT_init when consent is given).
      get enabled() { try { return !!(window.__kssmiConsent && window.__kssmiConsent.trackingCycle()); } catch(e) { return false; } }, set enabled(v) {},
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: vjtDevApiOrigin + '/api/track-pageview.php',
        submission: vjtDevApiOrigin + '/api/track-submission.php',
        config: vjtDevApiOrigin + '/api/vjt-config.php',
        capability: vjtDevApiOrigin + '/api/vjt-capability.php',
        forget: vjtDevApiOrigin + '/api/vjt-forget.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

{!isDev && (
  <script is:inline>
    window.VJTTracker = {
      // Consent-gated: enabled only while ConsentController reports a current
      // analytics consent cycle (it also calls VJT_init when consent is given).
      get enabled() { try { return !!(window.__kssmiConsent && window.__kssmiConsent.trackingCycle()); } catch(e) { return false; } }, set enabled(v) {},
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: '/api/track-pageview.php',
        submission: '/api/track-submission.php',
        config: '/api/vjt-config.php',
        capability: '/api/vjt-capability.php',
        forget: '/api/vjt-forget.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

<!-- The capability issuer verifies this proof server-side. It is intentionally
     separate from the inquiry-form widget so analytics/contact capabilities
     can be minted only after a fresh, single-use Turnstile response. -->
{!isDev && (
  <script is:inline src={capabilityProofUrl} data-sitekey={turnstileSiteKey || ''}></script>
)}
{isDev && (
  <script is:inline>
    // The PHP issuer accepts this only when its TCP peer and Host are both
    // loopback. Production never receives this development placeholder.
    window.KSSMI_VJT_CAPABILITY_PROOF = function() { return Promise.resolve('local-development'); };
  </script>
)}

<!-- Contact Core is independent of analytics consent and never owns navigation.
     It submits only a minimal event unless current analytics consent allows the
     server to validate and attach an existing Journey. -->
<script
  is:inline
  src={contactCoreUrl}
  data-contact-intent-url={contactIntentUrl}
  data-capability-url={capabilityUrl}
  data-dev={isDev ? 'true' : 'false'}
></script>

<!-- Tracker remains analytics-consent gated, but starts immediately once allowed
     so a visitor cannot click WhatsApp/Email before its listener is bound.
     The bootstrap is a classic external script (public/js/vjt-loader.js) at the
     same position the inline copy had; it reads these data-* values itself. -->
<script
  is:inline
  src={vjtLoaderUrl}
  data-tracker-url={trackerScriptUrl}
  data-allow-local-vjt={allowLocalVjt ? 'true' : 'false'}
  data-dev={isDev ? 'true' : 'false'}
></script>
