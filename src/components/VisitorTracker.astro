---
// VisitorTracker.astro - Injects the VJT tracking script on all pages
// Include this in Layout.astro before </body>

const isDev = import.meta.env.DEV;
const trackerScriptUrl = isDev
  ? 'http://localhost:4325/js/vjt-tracker.js?v=9'
  : '/js/vjt-tracker.js?v=9';
---

{isDev && (
  <script is:inline>
    window.VJTTracker = {
      enabled: true,
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: 'http://localhost:4325/api/track-pageview.php',
        submission: 'http://localhost:4325/api/track-submission.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

{!isDev && (
  <script is:inline>
    window.VJTTracker = {
      enabled: true,
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: '/api/track-pageview.php',
        submission: '/api/track-submission.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

<!-- Defer tracker script injection until after critical rendering (3s delay) -->
<script is:inline define:vars={{ trackerScriptUrl }}>
  (function() {
    var loaded = false;
    function injectTracker() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.src = trackerScriptUrl;
      s.defer = true;
      document.head.appendChild(s);
    }
    // Load after 3s idle to avoid competing with critical rendering
    setTimeout(injectTracker, 3000);
    // On SPA navigations, call init directly instead of re-downloading the script
    document.addEventListener('astro:page-load', function() {
      if (window.VJT_init) {
        // Already loaded — just re-init with updated config and URL (I1 fix)
        window.VJTTracker.page.url = window.location.href;
        window.VJTTracker.page.title = document.title || '';
        window.VJT_init();
      } else {
        // First load hasn't happened yet — inject script
        loaded = false;
        setTimeout(injectTracker, 1000);
      }
    });
  })();
</script>
