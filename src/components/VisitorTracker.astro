---
// VisitorTracker.astro - Injects the VJT tracking script on all pages
// Include this in Layout.astro before </body>

const isDev = import.meta.env.DEV;
const allowLocalVjt = import.meta.env.PUBLIC_ENABLE_LOCAL_VJT === 'true';
const trackerScriptUrl = isDev
  ? 'http://localhost:4325/js/vjt-tracker.js'
  : '/assets/runtime/vjt-tracker.47b84d55bfd9.js';
const contactIntentUrl = isDev
  ? 'http://localhost:4325/api/track-contact-intent.php'
  : '/api/track-contact-intent.php';
---

{isDev && (
  <script is:inline>
    window.VJTTracker = {
      // Consent-gated: only enabled once the visitor grants analytics consent.
      // The cookie banner flips this on (and calls VJT_init) when consent is given.
      get enabled() { try { var c = JSON.parse(localStorage.getItem('cookie-consent')); return c ? !!c.analytics : false; } catch(e) { return false; } }, set enabled(v) {},
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: 'http://localhost:4325/api/track-pageview.php',
        submission: 'http://localhost:4325/api/track-submission.php',
        config: 'http://localhost:4325/api/vjt-config.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

{!isDev && (
  <script is:inline>
    window.VJTTracker = {
      // Consent-gated: only enabled once the visitor grants analytics consent.
      // The cookie banner flips this on (and calls VJT_init) when consent is given.
      get enabled() { try { var c = JSON.parse(localStorage.getItem('cookie-consent')); return c ? !!c.analytics : false; } catch(e) { return false; } }, set enabled(v) {},
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: '/api/track-pageview.php',
        submission: '/api/track-submission.php',
        config: '/api/vjt-config.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

<!-- Contact Core is independent of analytics consent and never owns navigation.
     It submits only a minimal event unless current analytics consent allows the
     server to validate and attach an existing Journey. -->
<script is:inline define:vars={{ contactIntentUrl }}>
  (function() {
    if (window.__vjtContactCoreBound) return;
    window.__vjtContactCoreBound = true;

    function readJson(key) {
      try {
        var value = localStorage.getItem(key);
        return value ? JSON.parse(value) : null;
      } catch (_) {
        return null;
      }
    }

    function readCookie(name) {
      var prefix = name + '=';
      var parts = document.cookie ? document.cookie.split(';') : [];
      for (var i = 0; i < parts.length; i++) {
        var part = parts[i].trim();
        if (part.indexOf(prefix) === 0) return decodeURIComponent(part.slice(prefix.length));
      }
      return '';
    }

    function newCoreEventId() {
      try {
        if (window.crypto && typeof window.crypto.randomUUID === 'function') {
          return 'vjtce_' + window.crypto.randomUUID().replace(/-/g, '');
        }
      } catch (_) {}
      return 'vjtce_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 14);
    }

    function resolveAnchor(target) {
      var node = target;
      while (node && node.tagName) {
        if (node.tagName.toLowerCase() === 'a') return node;
        node = node.parentElement;
      }
      return null;
    }

    function addAnalyticsLinkage(payload) {
      var consent = readJson('cookie-consent');
      if (!consent || consent.analytics !== true) return;

      // These analytics values are read only after current analytics consent.
      var visitorId = '';
      try { visitorId = localStorage.getItem('vjt_visitor_id') || ''; } catch (_) {}
      if (!visitorId) visitorId = readCookie('vjt_visitor_id');

      var session = readJson('vjt_session_meta');
      var pageview = readJson('vjt_current_pageview');
      var sessionId = session && typeof session.id === 'string' ? session.id : readCookie('vjt_session_id');
      if (!/^vjtv_[A-Za-z0-9_-]{8,60}$/.test(visitorId)
          || !/^vjts_[A-Za-z0-9_-]{8,60}$/.test(sessionId)) return;

      payload.analytics = true;
      payload.vjt_visitor_id = visitorId;
      payload.vjt_session_id = sessionId;
      if (pageview && pageview.session_id === sessionId) {
        var step = Number(pageview.step_order);
        if (step >= 1 && step <= 10000) payload.journey_step = Math.floor(step);
      }
    }

    function sendIntent(payload) {
      var body = JSON.stringify(payload);
      if (navigator.sendBeacon) {
        try {
          if (navigator.sendBeacon(contactIntentUrl, new Blob([body], { type: 'text/plain;charset=UTF-8' }))) return;
        } catch (_) {}
      }
      try {
        fetch(contactIntentUrl, {
          method: 'POST',
          credentials: 'same-origin',
          keepalive: true,
          headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
          body: body
        }).catch(function() {});
      } catch (_) {}
    }

    function recordContactIntent(event) {
      var anchor = resolveAnchor(event.target);
      if (!anchor || anchor.getAttribute('data-contact-core') === '1') return;

      var channel = (anchor.getAttribute('data-vjt-contact') || '').toLowerCase();
      var href = anchor.getAttribute('href') || '';
      if (channel === 'whatsapp') {
        if (!/^https:\/\/(?:wa\.me|api\.whatsapp\.com|web\.whatsapp\.com)(?:\/|$)/i.test(href)) return;
      } else if (channel === 'mailto') {
        if (href.slice(0, 7).toLowerCase() !== 'mailto:') return;
      } else {
        return;
      }

      var payload = {
        event_id: newCoreEventId(),
        channel: channel,
        event_type: 'open_intent',
        status: 'intent',
        page_path: window.location.pathname || '/',
        placement: anchor.getAttribute('data-vjt-placement') || '',
        site_language: (document.documentElement.lang || 'en').slice(0, 3).toUpperCase(),
        analytics: false
      };
      addAnalyticsLinkage(payload);
      sendIntent(payload);
    }

    document.addEventListener('click', recordContactIntent, true);
    document.addEventListener('auxclick', function(event) {
      if (event.button === 1) recordContactIntent(event);
    }, true);
  })();
</script>

<!-- Tracker remains analytics-consent gated, but starts immediately once allowed
     so a visitor cannot click WhatsApp/Email before its listener is bound. -->
<script is:inline define:vars={{ trackerScriptUrl, allowLocalVjt }}>
  (function() {
    // Inline scripts run again after Astro view transitions. Keep one persistent
    // loader/listener so a navigation cannot start the same pageview twice.
    if (window.__vjtLoaderBound) return;
    window.__vjtLoaderBound = true;
    var loading = false;
    var loaded = false;
    function injectTracker() {
      if (loading || loaded || window.VJT_init) return;
      loading = true;
      var s = document.createElement('script');
      s.src = trackerScriptUrl;
      s.async = true;
      s.onload = function() {
        loading = false;
        loaded = true;
        if (window.VJT_init) window.VJT_init();
      };
      s.onerror = function() {
        loading = false;
        loaded = false;
      };
      document.head.appendChild(s);
    }
    function scheduleInject() {
      var hostname = window.location.hostname;
      var isLocalHost = hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1';
      if (isLocalHost && !allowLocalVjt) return;
      if (!window.VJTTracker || !window.VJTTracker.enabled) return;
      injectTracker();
    }
    // Existing consent may be available on the first load.
    scheduleInject();
    // The cookie banner dispatches this after the visitor grants analytics consent.
    window.addEventListener('vjt:consent-granted', scheduleInject);
    // On SPA navigations, call init directly instead of re-downloading the script
    document.addEventListener('astro:page-load', function() {
      if (window.VJT_init) {
        // Already loaded — just re-init with updated config and URL (I1 fix)
        window.VJTTracker.page.url = window.location.href;
        window.VJTTracker.page.title = document.title || '';
        window.VJT_init();
      } else {
        // First load has not completed yet. injectTracker() keeps the in-flight
        // script unique; never clear its guard from astro:page-load.
        scheduleInject();
      }
    });
  })();
</script>
