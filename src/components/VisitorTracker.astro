---
// VisitorTracker.astro - Injects the VJT tracking script on all pages
// Include this in Layout.astro before </body>
import { runtimeAssetUrl } from '../config/runtimeAssets.mjs';

const isDev = import.meta.env.DEV;
const allowLocalVjt = import.meta.env.PUBLIC_ENABLE_LOCAL_VJT === 'true';
const trackerScriptUrl = isDev
  ? 'http://localhost:4325/js/vjt-tracker.js'
  : runtimeAssetUrl('vjt-tracker');
const vjtLoaderUrl = isDev ? '/js/vjt-loader.js' : runtimeAssetUrl('vjt-loader');
const contactIntentUrl = isDev
  ? 'http://localhost:4325/api/track-contact-intent.php'
  : '/api/track-contact-intent.php';
const capabilityUrl = isDev
  ? 'http://localhost:4325/api/vjt-capability.php'
  : '/api/vjt-capability.php';
// VJT capability proofs use their own Invisible Turnstile widget. Without
// this key the proof provider stays disabled (statistics only); it never
// falls back to the inquiry form's Managed key, which can show a checkbox.
const turnstileSiteKey = import.meta.env.PUBLIC_VJT_TURNSTILE_SITE_KEY;
---

{isDev && (
  <script is:inline>
    var vjtDevHostname = window.location.hostname === '127.0.0.1'
      ? '127.0.0.1'
      : ((window.location.hostname === '::1' || window.location.hostname === '[::1]') ? '[::1]' : 'localhost');
    var vjtDevApiOrigin = 'http://' + vjtDevHostname + ':4325';
    window.VJTTracker = {
      // Consent-gated: enabled only while ConsentController reports a current
      // analytics consent cycle (it also calls VJT_init when consent is given).
      get enabled() { try { return !!(window.__kssmiConsent && window.__kssmiConsent.trackingCycle()); } catch(e) { return false; } }, set enabled(v) {},
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: vjtDevApiOrigin + '/api/track-pageview.php',
        submission: vjtDevApiOrigin + '/api/track-submission.php',
        config: vjtDevApiOrigin + '/api/vjt-config.php',
        capability: vjtDevApiOrigin + '/api/vjt-capability.php',
        forget: vjtDevApiOrigin + '/api/vjt-forget.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

{!isDev && (
  <script is:inline>
    window.VJTTracker = {
      // Consent-gated: enabled only while ConsentController reports a current
      // analytics consent cycle (it also calls VJT_init when consent is given).
      get enabled() { try { return !!(window.__kssmiConsent && window.__kssmiConsent.trackingCycle()); } catch(e) { return false; } }, set enabled(v) {},
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: '/api/track-pageview.php',
        submission: '/api/track-submission.php',
        config: '/api/vjt-config.php',
        capability: '/api/vjt-capability.php',
        forget: '/api/vjt-forget.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

<!-- The capability issuer verifies this proof server-side. It is intentionally
     separate from the inquiry-form widget so analytics/contact capabilities
     can be minted only after a fresh, single-use Turnstile response. -->
{!isDev && (
  <script is:inline define:vars={{ turnstileSiteKey }}>
    (function() {
      if (window.KSSMI_VJT_CAPABILITY_PROOF) return;
      var siteKey = String(turnstileSiteKey || '');
      var apiPromise = null;
      // A Turnstile response is single-use. Contact Core and analytics can
      // both ask for capabilities during page startup, so queue requests
      // instead of handing the same response to concurrent callers.
      var proofQueue = Promise.resolve();

      function ensureApi() {
        if (window.turnstile && typeof window.turnstile.render === 'function') return Promise.resolve(window.turnstile);
        // Layout's shared loader keeps one API request per document and
        // retries after a failure; the widget and proof queue stay local.
        if (typeof window.__kssmiTurnstileApi === 'function') return window.__kssmiTurnstileApi();
        if (apiPromise) return apiPromise;
        apiPromise = new Promise(function(resolve, reject) {
          var script = document.createElement('script');
          script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
          script.async = true;
          script.defer = true;
          script.onload = function() {
            if (window.turnstile && typeof window.turnstile.render === 'function') resolve(window.turnstile);
            else reject(new Error('Turnstile API unavailable'));
          };
          script.onerror = function() {
            apiPromise = null;
            reject(new Error('Turnstile API failed to load'));
          };
          document.head.appendChild(script);
        });
        return apiPromise;
      }

      // A proof is for background statistics only: the visitor must never be
      // asked to interact for it. Any attempt that would need interaction,
      // fails, cannot load the API or times out is ended for real (its own
      // widget and container removed) and this tab stops asking for 30
      // minutes. Every attempt owns its widget and callbacks, so a late
      // callback can only ever end the attempt that rendered it.
      var COOLDOWN_KEY = 'kssmi_vjt_proof_cooldown_until';
      var COOLDOWN_MS = 30 * 60 * 1000;
      var PROOF_TIMEOUT_MS = 15000;
      var API_LOAD_TIMEOUT_MS = 30000;
      var navGeneration = 0;
      var activeAttempt = null;

      function coolingDown() {
        try { return Number(sessionStorage.getItem(COOLDOWN_KEY) || 0) > Date.now(); } catch (_) { return false; }
      }

      function startCooldown() {
        try { sessionStorage.setItem(COOLDOWN_KEY, String(Date.now() + COOLDOWN_MS)); } catch (_) {}
      }

      function destroyAttemptWidget(proofAttempt) {
        var container = proofAttempt.container;
        proofAttempt.container = null;
        // Remove the widget while its container is still attached, so Turnstile
        // can find and clean it up; detach the container afterwards.
        if (proofAttempt.widgetId !== null && window.turnstile) {
          try { window.turnstile.remove(proofAttempt.widgetId); } catch (_) {}
        }
        proofAttempt.widgetId = null;
        if (container && container.parentNode) container.parentNode.removeChild(container);
      }

      // Ends one attempt exactly once. A failure starts the cooldown only if
      // the attempt still belongs to the current page; navigation aborts and
      // anything from an earlier page never do.
      function endAttempt(proofAttempt, token, failed) {
        if (proofAttempt.done) return;
        proofAttempt.done = true;
        if (activeAttempt === proofAttempt) activeAttempt = null;
        window.clearTimeout(proofAttempt.timer);
        destroyAttemptWidget(proofAttempt);
        if (!token && failed && proofAttempt.navGeneration === navGeneration) startCooldown();
        proofAttempt.finish(token || '');
      }

      function renderAttemptWidget(api, proofAttempt) {
        var stale = document.getElementById('kssmi-vjt-capability-turnstile');
        if (stale && stale.parentNode) stale.parentNode.removeChild(stale);
        var container = document.createElement('div');
        container.id = 'kssmi-vjt-capability-turnstile';
        container.setAttribute('aria-label', 'Security verification');
        container.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:2147483647;max-width:calc(100vw - 24px)';
        document.body.appendChild(container);
        proofAttempt.container = container;
        proofAttempt.widgetId = api.render(container, {
          sitekey: siteKey,
          action: 'vjt_capability',
          execution: 'execute',
          appearance: 'interaction-only',
          callback: function(token) {
            var proof = typeof token === 'string' ? token : '';
            endAttempt(proofAttempt, proof, !proof);
          },
          // A notification, not a cancel switch: end the attempt and remove
          // its widget ourselves before any checkbox can be shown.
          'before-interactive-callback': function() {
            endAttempt(proofAttempt, '', true);
          },
          'error-callback': function() {
            endAttempt(proofAttempt, '', true);
            return true;
          },
          'unsupported-callback': function() {
            endAttempt(proofAttempt, '', true);
          },
          'timeout-callback': function() {
            endAttempt(proofAttempt, '', true);
          },
          'expired-callback': function() {
            endAttempt(proofAttempt, '', true);
          }
        });
        if (proofAttempt.widgetId === undefined || proofAttempt.widgetId === null) {
          throw new Error('Turnstile render failed');
        }
        api.execute(container);
      }

      // Leaving a page aborts the active attempt (including one still waiting
      // for the API) without a cooldown; nothing from it may touch the next page.
      document.addEventListener('astro:before-swap', function() {
        navGeneration += 1;
        if (activeAttempt) endAttempt(activeAttempt, '', false);
      });

      function obtainSingleProof() {
        if (coolingDown()) return Promise.resolve('');
        return new Promise(function(resolve) {
          var proofAttempt = {
            navGeneration: navGeneration,
            done: false,
            container: null,
            widgetId: null,
            timer: 0,
            finish: resolve
          };
          activeAttempt = proofAttempt;
          // Two budgets: loading the API (slow networks can take several
          // seconds; the shared loader also gives up after 15 s) and then the
          // challenge itself. A slow download must not eat the challenge time.
          proofAttempt.timer = window.setTimeout(function() {
            endAttempt(proofAttempt, '', true);
          }, API_LOAD_TIMEOUT_MS);
          ensureApi().then(function(api) {
            if (proofAttempt.done) return;
            window.clearTimeout(proofAttempt.timer);
            proofAttempt.timer = window.setTimeout(function() {
              endAttempt(proofAttempt, '', true);
            }, PROOF_TIMEOUT_MS);
            try {
              renderAttemptWidget(api, proofAttempt);
            } catch (_) {
              endAttempt(proofAttempt, '', true);
            }
          }, function() {
            // API blocked or failed to load: a failure like any other, so the
            // tab cools down instead of reloading the API on every request.
            endAttempt(proofAttempt, '', true);
          });
        });
      }

      function obtainProof() {
        if (siteKey === '' || coolingDown()) return Promise.resolve('');
        var next = proofQueue.then(obtainSingleProof);
        // Keep the queue alive after a network or widget failure while each
        // caller receives its own result.
        proofQueue = next.catch(function() { return ''; });
        return next.catch(function() { return ''; });
      }

      window.KSSMI_VJT_CAPABILITY_PROOF = obtainProof;
    })();
  </script>
)}
{isDev && (
  <script is:inline>
    // The PHP issuer accepts this only when its TCP peer and Host are both
    // loopback. Production never receives this development placeholder.
    window.KSSMI_VJT_CAPABILITY_PROOF = function() { return Promise.resolve('local-development'); };
  </script>
)}

<!-- Contact Core is independent of analytics consent and never owns navigation.
     It submits only a minimal event unless current analytics consent allows the
     server to validate and attach an existing Journey. -->
<script is:inline define:vars={{ contactIntentUrl, capabilityUrl, isDev }}>
  (function() {
    if (window.__vjtContactCoreBound) return;
    window.__vjtContactCoreBound = true;
    var contactCapabilities = [];
    var capabilityRequest = null;
    var capabilityRefreshTimer = null;
    var capabilitiesLoadedAt = 0;
    // A failed refill (e.g. a proof cut short by a soft navigation) is retried
    // a bounded number of times per document; success resets the budget.
    var capabilityRetryDelays = [15 * 1000, 60 * 1000, 5 * 60 * 1000];
    var capabilityFailures = 0;
    var capabilityRetryTimer = null;
    var capabilityRetryDue = false;
    var contactEndpoint = contactIntentUrl;
    var capabilityEndpoint = capabilityUrl;
    if (isDev) {
      var devHostname = window.location.hostname === '127.0.0.1'
        ? '127.0.0.1'
        : ((window.location.hostname === '::1' || window.location.hostname === '[::1]') ? '[::1]' : 'localhost');
      var devApiOrigin = 'http://' + devHostname + ':4325';
      contactEndpoint = devApiOrigin + '/api/track-contact-intent.php';
      capabilityEndpoint = devApiOrigin + '/api/vjt-capability.php';
    }

    function capabilityIsFresh(token) {
      var parts = String(token || '').split('.');
      if (parts.length !== 2) return false;
      try {
        var encoded = parts[0].replace(/-/g, '+').replace(/_/g, '/');
        while (encoded.length % 4) encoded += '=';
        var claims = JSON.parse(atob(encoded));
        return typeof claims.exp === 'number' && claims.exp * 1000 > Date.now() + 5000;
      } catch (_) {
        return false;
      }
    }

    function scheduleCapabilityRefresh() {
      if (capabilityRefreshTimer) clearTimeout(capabilityRefreshTimer);
      capabilityRefreshTimer = setTimeout(loadContactCapabilities, 7 * 60 * 1000);
    }

    function clearCapabilityRetry() {
      if (capabilityRetryTimer) clearTimeout(capabilityRetryTimer);
      capabilityRetryTimer = null;
      capabilityRetryDue = false;
    }

    function scheduleCapabilityRetry() {
      capabilityFailures++;
      // One pending retry at a time; navigations never refill the budget.
      if (capabilityRetryTimer || capabilityRetryDue
          || capabilityFailures > capabilityRetryDelays.length) return;
      capabilityRetryTimer = setTimeout(function() {
        capabilityRetryTimer = null;
        // A background tab waits for visibilitychange instead of spending a proof.
        if (document.visibilityState === 'hidden') {
          capabilityRetryDue = true;
          return;
        }
        loadContactCapabilities();
      }, capabilityRetryDelays[capabilityFailures - 1]);
    }

    function freshCapabilityCount() {
      return contactCapabilities.filter(capabilityIsFresh).length;
    }

    function loadContactCapabilities() {
      if (capabilityRequest) return capabilityRequest;
      capabilityRetryDue = false;
      var refilled = false;
      var proof = typeof window.KSSMI_VJT_CAPABILITY_PROOF === 'function'
        ? window.KSSMI_VJT_CAPABILITY_PROOF() : Promise.resolve('');
      capabilityRequest = proof.then(function(token) {
        if (!token && !isDev) return null;
        return fetch(capabilityEndpoint, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: 'contact', turnstile_token: token })
        });
      }).then(function(response) {
        if (!response) return null;
        return response.ok ? response.json() : null;
      }).then(function(data) {
        var issued = data && data.capabilities && data.capabilities.contact_intent;
        if (Array.isArray(issued)) {
          contactCapabilities = issued.filter(function(token) {
            return typeof token === 'string' && capabilityIsFresh(token);
          }).slice(0, 16);
          refilled = contactCapabilities.length > 0;
          capabilitiesLoadedAt = Date.now();
          scheduleCapabilityRefresh();
        }
        return contactCapabilities.length > 0;
      }).catch(function() {
        return false;
      }).then(function(ok) {
        capabilityRequest = null;
        if (refilled) {
          capabilityFailures = 0;
          clearCapabilityRetry();
        } else {
          scheduleCapabilityRetry();
        }
        return ok;
      });
      return capabilityRequest;
    }

    function takeContactCapability() {
      var token = '';
      while (contactCapabilities.length && !token) {
        var candidate = contactCapabilities.shift() || '';
        if (capabilityIsFresh(candidate)) token = candidate;
      }
      if (contactCapabilities.length < 3) loadContactCapabilities();
      return token;
    }

    loadContactCapabilities();

    function readJson(key) {
      try {
        var value = localStorage.getItem(key);
        return value ? JSON.parse(value) : null;
      } catch (_) {
        return null;
      }
    }

    function newCoreEventId() {
      try {
        if (window.crypto && typeof window.crypto.randomUUID === 'function') {
          return 'vjtce_' + window.crypto.randomUUID().replace(/-/g, '');
        }
      } catch (_) {}
      return 'vjtce_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 14);
    }

    function resolveAnchor(target) {
      var node = target;
      while (node && node.tagName) {
        if (node.tagName.toLowerCase() === 'a') return node;
        node = node.parentElement;
      }
      return null;
    }

    // vjt-tracker.js stores VJT values as {c: consent cycle, v: value}.
    function readCycleValue(key, cycle) {
      var raw = readJson(key);
      return raw && typeof raw === 'object' && !Array.isArray(raw) && raw.c === cycle ? raw.v : null;
    }

    function addAnalyticsLinkage(payload) {
      // Linkage requires the current consent cycle and identity values the
      // tracker stored under that same cycle; nothing from an older cycle.
      var cycle = window.__kssmiConsent && window.__kssmiConsent.trackingCycle();
      if (!cycle) return;

      var visitorId = readCycleValue('vjt_visitor_id', cycle);
      if (typeof visitorId !== 'string') visitorId = '';
      var session = readCycleValue('vjt_session_meta', cycle);
      var pageview = readCycleValue('vjt_current_pageview', cycle);
      var sessionId = session && typeof session.id === 'string' ? session.id : '';
      if (!/^vjtv_[A-Za-z0-9_-]{8,60}$/.test(visitorId)
          || !/^vjts_[A-Za-z0-9_-]{8,60}$/.test(sessionId)) return;

      payload.analytics = true;
      payload.vjt_visitor_id = visitorId;
      payload.vjt_session_id = sessionId;
      if (pageview && pageview.session_id === sessionId) {
        var step = Number(pageview.step_order);
        if (step >= 1 && step <= 10000) payload.journey_step = Math.floor(step);
      }
    }

    function sendIntent(payload) {
      var capability = takeContactCapability();
      if (!capability) return;
      payload.capability_token = capability;
      var body = JSON.stringify(payload);
      if (navigator.sendBeacon) {
        try {
          if (navigator.sendBeacon(contactEndpoint, new Blob([body], { type: 'text/plain;charset=UTF-8' }))) return;
        } catch (_) {}
      }
      try {
        fetch(contactEndpoint, {
          method: 'POST',
          credentials: 'include',
          keepalive: true,
          headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
          body: body
        }).catch(function() {});
      } catch (_) {}
    }

    function recordContactIntent(event) {
      var anchor = resolveAnchor(event.target);
      if (!anchor) return;

      var channel = (anchor.getAttribute('data-vjt-contact') || '').toLowerCase();
      var href = anchor.getAttribute('href') || '';

      // Same-site redirect links authenticate the navigation itself. The
      // analytics tracker deliberately ignores these links so this one handler
      // owns the temporary href and native navigation stays race-free.
      if (anchor.getAttribute('data-contact-core') === '1') {
        if (channel !== 'whatsapp' && channel !== 'mailto') return;
        try {
          var coreUrl = new URL(href, window.location.href);
          if (coreUrl.origin !== window.location.origin
              || coreUrl.pathname !== '/api/contact-intent.php') return;
          var capability = takeContactCapability();
          if (!capability) return;
          coreUrl.searchParams.set('capability_token', capability);

          var analyticsLink = {};
          addAnalyticsLinkage(analyticsLink);
          if (analyticsLink.analytics === true) {
            coreUrl.searchParams.set('analytics', '1');
            if (analyticsLink.journey_step) {
              coreUrl.searchParams.set('step', String(analyticsLink.journey_step));
            } else {
              coreUrl.searchParams.delete('step');
            }
          } else {
            coreUrl.searchParams.delete('analytics');
            coreUrl.searchParams.delete('step');
          }

          var originalHref = anchor.getAttribute('href');
          var enhancedHref = coreUrl.pathname + coreUrl.search + coreUrl.hash;
          anchor.setAttribute('href', enhancedHref);
          setTimeout(function() {
            if (anchor.getAttribute('href') !== enhancedHref) return;
            if (originalHref === null) anchor.removeAttribute('href');
            else anchor.setAttribute('href', originalHref);
          }, 0);
        } catch (_) {}
        return;
      }

      if (channel === 'whatsapp') {
        if (!/^https:\/\/(?:wa\.me|api\.whatsapp\.com|web\.whatsapp\.com)(?:\/|$)/i.test(href)) return;
      } else if (channel === 'mailto') {
        if (href.slice(0, 7).toLowerCase() !== 'mailto:') return;
      } else {
        return;
      }

      var payload = {
        event_id: newCoreEventId(),
        channel: channel,
        event_type: 'open_intent',
        status: 'intent',
        page_path: window.location.pathname || '/',
        placement: anchor.getAttribute('data-vjt-placement') || '',
        site_language: (document.documentElement.lang || 'en').slice(0, 3).toUpperCase(),
        analytics: false
      };
      addAnalyticsLinkage(payload);
      sendIntent(payload);
    }

    document.addEventListener('click', recordContactIntent, true);
    document.addEventListener('auxclick', function(event) {
      if (event.button === 1) recordContactIntent(event);
    }, true);
    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'visible'
          && (capabilityRetryDue || Date.now() - capabilitiesLoadedAt >= 7 * 60 * 1000)) {
        loadContactCapabilities();
      }
    });
    // Soft navigations are a recovery point, but never stack a request or
    // timer on one already pending, nor run past the retry budget.
    document.addEventListener('astro:page-load', function() {
      if (capabilityRequest || capabilityRetryTimer || capabilityRetryDue) return;
      if (capabilityFailures > capabilityRetryDelays.length) return;
      if (freshCapabilityCount() >= 3) return;
      loadContactCapabilities();
    });
  })();
</script>

<!-- Tracker remains analytics-consent gated, but starts immediately once allowed
     so a visitor cannot click WhatsApp/Email before its listener is bound.
     The bootstrap is a classic external script (public/js/vjt-loader.js) at the
     same position the inline copy had; it reads these data-* values itself. -->
<script
  is:inline
  src={vjtLoaderUrl}
  data-tracker-url={trackerScriptUrl}
  data-allow-local-vjt={allowLocalVjt ? 'true' : 'false'}
  data-dev={isDev ? 'true' : 'false'}
></script>
