---
// VisitorTracker.astro - Injects the VJT tracking script on all pages
// Include this in Layout.astro before </body>

const isDev = import.meta.env.DEV;
const allowLocalVjt = import.meta.env.PUBLIC_ENABLE_LOCAL_VJT === 'true';
const trackerScriptUrl = isDev
  ? 'http://localhost:4325/js/vjt-tracker.js'
  : '/assets/runtime/vjt-tracker.fdce709391c0.js';
---

{isDev && (
  <script is:inline>
    window.VJTTracker = {
      // Consent-gated: only enabled once the visitor grants analytics consent.
      // The cookie banner flips this on (and calls VJT_init) when consent is given.
      get enabled() { try { var c = JSON.parse(localStorage.getItem('cookie-consent')); return c ? !!c.analytics : false; } catch(e) { return false; } }, set enabled(v) {},
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: 'http://localhost:4325/api/track-pageview.php',
        submission: 'http://localhost:4325/api/track-submission.php',
        config: 'http://localhost:4325/api/vjt-config.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

{!isDev && (
  <script is:inline>
    window.VJTTracker = {
      // Consent-gated: only enabled once the visitor grants analytics consent.
      // The cookie banner flips this on (and calls VJT_init) when consent is given.
      get enabled() { try { var c = JSON.parse(localStorage.getItem('cookie-consent')); return c ? !!c.analytics : false; } catch(e) { return false; } }, set enabled(v) {},
      page: {
        url: window.location.href,
        title: document.title || ''
      },
      routes: {
        pageview: '/api/track-pageview.php',
        submission: '/api/track-submission.php',
        config: '/api/vjt-config.php'
      },
      sessionTimeout: 30,
      cookieExpires: 31536000
    };
  </script>
)}

<!-- Tracker remains analytics-consent gated, but starts immediately once allowed
     so a visitor cannot click WhatsApp/Email before its listener is bound. -->
<script is:inline define:vars={{ trackerScriptUrl, allowLocalVjt }}>
  (function() {
    // Inline scripts run again after Astro view transitions. Keep one persistent
    // loader/listener so a navigation cannot start the same pageview twice.
    if (window.__vjtLoaderBound) return;
    window.__vjtLoaderBound = true;
    var loaded = false;
    function injectTracker() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.src = trackerScriptUrl;
      s.async = true;
      document.head.appendChild(s);
    }
    function scheduleInject() {
      var hostname = window.location.hostname;
      var isLocalHost = hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1';
      if (isLocalHost && !allowLocalVjt) return;
      if (!window.VJTTracker || !window.VJTTracker.enabled) return;
      injectTracker();
    }
    // Existing consent may be available on the first load.
    scheduleInject();
    // The cookie banner dispatches this after the visitor grants analytics consent.
    window.addEventListener('vjt:consent-granted', scheduleInject);
    // On SPA navigations, call init directly instead of re-downloading the script
    document.addEventListener('astro:page-load', function() {
      if (window.VJT_init) {
        // Already loaded — just re-init with updated config and URL (I1 fix)
        window.VJTTracker.page.url = window.location.href;
        window.VJTTracker.page.title = document.title || '';
        window.VJT_init();
      } else {
        // First load hasn't happened yet — inject script
        loaded = false;
        scheduleInject();
      }
    });
  })();
</script>
