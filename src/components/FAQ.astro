---
/**
 * FAQ Component — visible Q&A + FAQPage JSON-LD
 * High-yield format for AI citation (ChatGPT/Perplexity/Google AI Overviews)
 */
interface QA {
  question: string;
  answer: string;
}

interface Props {
  items: QA[];
  lang?: string;
}

const { items, lang = 'en' } = Astro.props;
const isRTL = lang === 'ar';

const faqSchema = items.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<div class="w-full max-w-3xl mx-auto space-y-4" dir={isRTL ? 'rtl' : 'ltr'}>
  {items.map(item => (
    <details class="group bg-white border border-stone-200 rounded-lg overflow-hidden shadow-sm hover:border-[#8B7355] transition-colors duration-300">
      <summary class="flex items-center justify-between px-5 py-4 cursor-pointer select-none font-semibold text-sm text-stone-800 group-open:text-[#5D4E37]">
        {item.question}
        <svg class="w-4 h-4 text-stone-400 group-open:rotate-180 transition-transform duration-300 flex-shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-5 pb-4 text-sm text-stone-600 leading-relaxed">
        {item.answer}
      </div>
    </details>
  ))}
</div>
