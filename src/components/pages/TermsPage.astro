---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TermsPrivacyDocument from '../../components/collection/terms-privacy/TermsPrivacyDocument.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const supportedContentLanguages = new Set([
  'ar', 'de', 'en', 'es', 'fr', 'hi', 'it', 'ja', 'jv',
  'ko', 'ms', 'pt', 'ru', 'tg', 'tr', 'vi', 'zh',
]);
const requestedLang = lang || 'en';
const contentLang = supportedContentLanguages.has(requestedLang) ? requestedLang : 'en';

const allTermsEntries = await getCollection('collection', ({ data }) => (
  data.pageKey === 'terms-privacy' && data.lang === contentLang
));
const metaEntry = allTermsEntries.find(({ data }) => data.fileType === 'meta');
if (!metaEntry) {
  throw new Error(`Missing Terms & Privacy metadata for language: ${contentLang}`);
}

const meta = metaEntry.data as Record<string, any>;
const sectionEntries = allTermsEntries.filter(({ data }) => (
  typeof data.order === 'number'
  && typeof data.anchor === 'string'
  && typeof data.navLabel === 'string'
  && typeof data.title === 'string'
));

sectionEntries.sort((a, b) => Number(a.data.order) - Number(b.data.order));

const sections = await Promise.all(sectionEntries.map(async (entry) => {
  const { Content } = await render(entry);
  return {
    anchor: String(entry.data.anchor),
    navLabel: String(entry.data.navLabel),
    title: String(entry.data.title),
    Content,
  };
}));

if (sections.length === 0) {
  throw new Error(`No Terms & Privacy sections were found for language: ${contentLang}`);
}

const isPublished = requestedLang === contentLang && meta.status === 'published';
const pageTitle = meta.seoTitle || `${meta.title} | Kssmi Eyewear`;
const pageDescription = meta.seoDescription || meta.intro;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={meta.seoKeywords}
  image={meta.ogImage}
  lang={contentLang}
  noindex={!isPublished}
  noHreflang={!isPublished}
>
  <Header lang={requestedLang} />

  <TermsPrivacyDocument
    meta={meta}
    sections={sections}
    requestedLang={requestedLang}
    contentLang={contentLang}
  />

  <Footer lang={requestedLang} />
</Layout>
