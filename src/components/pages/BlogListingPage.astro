---
/**
 * Blog Listing Page (/blog/, /blog/<topic>/, /blog/<topic>/<subtopic>/)
 * Mirrors FAQPage.astro & ProductListingPage.astro:
 * left sticky expanded sidebar + right H1, search bar (icon on far right), and borderless card grid.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Breadcrumb from '../Breadcrumb.astro';
import BlogSidebar from '../blog/BlogSidebar.astro';
import BlogCard from '../blog/BlogCard.astro';
import {
  blogPath,
  buildBlogTopicTree,
  getBlogPosts,
} from '../blog/blogData';
import { getBlogUi } from '../../data/blogTaxonomy';
import '../blog/blog-theme.css';
import { getTranslations } from '../../translations';

interface Props {
  lang?: string;
  activeTopic?: string | null;
  activeSubtopic?: string | null;
}

const { lang = 'en', activeTopic = null, activeSubtopic = null } = Astro.props;
const isRTL = lang === 'ar';
const currentPath = lang === 'en' ? '' : `${lang}/`;
const t = await getTranslations(lang);
const ui = getBlogUi(lang);
const allPosts = await getBlogPosts(lang);
const topicTree = buildBlogTopicTree(lang, allPosts);

const visiblePosts = allPosts.filter((post) => {
  if (activeTopic && post.blogTopic !== activeTopic) return false;
  if (activeSubtopic && post.blogSubtopic !== activeSubtopic) return false;
  return true;
});

const topicMap = new Map(topicTree.map((node) => [node.key, node]));
const activeTopicObj = activeTopic ? topicMap.get(activeTopic) : undefined;
const activeSubtopicObj = activeTopicObj && activeSubtopic
  ? activeTopicObj.subtopics.find((sub) => sub.key === activeSubtopic)
  : undefined;

const hubUrl = blogPath(lang);
const blogLabel = t.nav?.blog || 'Blog';
const viewDetailsLabel = t.product?.viewDetails || 'View Details';
const lcpImage = visiblePosts[0]?.cover;

const MIN_ARCHIVE_INDEX_COUNT = 3;
const isArchivePage = Boolean(activeTopicObj || activeSubtopicObj);
const isThinArchive = isArchivePage && visiblePosts.length < MIN_ARCHIVE_INDEX_COUNT;

const pageHeading = activeSubtopicObj
  ? activeSubtopicObj.title
  : activeTopicObj
    ? activeTopicObj.title
    : ui.blogTitle;

const pageTitle = activeSubtopicObj || activeTopicObj
  ? `${pageHeading} — ${ui.blogTitle}`
  : (lang === 'zh' ? `${ui.blogTitle} | 可米科技` : `${ui.blogTitle} | Kssmi`);

const pageDescription = isArchivePage
  ? `${pageHeading} — ${ui.blogDescription}`
  : ui.blogDescription;

const breadcrumbItems: Array<{ label: string; href: string }> = [
  { label: t.nav.home, href: currentPath ? `/${currentPath.replace(/\/$/, '')}` : '/' },
  { label: blogLabel, href: activeTopicObj ? hubUrl : '#' },
];
if (activeTopicObj) {
  breadcrumbItems.push({
    label: activeTopicObj.title,
    href: activeSubtopicObj && activeTopicObj.href ? activeTopicObj.href : '#',
  });
}
if (activeSubtopicObj) {
  breadcrumbItems.push({ label: activeSubtopicObj.title, href: '#' });
}
---

<Layout title={pageTitle} lang={lang} description={pageDescription} lcpImage={lcpImage} type="website" noindex={isThinArchive}>
  <Header lang={lang} />
  <Breadcrumb items={breadcrumbItems} lang={lang} />

  <main id="main-content" tabindex="-1" class="w-full min-h-screen py-6 lg:py-8 bg-stone-50 blog-page" dir={isRTL ? 'rtl' : 'ltr'}>
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <BlogSidebar
          lang={lang}
          currentPath={currentPath}
          allLabel={ui.allPosts}
          allHref={hubUrl}
          totalCount={allPosts.length}
          topics={topicTree}
          activeTopic={activeTopic}
          activeSubtopic={activeSubtopic}
          t={t}
        />

        <div class="col-span-1 lg:col-span-3 min-w-0">
          <!-- Mobile Topic Chips -->
          <div class="lg:hidden mb-4 -mx-4 px-4 overflow-x-auto" role="navigation" aria-label={ui.topicsTitle}>
            <div class="flex gap-2 w-max pb-1">
              <a
                href={hubUrl}
                class:list={[
                  'flex items-center gap-1.5 whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-bold border transition-colors',
                  !activeTopic
                    ? 'bg-[#5D4E37] text-white border-[#5D4E37]'
                    : 'bg-white text-[#5D4E37] border-stone-200 hover:bg-stone-50 active:bg-stone-50 focus-visible:bg-stone-50 focus-within:bg-stone-50',
                ]}
              >
                <span>{ui.allPosts}</span>
                <span class:list={['text-[11px]', !activeTopic ? 'text-white/80' : 'text-stone-500']}>
                  {allPosts.length}
                </span>
              </a>
              {topicTree.filter((node) => Boolean(node.href)).map((topic) => {
                const isActive = topic.key === activeTopic;
                return (
                  <a
                    href={topic.href}
                    class:list={[
                      'flex items-center gap-1.5 whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-bold border transition-colors',
                      isActive
                        ? 'bg-[#5D4E37] text-white border-[#5D4E37]'
                        : 'bg-white text-[#5D4E37] border-stone-200 hover:bg-stone-50 active:bg-stone-50 focus-visible:bg-stone-50 focus-within:bg-stone-50',
                    ]}
                  >
                    <span>{topic.title}</span>
                    <span class:list={['text-[11px]', isActive ? 'text-white/80' : 'text-stone-500']}>
                      {topic.count}
                    </span>
                  </a>
                );
              })}
            </div>
          </div>

          <!-- Header & Search (search icon on the far right) -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
            <h1 class="text-base lg:text-lg font-bold text-stone-900">
              {pageHeading}
            </h1>

            <div class="w-full sm:w-72 flex items-center gap-2 border border-stone-200 bg-white rounded-lg px-3 transition-colors hover:border-[#8B7355] active:border-[#8B7355] focus-visible:border-[#8B7355] focus-within:border-[#8B7355] shrink-0">
              <input
                type="search"
                placeholder={ui.searchPlaceholder}
                aria-label={ui.searchPlaceholder}
                autocomplete="off"
                data-blog-card-search
                class="w-full min-w-0 py-2 bg-transparent border-none outline-hidden text-sm text-stone-900 placeholder:text-stone-400 focus:ring-0"
              />
              <button
                type="button"
                class="blog-search-clear flex items-center justify-center p-1 text-stone-400 hover:text-stone-700 active:text-stone-700 focus-visible:text-stone-700 focus-within:text-stone-700 transition-colors cursor-pointer"
                aria-label={t.nav?.ariaClearSearch || 'Clear search'}
                hidden
                data-blog-card-search-clear
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
              <svg class="w-4 h-4 text-stone-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>

          <!-- Blog Card Grid -->
          <div data-blog-card-grid class="grid grid-cols-2 xl:grid-cols-3 gap-x-4 gap-y-6 xl:gap-x-6 xl:gap-y-10">
            {visiblePosts.map((post, index) => {
              const tObj = topicMap.get(post.blogTopic);
              const sObj = tObj && post.blogSubtopic
                ? tObj.subtopics.find((s) => s.key === post.blogSubtopic)
                : undefined;
              return (
                <BlogCard
                  post={post}
                  lang={lang}
                  topicTitle={tObj?.title}
                  subtopicTitle={sObj?.title}
                  viewDetailsLabel={viewDetailsLabel}
                  isLcpCandidate={index === 0}
                />
              );
            })}
          </div>

          <p
            hidden
            data-blog-card-empty
            class="mt-6 rounded-xl border border-dashed border-stone-300 bg-white p-8 text-center text-sm text-stone-600"
          >
            {ui.noResults}
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<script>
  const initBlogCardSearch = () => {
    const input = document.querySelector<HTMLInputElement>('[data-blog-card-search]');
    const clear = document.querySelector<HTMLButtonElement>('[data-blog-card-search-clear]');
    const grid = document.querySelector<HTMLElement>('[data-blog-card-grid]');
    const empty = document.querySelector<HTMLElement>('[data-blog-card-empty]');
    if (!input || !grid || input.dataset.blogCardSearchBound) return;
    input.dataset.blogCardSearchBound = '1';

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-blog-card]'));
    const applyFilter = () => {
      const query = input.value.trim().toLowerCase();
      if (clear) clear.hidden = input.value.length === 0;
      let visible = 0;
      cards.forEach((card) => {
        const text = card.dataset.blogSearchText || '';
        const match = !query || text.includes(query);
        card.hidden = !match;
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
    };

    input.addEventListener('input', applyFilter);
    clear?.addEventListener('click', () => {
      input.value = '';
      applyFilter();
      input.focus();
    });
    if (input.value) applyFilter();
  };

  document.addEventListener('astro:page-load', initBlogCardSearch);
  initBlogCardSearch();
</script>

<style>
  .blog-search-clear[hidden] {
    display: none;
  }
</style>
