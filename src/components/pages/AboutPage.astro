---
/**
 * About Us Page - Multi-language
 * URL: /{lang}/about-us/
 *
 * Composes section components. Each component is a self-contained Astro file
 * that reads its own markdown via getEntry and returns nothing if the file
 * is missing (graceful no-op for languages without content).
 *
 * Add new section components here as content is created in
 * src/content/collection/about-us/sNN_name.{lang}.md
 *
 * Meta + SEO are read from src/content/collection/about-us/about-us.{lang}.md
 */

import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import S01_FirstScreen from '../../components/collection/about/S01_FirstScreen.astro';

const { lang } = Astro.props;
const isRTL = lang === 'ar';

// SEO meta only — first-screen content is handled by S01_FirstScreen.
const entry = await getEntry('collection', `about-us/about-us.${lang}`);
const data = entry?.data as any;

const seoTitle = data?.seoTitle || "About Us | Kssmi Eyewear";
const seoDescription = data?.seoDescription || "Learn about Kssmi Eyewear's 20-year history.";
---

<Layout title={seoTitle} description={seoDescription} lang={lang} noindex={true}>
  <Header lang={lang} />

  <main dir={isRTL ? 'rtl' : 'ltr'}>
    <S01_FirstScreen lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>