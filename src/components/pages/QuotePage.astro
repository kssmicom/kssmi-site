---
/**
 * Quote Request Page - Multi-language
 * URL: /{lang}/quote/
 *
 * Composes section components:
 *   - src/components/collection/quote/S002_Benefits.astro
 * Plus the InquiryFormLazy form at the bottom.
 *
 * Meta + SEO are read from src/content/collection/quote/quote.{lang}.md
 */

import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../translations';
import { getEntry } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import InquiryFormLazy from '../../components/InquiryFormLazy.astro';
import S002_Benefits from '../../components/collection/quote/S002_Benefits.astro';

// Accept lang as a prop (passed by both /quote.astro and /[lang]/quote.astro).
// Fall back to Astro.params, then 'en'.
const lang = Astro.props.lang ?? Astro.params?.lang ?? 'en';
const t = await getTranslations(lang);
const isRTL = lang === 'ar';

// Read SEO + page-title from the meta file only.
const entry = await getEntry('collection', `quote/quote.${lang}`);
const data = entry?.data as any;

const title = data?.title || "Request a Quote";
const seoTitle = data?.seoTitle || "Request a Quote | Kssmi Eyewear";
const seoDescription = data?.seoDescription || "Get a custom quote for your eyewear collection. Rapid prototyping and competitive B2B pricing for premium frames.";

// productName is the form subject label — passed through to /inquiry-form.
// Falls back to English if not in the md file.
const productName = data?.productName || "General Inquiry";

// English has no /en prefix (default locale, prefixDefaultLocale: false)
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const breadcrumbItems = [
  { label: t.nav.home, href: `${langPrefix}/` },
  { label: title, href: `${langPrefix}/quote` },
];
---

<Layout title={seoTitle} description={seoDescription} lang={lang}>
  <Header lang={lang} />

  <main dir={isRTL ? 'rtl' : 'ltr'}>
    <!-- Breadcrumb Navigation -->
    <Breadcrumb items={breadcrumbItems} lang={lang} />

    <!-- Section 002: Key Benefits (3 cards) -->
    <S002_Benefits lang={lang} />

    <!-- Inquiry Form -->
    <InquiryFormLazy lang={lang} productName={productName} />
  </main>

  <Footer lang={lang} />
</Layout>