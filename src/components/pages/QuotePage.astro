---
/**
 * Quote Request Page - Multi-language
 * URL: /{lang}/quote/
 *
 * Composes section components:
 *   - src/components/collection/quote/S002_Benefits.astro
 *   - src/components/collection/quote/S003_ContactForm.astro
 *
 * Meta + SEO are read from src/content/collection/quote/quote.{lang}.md
 */

import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import S002_Benefits from '../../components/collection/quote/S002_Benefits.astro';
import S003_ContactForm from '../../components/collection/quote/S003_ContactForm.astro';

// Accept lang as a prop (passed by both /quote.astro and /[lang]/quote.astro).
// Fall back to Astro.params, then 'en'.
const lang = Astro.props.lang ?? Astro.params?.lang ?? 'en';
const isRTL = lang === 'ar';

// Read SEO + page-title from the meta file only.
const entry = await getEntry('collection', `quote/quote.${lang}`);
if (!entry) {
  throw new Error(`Missing Quote SEO content for language: ${lang}`);
}

const { seoTitle, seoDescription, productName } = entry.data as any;
if (!seoTitle || !seoDescription || !productName) {
  throw new Error(`Incomplete Quote SEO content for language: ${lang}`);
}

---

<Layout title={seoTitle} description={seoDescription} lang={lang}>
  <Header lang={lang} />

  <main dir={isRTL ? 'rtl' : 'ltr'}>
    <!-- Section 002: Key Benefits (3 cards) -->
    <S002_Benefits lang={lang} />

    <!-- Section 003: Contact Form -->
    <S003_ContactForm lang={lang} productName={productName} />
  </main>

  <Footer lang={lang} />
</Layout>
