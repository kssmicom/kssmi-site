---
/**
 * Blog Article Detail Page (/blog/<slug>/)
 * Mirrors FAQDetailPage.astro: left sticky BlogSidebar + right single <article> card
 * (H1, cover image, optional article-specific component from posts/registry.ts, prose content,
 * Article + BreadcrumbList JSON-LD, Pagefind indexing, OG article metadata, and right-aligned InquiryFormLazy).
 */
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Breadcrumb from '../Breadcrumb.astro';
import InquiryFormLazy from '../InquiryFormLazy.astro';
import BlogSidebar from '../blog/BlogSidebar.astro';
import BlogProseZPattern from '../blog/BlogProseZPattern.astro';
import { BLOG_POST_COMPONENTS } from '../blog/posts/registry';
import {
  blogPath,
  buildBlogTopicTree,
  getBlogPosts,
} from '../blog/blogData';
import { getBlogUi } from '../../data/blogTaxonomy';
import '../blog/blog-theme.css';
import { getTranslations } from '../../translations';

interface Props {
  lang?: string;
  slug: string;
}

const { lang = 'en', slug } = Astro.props;
const isRTL = lang === 'ar';
const currentPath = lang === 'en' ? '' : `${lang}/`;
const t = await getTranslations(lang);
const ui = getBlogUi(lang);
const allPosts = await getBlogPosts(lang);
const post = allPosts.find((p) => p.slug === slug);
if (!post) {
  throw new Error(`Missing blog article content for slug: ${slug}`);
}

const { Content } = await render(post.entry);
const ArticleComponent = BLOG_POST_COMPONENTS[slug];

const topicTree = buildBlogTopicTree(lang, allPosts);
const topicObj = topicTree.find((node) => node.key === post.blogTopic);
const subtopicObj = topicObj && post.blogSubtopic
  ? topicObj.subtopics.find((s) => s.key === post.blogSubtopic)
  : undefined;

const hubUrl = blogPath(lang);
const blogLabel = t.nav?.blog || 'Blog';

const breadcrumbItems: Array<{ label: string; href: string }> = [
  { label: t.nav.home, href: currentPath ? `/${currentPath.replace(/\/$/, '')}` : '/' },
  { label: blogLabel, href: hubUrl },
];
if (topicObj?.href) {
  breadcrumbItems.push({ label: topicObj.title, href: topicObj.href });
}
if (subtopicObj?.href) {
  breadcrumbItems.push({ label: subtopicObj.title, href: subtopicObj.href });
}
breadcrumbItems.push({ label: post.title, href: '#' });

const siteUrl = new URL('/', Astro.site ?? 'https://kssmi.com').href.replace(/\/$/, '');
const canonicalUrl = `${siteUrl}${blogPath(lang, post.slug)}`;
const coverUrl = post.cover
  ? (post.cover.startsWith('http') ? post.cover : `${siteUrl}${post.cover}`)
  : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.seoDescription || post.excerpt,
  image: coverUrl,
  datePublished: post.published ? post.published.toISOString().split('T')[0] : undefined,
  dateModified: post.published ? post.published.toISOString().split('T')[0] : undefined,
  author: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: lang === 'zh' ? '可米科技' : 'Kssmi Eyewear',
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: lang === 'zh' ? '可米科技' : 'Kssmi Eyewear',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/media/global/kssmi-logo.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

function stripInlineMarkdown(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`~]+/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function extractFaqItemsFromMarkdown(body?: string): Array<{ question: string; answer: string }> {
  if (!body) return [];
  const sepIdx = body.lastIndexOf('\n---\n');
  const beforeFooter = sepIdx === -1 ? body : body.slice(0, sepIdx);
  const lastH2Idx = beforeFooter.lastIndexOf('\n## ');
  const faqSection = lastH2Idx === -1 ? beforeFooter : beforeFooter.slice(lastH2Idx);

  const items: Array<{ question: string; answer: string }> = [];
  const blockRe = /^###\s+\d+\.\s+([^\n]+)\r?\n+([\s\S]*?)(?=\r?\n###\s+\d+\.|\s*$)/gm;
  for (const match of faqSection.matchAll(blockRe)) {
    const question = stripInlineMarkdown(match[1]);
    const answer = stripInlineMarkdown(match[2]);
    if (question && answer) {
      items.push({ question, answer });
    }
  }
  return items;
}

const faqItems = extractFaqItemsFromMarkdown(post.entry.body);
const faqSchema = faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<Layout
  title={post.seoTitle}
  lang={lang}
  description={post.seoDescription}
  image={post.cover}
  lcpImage={post.cover}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <Header lang={lang} />
  <Breadcrumb items={breadcrumbItems} lang={lang} />

  <main
    id="main-content"
    tabindex="-1"
    data-pagefind-body="true"
    class="w-full min-h-screen py-6 lg:py-8 bg-stone-50 blog-page"
    dir={isRTL ? 'rtl' : 'ltr'}
  >
    <div class="sr-only" data-pagefind-meta="title">{post.title}</div>
    {post.cover && <meta data-pagefind-meta="image[content]" content={post.cover} />}

    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="contents" data-pagefind-ignore>
          <BlogSidebar
            lang={lang}
            currentPath={currentPath}
            allLabel={ui.allPosts}
            allHref={hubUrl}
            totalCount={allPosts.length}
            topics={topicTree}
            activeTopic={post.blogTopic}
            activeSubtopic={post.blogSubtopic ?? null}
            t={t}
          />
        </div>

        <div class="col-span-1 lg:col-span-3 min-w-0">
          <!-- Mobile Topic Chips -->
          <div class="lg:hidden mb-4 -mx-4 px-4 overflow-x-auto" data-pagefind-ignore role="navigation" aria-label={ui.topicsTitle}>
            <div class="flex gap-2 w-max pb-1">
              <a
                href={hubUrl}
                class="flex items-center gap-1.5 whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-bold border bg-white text-[#5D4E37] border-stone-200 hover:bg-stone-50 active:bg-stone-50 focus-visible:bg-stone-50 focus-within:bg-stone-50 transition-colors"
              >
                <span>{ui.allPosts}</span>
                <span class="text-[11px] text-stone-500">{allPosts.length}</span>
              </a>
              {topicTree.filter((node) => Boolean(node.href)).map((node) => {
                const active = node.key === post.blogTopic;
                return (
                  <a
                    href={node.href}
                    class:list={[
                      'flex items-center gap-1.5 whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-bold border transition-colors',
                      active
                        ? 'bg-[#5D4E37] text-white border-[#5D4E37]'
                        : 'bg-white text-[#5D4E37] border-stone-200 hover:bg-stone-50 active:bg-stone-50 focus-visible:bg-stone-50 focus-within:bg-stone-50',
                    ]}
                  >
                    <span>{node.title}</span>
                    <span class:list={['text-[11px]', active ? 'text-white/80' : 'text-stone-500']}>
                      {node.count}
                    </span>
                  </a>
                );
              })}
            </div>
          </div>

          <!-- Single Blog Article Card -->
          <article class="bg-white rounded-xl shadow-xs border border-stone-200/50 p-6 xl:p-10">
            <header class:list={['pb-6 mb-6 border-b border-stone-200/70', post.cover && 'blog-hero-split']}>
              <div class="blog-hero-split__body">
                <h1 class="text-2xl lg:text-3xl font-bold text-stone-900 tracking-tight leading-tight">
                  {post.title}
                </h1>

                {post.excerpt && (
                  <p class="mt-3 text-sm sm:text-base text-stone-600 leading-relaxed max-w-3xl">
                    {post.excerpt}
                  </p>
                )}

                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-stone-500">
                  <span>{ui.byAuthor} <strong class="font-semibold text-stone-700">{post.author}</strong></span>
                  {post.published && (
                    <time datetime={post.published.toISOString().split('T')[0]}>
                      {post.published.toISOString().split('T')[0]}
                    </time>
                  )}
                  <span>{post.readingMinutes} {ui.minRead}</span>
                </div>
              </div>

              {post.cover && (
                <figure class="blog-hero-split__media">
                  <img
                    src={post.cover}
                    alt={post.title}
                    width="800"
                    height="600"
                    loading="eager"
                    decoding="sync"
                    fetchpriority="high"
                  />
                </figure>
              )}
            </header>

            {ArticleComponent && <ArticleComponent lang={lang} />}

            <BlogProseZPattern>
              <Content />
            </BlogProseZPattern>

            {post.tags.length > 0 && (
              <div class="mt-8 pt-6 border-t border-stone-200/70 flex flex-wrap items-center gap-2" data-pagefind-ignore>
                <span class="text-xs font-semibold text-stone-500 me-1">{ui.tagsLabel}:</span>
                {post.tags.map((tag) => (
                  <span class="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-700">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <div class="mt-6" data-pagefind-ignore>
              <a
                href={hubUrl}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#5D4E37] hover:text-[#8B7355] active:text-[#8B7355] focus-visible:text-[#8B7355] focus-within:text-[#8B7355] transition-colors"
              >
                <span aria-hidden="true">←</span>
                <span>{ui.backToBlog}</span>
              </a>
            </div>
          </article>

          <div class="mt-8 blog-detail-inquiry" data-pagefind-ignore>
            <InquiryFormLazy
              lang={lang}
              productName={post.title}
              productUrl={Astro.url.pathname}
              source="blog_page"
            />
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .blog-detail-inquiry :global(#inquiry-form-section) {
    padding-top: 1.5rem;
    padding-bottom: 0;
    background-color: transparent;
  }

  .blog-detail-inquiry :global(#inquiry-form-section > div) {
    width: 100%;
    max-width: none;
    padding-inline: 0;
  }

  .blog-detail-inquiry :global(#inquiry-form-section > div > div:last-child) {
    max-width: none;
  }
</style>
