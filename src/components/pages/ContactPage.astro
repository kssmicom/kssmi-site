---
/**
 * Contact Page - Multi-language
 * URL: /{lang}/contact/
 *
 * Composes section components:
 *   - src/components/collection/contact/S01_FirstScreen.astro
 *
 * Meta + SEO are read from src/content/collection/contact/contact.{lang}.md
 */

import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import S01_FirstScreen from '../../components/collection/contact/S01_FirstScreen.astro';

const { lang } = Astro.props;
const isRTL = lang === 'ar';

// SEO meta only — first-screen content is handled by S01_FirstScreen.
const entry = await getEntry('collection', `contact/contact.${lang}`);
const data = entry?.data as any;

const seoTitle = data?.seoTitle || "Contact Kssmi Eyewear | OEM/ODM Eyewear Manufacturer";
const seoDescription = data?.seoDescription || "Get in touch with Kssmi Eyewear for OEM/ODM eyewear manufacturing. Reach our sales team for quotes, samples, and global partnership inquiries.";
---

<Layout title={seoTitle} description={seoDescription} lang={lang} noindex={true}>
  <Header lang={lang} />

  <main dir={isRTL ? 'rtl' : 'ltr'}>
    <S01_FirstScreen lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
