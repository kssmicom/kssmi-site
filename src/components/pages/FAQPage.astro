---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';

const { lang } = Astro.props;
const isRTL = lang === 'ar';
const [entry] = await getCollection('collection', ({ data }) =>
  data.lang === lang && data.slug === 'faq'
);
if (!entry?.data.items) {
  throw new Error(`Missing FAQ content for language: ${lang}`);
}
const { seoTitle, seoDescription, heading, subtitle, items } = entry.data;
---

<Layout title={seoTitle} lang={lang} description={seoDescription} type="website">
  <Header lang={lang} />
  <main class="w-full min-h-[70vh] bg-stone-50 pt-12 pb-24 flex items-center" dir={isRTL ? 'rtl' : 'ltr'}>
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[820px] mx-auto px-4 text-center">
      <div class="inline-flex flex-col items-center justify-center mb-8">
        <span class="text-3xl font-bold text-[#503629] tracking-tight leading-none uppercase">{lang === 'zh' ? '可米' : 'KSSMI'}</span>
        <span class="h-[1px] w-8 bg-[#503629] mt-1.5"></span>
        <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-[#503629] mt-1.5">{lang === 'zh' ? '眼镜工厂' : 'Eyewear Mfg.'}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-[#5D4E37] mb-3 tracking-tight">{heading}</h1>
      <p class="text-lg text-stone-500 mb-10 max-w-xl mx-auto">{subtitle}</p>
    </div>
  </main>
  <section class="w-full py-12 lg:py-20 bg-white">
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1240px] mx-auto px-4">
      <FAQ items={items} lang={lang} />
    </div>
  </section>
  <Footer lang={lang} />
</Layout>
