---
/**
 * FAQ hub (/faq/) — search, topic cards, all questions grouped by topic.
 * Content: src/content/collection/faq/index/faq.{lang}.md
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqHero from '../collection/faq/FaqHero.astro';
import FaqTopicGrid from '../collection/faq/FaqTopicGrid.astro';
import FaqQuestionList from '../collection/faq/FaqQuestionList.astro';
import { buildTopicCards, getFaqHub, getFaqTopicKeys } from '../collection/faq/faqData';
import '../collection/faq/faq-theme.css';
import { getTranslations } from '../../translations';

const { lang } = Astro.props;
const t = await getTranslations(lang);
const hub = await getFaqHub(lang);
const { seoTitle, seoDescription, heading, subtitle, items, topics = [], ui } = hub;
const topicCards = buildTopicCards(lang, topics, items, await getFaqTopicKeys());
---

<Layout title={seoTitle} lang={lang} description={seoDescription} type="website">
  <Header lang={lang} />
  <main class="faq-page">
    <FaqHero
      lang={lang}
      heading={heading}
      subtitle={subtitle}
      crumbs={[{ label: t.nav.home, href: `${lang === 'en' ? '' : `/${lang}`}/` }, { label: 'FAQ' }]}
      searchPlaceholder={ui.searchPlaceholder}
      clearLabel={t.nav?.ariaClearSearch}
      centered
    />
    <FaqTopicGrid lang={lang} title={ui.topicsTitle} topics={topicCards} />
    <FaqQuestionList
      items={items}
      lang={lang}
      topics={topics}
      title={ui.questionsTitle}
      noResults={ui.noResults}
    />
  </main>
  <Footer lang={lang} />
</Layout>
