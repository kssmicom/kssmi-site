---
/**
 * Section placeholder for listing sections whose content collection is empty
 * (blog, eyewear). Rendered by the [lang] and EN listing rest routes so that
 * nav entries always resolve to a real page instead of a 404.
 *
 * Reuses the translated "under construction" copy from the About landing
 * content (s01_first_screen.{lang}) — no new copy is introduced here.
 * Always rendered with noindex: it must never enter the sitemap or index.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { getEntry } from 'astro:content';
import { getTranslations } from '../../translations';

const { lang = 'en', sectionLabel = '' } = Astro.props as {
  lang?: string;
  sectionLabel?: string;
};
const isRTL = lang === 'ar';
const prefix = lang === 'en' ? '' : `/${lang}`;

const t = await getTranslations(lang);
const entry = await getEntry('collection', `about-us/s01_first_screen.${lang}`);
const underConstruction = entry?.data?.underConstruction || 'This page is under construction.';
const message = entry?.data?.message || "We're working on something great. In the meantime, explore our full catalog of precision-crafted eyewear.";
const browseProducts = entry?.data?.browseProducts || 'Browse Products';
const label = sectionLabel || t.nav.blog || 'Blog';
---

<Layout title={`${label} | Kssmi Eyewear`} lang={lang} noindex={true}>
  <Header lang={lang} transparent={false} />
  <main class="w-full min-h-[70vh] bg-stone-50 pt-12 pb-24 flex items-center" dir={isRTL ? 'rtl' : 'ltr'}>
    <div class="w-[95%] lg:w-[92%] max-w-[820px] mx-auto px-4 text-center">
      <div class="inline-flex flex-col items-center justify-center mb-8">
        <span class="text-3xl font-bold text-[#503629] tracking-tight leading-none uppercase">{lang === 'zh' ? '可米' : 'KSSMI'}</span>
        <span class="h-[1px] w-8 bg-[#503629] mt-1.5"></span>
        <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-[#503629] mt-1.5">{lang === 'zh' ? '眼镜工厂' : 'Eyewear Mfg.'}</span>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold text-[#5D4E37] mb-4 tracking-tight">{label}</h1>

      <div class="inline-flex items-center justify-center w-16 h-16 bg-white border border-stone-200 rounded-full mb-8 shadow-xs">
        <svg class="w-6 h-6 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </div>

      <p class="text-lg text-stone-600 mb-3 font-medium">{underConstruction}</p>
      <p class="text-base text-stone-600 mb-10 max-w-md mx-auto">{message}</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${prefix}/product/`} class="inline-flex items-center px-8 py-3 bg-[#5D4E37] text-white font-bold uppercase tracking-wider text-xs rounded-full hover:bg-[#4A3D2E] active:bg-[#4A3D2E] focus-visible:bg-[#4A3D2E] focus-within:bg-[#4A3D2E] transition-colors duration-300 shadow-lg">
          {browseProducts}
        </a>
        <a href={`${prefix}/quote/`} class="inline-flex items-center px-8 py-3 border-2 border-[#5D4E37] text-[#5D4E37] font-bold uppercase tracking-wider text-xs rounded-full hover:bg-[#5D4E37] active:bg-[#5D4E37] focus-visible:bg-[#5D4E37] focus-within:bg-[#5D4E37] hover:text-white active:text-white focus-visible:text-white focus-within:text-white transition-all duration-300">
          {t.nav.contact || 'Contact'}
        </a>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
