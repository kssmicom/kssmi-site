---
/**
 * Product Listing Page — Shared Component
 */
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../translations';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { isCategoryMatch } from '../../utils/categoryMatching';
import Pagination from '../../components/Pagination.astro';
import { buildPrimaryCategories, buildSidebarTags } from '../../utils/sidebar';
import Breadcrumb from '../../components/Breadcrumb.astro';

interface Props {
  lang: string;
  currentPath: string;
  baseSegment?: string;
  products: any[];
  allProducts: any[];
  currentPage: number;
  totalPages: number;
  basePath: string;
  breadcrumbItems: any[];
  title: string;
  lcpImage?: string;
}

const {
  lang = 'en', currentPath = '', products, allProducts, baseSegment = 'product',
  currentPage, totalPages, basePath, breadcrumbItems, title, lcpImage
} = Astro.props;

const t = await getTranslations(lang);
const pt = t.product || {};
const isRTL = lang === 'ar';

const primaryCategories = buildPrimaryCategories(t, currentPath, baseSegment);
const sidebarTags = buildSidebarTags(t, currentPath, baseSegment);

function getCategoryCount(href: string): number {
  const targetSlug = href.split('/').pop() || '';
  return allProducts.filter((p: any) => {
    const cats = p.data.series || '';
    return isCategoryMatch(cats, targetSlug);
  }).length;
}

const PAGE_SIZE = 12;
const start = (currentPage - 1) * PAGE_SIZE;
const end = Math.min(currentPage * PAGE_SIZE, allProducts.length);
---

<Layout title={title} lang={lang} lcpImage={lcpImage}>
  <Header lang={lang} />
  <Breadcrumb items={breadcrumbItems} lang={lang} />

  <main class="w-full min-h-screen py-6 lg:py-8 bg-stone-50" dir={isRTL ? 'rtl' : 'ltr'}>
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar -->
        <aside class="hidden lg:block lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="bg-gradient-to-br from-white to-[#faf8f5] rounded-xl shadow-sm p-6 border border-stone-200/50">
              <!-- All Products Link - Page Title (Active) -->
              <a href={`/${currentPath}${baseSegment}`} class="flex items-center justify-between py-1.5 px-2 text-sm lg:text-base font-bold bg-[#5D4E37] text-white rounded-lg mb-3">
                <span>{baseSegment === 'blog' ? t.sidebar.all_posts : baseSegment === 'eyewear' ? t.sidebar.all_features : t.sidebar.all_products}</span>
                <span class="text-xs font-normal text-white/70">{allProducts.length}</span>
              </a>

              <div class="space-y-3">
                {primaryCategories.map((cat) => (
                  <div class="border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                    <a
                      href={cat.href}
                      class="flex items-center justify-between py-2 px-2 text-sm font-bold text-[#5D4E37] hover:bg-stone-50 rounded-lg transition-colors"
                    >
                      <span>{cat.label}</span>
                      <span class="text-xs text-gray-500">{getCategoryCount(cat.href)}</span>
                    </a>
                    <ul class="ms-3 mt-1 space-y-1">
                      {cat.items.map((sub) => (
                        <li>
                          <a
                            href={sub.href}
                            class="flex items-center justify-between py-1.5 px-2 text-sm text-gray-600 hover:text-[#5D4E37] hover:bg-stone-50 rounded transition-colors"
                          >
                            <span>{sub.label}</span>
                            <span class="text-xs text-gray-500">{getCategoryCount(sub.href)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <div class="mt-8 pt-6 border-t border-gray-100">
                <p class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-4">{t.sidebar.tags_filters}</p>
                <div class="space-y-6">
                  {sidebarTags.map((group) => (
                    <div>
                      <a href={group.href} class="text-sm font-bold text-gray-900 mb-2.5 flex items-center hover:text-[#5D4E37] transition-colors">
                        <span class="text-[#5D4E37] mr-1">#</span> {group.label}
                      </a>
                      <div class="flex flex-col gap-1.5">
                        {group.items.map((tag) => (
                          <a
                            href={tag.href}
                            class="px-3 py-1.5 text-[11px] font-bold rounded-md border bg-stone-50 text-stone-600 border-stone-200 hover:border-[#8B7355] hover:text-[#5D4E37] hover:bg-stone-100 transition-all duration-200 w-full"
                          >
                            {tag.label}
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="bg-[#5D4E37] rounded-xl p-6 text-white">
              <p class="font-bold mb-2">{pt.needCustomEyewear || 'Need Custom Eyewear?'}</p>
              <p class="text-sm text-white mb-4">
                {pt.oemServices || 'We offer full OEM & ODM services for your brand.'}
              </p>
              <a
                href={`/${currentPath}quote`}
                class="inline-block bg-white text-[#5D4E37] px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-lg"
              >
                {t.cta.quote || 'Get Quote'}
              </a>
            </div>
          </div>
        </aside>

        <!-- Product Grid -->
        <div class="col-span-1 lg:col-span-3">
          <h1 class="text-base lg:text-lg font-bold text-stone-900 mb-3">{title} — <span class="text-xs lg:text-sm font-medium text-stone-500">{(t.pagination?.page || 'Page {n}').replace('{n}', String(currentPage))}</span></h1>
          <div class="flex justify-between items-center mb-3 text-sm text-gray-500">
            <span>
              {(baseSegment === 'blog' ? ((t as any).blog?.showingResults || 'Showing {start}-{end} of {total} posts') : baseSegment === 'eyewear' ? ((t as any).feature?.showingResults || 'Showing {start}-{end} of {total} features') : (pt.showingResults || 'Showing {start}-{end} of {total} products')).replace('{start}', String(allProducts.length > 0 ? start + 1 : 0)).replace('{end}', String(end)).replace('{total}', String(allProducts.length))}
            </span>
          </div>
          {products.length === 0 ? (
            <div class="text-center py-16 bg-white rounded-xl shadow-sm">
              <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
              <p class="text-gray-500 mb-4">{baseSegment === 'blog' ? ((t as any).blog?.emptyState || 'No blog posts yet.') : baseSegment === 'eyewear' ? ((t as any).feature?.emptyState || 'No features yet.') : (pt.noProducts || 'No products available yet.')}</p>
              <a href={`/${currentPath}`} class="text-[#5D4E37] hover:underline">
                {pt.returnHome || 'Return to Homepage'}
              </a>
            </div>
          ) : (
            <>

              <div class="grid grid-cols-2 xl:grid-cols-3 gap-x-4 gap-y-6 xl:gap-x-6 xl:gap-y-10">
                <slot name="cards" />
              </div>

              <Pagination
                currentPage={currentPage}
                lastPage={totalPages}
                basePath={`/${currentPath}${baseSegment}`}
                prevLabel={pt.previousPage || 'Previous'}
                nextLabel={pt.nextPage || 'Next'}
              />
            </>
          )}
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
