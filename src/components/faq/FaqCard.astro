---
/**
 * FAQ Article Card — matches ProductCard.astro 1:1 (shared kx-productcard-* styles,
 * borderless shadow-md/shadow-xl card, hover overlay, centered title + 2-line body excerpt).
 */
import { faqPath, type FaqArticle } from './faqData';

interface Props {
  article: FaqArticle;
  lang: string;
  topicTitle?: string;
  subtopicTitle?: string;
  viewDetailsLabel?: string;
}

const {
  article,
  lang,
  topicTitle,
  subtopicTitle,
  viewDetailsLabel = 'View Details',
} = Astro.props;

const isRTL = lang === 'ar';
const href = faqPath(lang, article.slug);
const excerpt = article.items[0]?.answer || article.seoDescription;
const searchHaystack = [
  article.heading,
  topicTitle || '',
  subtopicTitle || '',
  ...article.items.flatMap((item) => [item.question, item.answer]),
]
  .join(' ')
  .toLowerCase();
---

<a
  href={href}
  data-faq-card
  data-faq-search-text={searchHaystack}
  class="group block"
  dir={isRTL ? 'rtl' : 'ltr'}
>
  <div class="kx-productcard-3 h-full flex flex-col">
    <!-- Cover Image with Hover Overlay (matches ProductCard) -->
    <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
      {article.cover ? (
        <img
          src={article.cover}
          alt={article.heading}
          width="400"
          height="300"
          loading="lazy"
          decoding="async"
          class="kx-productcard-2"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-linear-to-br from-gray-100 to-gray-200">
          <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      )}

      <!-- Hover Overlay with "View Details" -->
      <div class="kx-productcard-4">
        <span class="kx-productcard-1">
          {viewDetailsLabel}
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 group-active:translate-x-1 group-focus-visible:translate-x-1 group-focus-within:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </div>

    <!-- Article Info - Center Aligned (matches ProductCard) -->
    <div class="p-4 xl:p-5 text-center flex-1 flex flex-col justify-center">
      <h2 class="kx-productcard-5 line-clamp-2">
        {article.heading}
      </h2>

      {excerpt && (
        <p class="text-xs text-gray-500 mt-1.5 line-clamp-2 leading-relaxed">
          {excerpt}
        </p>
      )}
    </div>
  </div>
</a>

<style>
  a[data-faq-card][hidden] {
    display: none;
  }
</style>
