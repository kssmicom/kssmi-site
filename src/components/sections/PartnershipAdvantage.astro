---
/**
 * PartnershipAdvantage Section
 * Renders partnership/team hero data from landing page frontmatter
 */
interface TeamMember {
  name: string;
  image: string;
  description: string;
}

interface PartnershipHero {
  badge?: string;
  headerPrimary?: string;
  headerSecondary?: string;
  description?: string;
  team?: TeamMember[];
}

const { partnershipHero = {}, lang = 'en' } = Astro.props as { partnershipHero?: PartnershipHero; lang?: string };
const isRTL = lang === 'ar';
const { badge, headerPrimary, headerSecondary, description, team = [] } = partnershipHero;
---

<section class="w-full bg-gradient-to-b from-[#FCFAF8] to-white py-16 lg:py-24" dir={isRTL ? 'rtl' : 'ltr'}>
  <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
    {badge && (
      <span class="inline-block text-xs font-semibold tracking-[0.2em] uppercase text-[#8B7355] bg-[#8B7355]/5 px-4 py-2 rounded-full mb-6">
        {badge}
      </span>
    )}

    <div class="max-w-3xl">
      {headerPrimary && (
        <h2 class="text-4xl md:text-5xl font-bold text-stone-900 tracking-tight mb-4">
          {headerPrimary}
        </h2>
      )}
      {headerSecondary && (
        <p class="text-xl md:text-2xl text-stone-700 font-medium mb-6">
          {headerSecondary}
        </p>
      )}
      {description && (
        <p class="text-base text-stone-600 leading-relaxed max-w-2xl">
          {description}
        </p>
      )}
    </div>

    {team.length > 0 && (
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {team.map((member) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-[#8B7355]/10 transition-all duration-300 motion-safe:hover:-translate-y-1 hover:shadow-md">
            {member.image && (
              <div class="w-20 h-20 rounded-full overflow-hidden mb-4 bg-stone-100">
                <img src={member.image} alt={member.name} width="80" height="80" loading="lazy" decoding="async" class="w-full h-full object-cover" />
              </div>
            )}
            <h3 class="text-lg font-bold text-stone-900 mb-2">{member.name}</h3>
            {member.description && (
              <p class="text-sm text-stone-600 leading-relaxed">{member.description}</p>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
