---
import { getTranslations } from '../translations';
import { formatSamplePrice, samplePricing } from '../config/samplePricing';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);
const labels = t.product.samplePricing;
const [creditBefore, creditAfter = ''] = labels.creditNote.split(labels.creditEmphasis);
---

<div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
  <span class="w-[42%] min-w-0 shrink-0 break-words text-sm text-gray-500 sm:w-auto sm:min-w-[160px]">{labels.readyStock}:</span>
  <span class="min-w-0 break-words text-sm font-medium text-gray-900">{formatSamplePrice(samplePricing.readyStock)}/{labels.piece}</span>
</div>
<div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
  <span class="w-[42%] min-w-0 shrink-0 break-words text-sm text-gray-500 sm:w-auto sm:min-w-[160px]">{labels.custom}:</span>
  <span class="min-w-0 break-words text-sm font-medium text-gray-900">{formatSamplePrice(samplePricing.customMin)}–{formatSamplePrice(samplePricing.customMax)}/{labels.piece}</span>
</div>
<div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
  <span class="text-sm text-gray-900">
    {labels.priceContext}
  </span>
</div>
<div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
  <span class="text-sm text-gray-900">
    {creditBefore}<strong class="font-bold">{labels.creditEmphasis}</strong>{creditAfter}
  </span>
</div>
