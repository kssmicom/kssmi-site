---
/**
 * FormTurnstile.astro - Turnstile widget for the inquiry and 404 rescue forms.
 *
 * Renders #turnstile-container plus one page-lifecycle controller. The
 * controller (public/js/form-turnstile.js, a runtime asset) is identical on
 * every page, so Astro's ClientRouter runs it once per document; its astro:page-load / astro:before-swap
 * listeners then mount the widget into the CURRENT page's container and remove
 * the previous widget. The API comes from TurnstileApiLoader (retryable), and
 * a failed load shows a localized retry button instead of an empty box.
 *
 * The submit handlers read window.turnstileToken / window.turnstileWidgetId,
 * which this controller keeps pointed at the current page's widget.
 */
import { runtimeAssetUrl } from '../config/runtimeAssets.mjs';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const isDev = import.meta.env.DEV;
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const formTurnstileScriptUrl = runtimeAssetUrl('form-turnstile');

const loadCopy: Record<string, { failed: string; retry: string }> = {
  en: { failed: 'The security check could not load.', retry: 'Retry security check' },
  it: { failed: 'Impossibile caricare la verifica di sicurezza.', retry: 'Riprova la verifica' },
  es: { failed: 'No se pudo cargar la verificación de seguridad.', retry: 'Reintentar verificación' },
  fr: { failed: 'La vérification de sécurité n’a pas pu se charger.', retry: 'Réessayer la vérification' },
  de: { failed: 'Die Sicherheitsprüfung konnte nicht geladen werden.', retry: 'Sicherheitsprüfung erneut laden' },
  pt: { failed: 'Não foi possível carregar a verificação de segurança.', retry: 'Tentar novamente' },
  ru: { failed: 'Не удалось загрузить проверку безопасности.', retry: 'Повторить проверку' },
  ja: { failed: 'セキュリティ確認を読み込めませんでした。', retry: '再読み込み' },
  tr: { failed: 'Güvenlik doğrulaması yüklenemedi.', retry: 'Doğrulamayı yeniden dene' },
  ar: { failed: 'تعذّر تحميل التحقق الأمني.', retry: 'إعادة المحاولة' },
  ko: { failed: '보안 확인을 불러오지 못했습니다.', retry: '다시 시도' },
  zh: { failed: '安全验证未能加载。', retry: '重新加载安全验证' },
  hi: { failed: 'सुरक्षा जाँच लोड नहीं हो सकी।', retry: 'पुनः प्रयास करें' },
  vi: { failed: 'Không thể tải bước xác minh bảo mật.', retry: 'Thử lại' },
  jv: { failed: 'Pemeriksaan keamanan ora bisa dimuat.', retry: 'Coba maneh' },
  ms: { failed: 'Pemeriksaan keselamatan tidak dapat dimuatkan.', retry: 'Cuba lagi' },
  tg: { failed: 'Санҷиши амниятӣ бор нашуд.', retry: 'Аз нав кӯшиш кунед' },
};
const copy = loadCopy[lang] || loadCopy.en;
---

<div
  id="turnstile-container"
  class={`flex justify-center ${isDev ? 'hidden' : ''}`}
  data-kssmi-turnstile
  data-sitekey={TURNSTILE_SITE_KEY || ''}
  data-load-failed={copy.failed}
  data-retry={copy.retry}
></div>

{!isDev && (
  <script is:inline src={formTurnstileScriptUrl}></script>
)}
