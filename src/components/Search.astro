---
import { getTranslations } from '../translations';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isRTL = lang === 'ar';
const t = await getTranslations(lang);

// Products are lazy-loaded via fetch('/api/search-index/${lang}.json')
// to keep inline HTML payload small. The API endpoint is pre-built at
// /api/search-index/<lang>.json (see src/pages/api/search-index/[lang].json.ts)

// Placeholder text translations
const placeholders: Record<string, string> = {
  en: "Search products...",
  it: "Cerca prodotti...",
  es: "Buscar productos...",
  fr: "Rechercher...",
  de: "Produkte suchen...",
  pt: "Buscar produtos...",
  ru: "Поиск...",
  ja: "製品を検索...",
  tr: "Ürün ara...",
  ar: "البحث عن المنتجات...",
  ko: "제품 검색...",
  zh: "搜索产品...",
  hi: "उत्पाद खोजें...",
  vi: "Tìm kiếm sản phẩm...",
  jv: "Golèki produk...",
  ms: "Cari produk...",
  tg: "Ҷустуҷӯи маҳсулот..."
};
---

<div id={`search-${lang}`} class="search-component relative w-full max-w-md" data-lang={lang} dir={isRTL ? 'rtl' : 'ltr'}>
  <!-- Search Input -->
  <div class="relative">
    <label for={`search-input-${lang}`} class="sr-only">Search products</label>
    <input
      type="text"
      id={`search-input-${lang}`}
      placeholder={placeholders[lang] || placeholders.en}
      class="w-full px-4 py-2 ps-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#8B7355] focus:border-transparent"
      autocomplete="off"
    />
    <!-- Search Icon -->
    <svg class="absolute start-3 top-3 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>

  <!-- Search Results Dropdown -->
  <div id={`search-results-${lang}`} class="absolute z-50 w-full mt-2 bg-white border border-gray-200 rounded-lg shadow-lg hidden max-h-96 overflow-y-auto">
    <!-- Results populated dynamically -->
  </div>
</div>

<script>
  function initSearchComponent(container: HTMLElement) {
    const lang = container.getAttribute('data-lang') || 'en';
    let products: any[] = [];
    let productsLoaded = false;

    const searchInput = container.querySelector('input') as HTMLInputElement;
    const searchResults = container.querySelector(`#search-results-${lang}`);
    let searchTimeout: ReturnType<typeof setTimeout>;
    let fuse: any = null;
    let fuseInitialized = false;

    // AbortController for cleanup on re-initialization
    const ac = new AbortController();
    const signal = ac.signal;
    // Lazy-load products from pre-built JSON endpoint
    async function loadProducts() {
      if (productsLoaded) return;
      try {
        const resp = await fetch(`/api/search-index/${lang}.json`);
        if (!resp.ok) throw new Error('Failed to load search index');
        products = await resp.json();
        productsLoaded = true;
      } catch (e) {
        // Retry once after 2s
        await new Promise(r => setTimeout(r, 2000));
        try {
          const resp = await fetch(`/api/search-index/${lang}.json`);
          if (resp.ok) { products = await resp.json(); productsLoaded = true; }
        } catch {}
      }
    }

    if ('_searchAbort' in container) {
      (container as any)._searchAbort.abort();
    }
    (container as any)._searchAbort = ac;

    // Initialize Fuse.js search (lazy-loaded on first use)
    async function initializeSearch() {
      if (fuseInitialized) return;
      const FuseModule = await import('fuse.js');
      const Fuse = FuseModule.default;
      fuse = new Fuse(products, {
        keys: [
          { name: 'title', weight: 0.4 },
          { name: 'itemNo', weight: 0.3 },
          { name: 'excerpt', weight: 0.2 },
          { name: 'categories', weight: 0.05 },
          { name: 'materials', weight: 0.05 }
        ],
        threshold: 0.4,
        includeScore: true,
        includeMatches: true
      });
    }

    // Perform search
    function performSearch(query: string) {
      if (!fuse || !productsLoaded || !query.trim()) {
        if (query.trim() && !productsLoaded) {
          // Still loading products — show loading indicator
          if (searchResults) {
            searchResults.innerHTML = '<div class="p-4 text-gray-500 text-center">Loading...</div>';
            searchResults.classList.remove('hidden');
          }
        } else {
          searchResults?.classList.add('hidden');
        }
        return;
      }

      const results = fuse.search(query, { limit: 8 });
      displayResults(results);
    }

    // Display results
    function displayResults(results: any[]) {
      if (!searchResults) return;

      searchResults.innerHTML = '';

      const noResultsText: Record<string, string> = {
        en: 'No products found',
        it: 'Nessun prodotto trovato',
        es: 'No se encontraron productos',
        fr: 'Aucun produit trouvé',
        de: 'Keine Produkte gefunden',
        pt: 'Nenhum prodotto encontrado',
        ru: 'Товары не найдены',
        ja: '商品が見つかりません',
        tr: 'Ürün bulunamadı',
        ar: 'لم يتم العثور على منتجات',
        ko: '검색 결과 없음',
        zh: '未找到产品',
        hi: 'कोई उत्पाद नहीं मिला',
        vi: 'Không tìm thấy sản phẩm',
        jv: 'Ora ana produk sing ditemokake',
        ms: 'Tiada produk dijumpai',
        tg: 'Маҳсулот ёфт нашуд'
      };

      if (results.length === 0) {
        searchResults.innerHTML = `<div class="p-4 text-gray-500">${noResultsText[lang] || noResultsText.en}</div>`;
      } else {
        results.forEach(({ item }) => {
          const link = document.createElement('a');
          link.href = item.url;
          link.className = 'block p-4 hover:bg-gray-50 active:bg-gray-50 focus-visible:bg-gray-50 focus-within:bg-gray-50 border-b border-gray-100 last:border-b-0 transition-colors';

          // RTL support
          const dir = lang === 'ar' ? 'rtl' : 'ltr';
          link.dir = dir;

          // Highlight item number
          const itemNoDisplay = item.itemNo ? `<span class="text-xs text-[#5D4E37] font-mono bg-[#F5F5DC] px-2 py-0.5 rounded-sm">${item.itemNo}</span>` : '';

          link.innerHTML = `
            <div class="flex items-center justify-between gap-2 mb-1">
              <div class="font-semibold text-gray-900 truncate">${item.title}</div>
              ${itemNoDisplay}
            </div>
            <div class="text-sm text-gray-600 line-clamp-2">${item.excerpt || ''}</div>
            ${item.categories?.length ? `
              <div class="flex flex-wrap gap-1 mt-2">
                ${item.categories.slice(0, 3).map((cat: string) =>
                  `<span class="text-xs text-gray-600 bg-gray-100 px-2 py-0.5 rounded-sm">${cat}</span>`
                ).join('')}
              </div>
            ` : ''}
          `;
          searchResults.appendChild(link);
        });
      }

      searchResults.classList.remove('hidden');
    }

    // Initialize lazily on first focus/input: load products + init Fuse
    searchInput?.addEventListener("focus", async () => {
      await loadProducts();
      await initializeSearch();
    }, { once: true });

    // Event listeners
    searchInput?.addEventListener('input', (e: Event) => {
      const target = e.target as HTMLInputElement;
      const query = target.value.trim();
      clearTimeout(searchTimeout);

      if (!query) {
        searchResults?.classList.add('hidden');
        return;
      }

      searchTimeout = setTimeout(() => {
        performSearch(query);
      }, 150);
    });

    // Close search results when clicking outside
    document.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      if (!target.closest(`.search-component[data-lang="${lang}"]`)) {
        searchResults?.classList.add('hidden');
      }
    }, { signal });

    // Keyboard navigation
    searchInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        searchResults?.classList.add('hidden');
      }
    });
  }

  // Initialize all search components on both initial load and page transitions
  // Use AbortController to clean up old listeners on re-navigation
  let pageLoadAbort: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    // Abort previous page-load init cycle
    if (pageLoadAbort) {
      pageLoadAbort.abort();
    }
    pageLoadAbort = new AbortController();
    const components = document.querySelectorAll('.search-component');
    components.forEach((c) => initSearchComponent(c as HTMLElement));
  });
</script>
