---
/**
 * CookieBanner.astro — GDPR Cookie Consent Banner
 *
 * Integrates with Google Consent Mode v2.
 * Default state (before interaction): ad_storage=denied, analytics_storage=denied.
 * Stores user choice in localStorage under 'cookie-consent'.
 */

const t = {
  title: 'Cookie Consent',
  message: 'We use cookies to enhance your browsing experience, serve personalized content, and analyze our traffic. By clicking "Accept All", you consent to our use of cookies.',
  accept: 'Accept All',
  reject: 'Reject All',
  preferences: 'Preferences',
  save: 'Save Preferences',
  essentialLabel: 'Essential',
  essentialDesc: 'Required for the website to function properly. Cannot be disabled.',
  analyticsLabel: 'Analytics',
  analyticsDesc: 'Help us understand how visitors interact with our website.',
  adsLabel: 'Marketing',
  adsDesc: 'Used to deliver relevant advertisements and track campaign performance.',
};
---

<!-- Google Consent Mode default state — set before any tag loads -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'granted',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 500,
  });
  gtag('set', 'ads_data_redaction', true);
  gtag('set', 'url_passthrough', true);
</script>

<div id="cookie-banner" class="hidden">
  <!-- Main Banner -->
  <div
    id="cookie-banner-main"
    class="fixed bottom-0 left-0 right-0 z-50 border-t border-gray-200 bg-white/95 backdrop-blur-md dark:border-gray-700 dark:bg-gray-900/95"
  >
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-5 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:py-4">
      <div class="max-w-3xl">
        <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
          {t.message}
        </p>
      </div>
      <div class="flex flex-shrink-0 flex-wrap items-center gap-3">
        <button
          id="cookie-btn-preferences"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          {t.preferences}
        </button>
        <button
          id="cookie-btn-reject"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          {t.reject}
        </button>
        <button
          id="cookie-btn-accept"
          class="rounded-lg bg-[#5D4E37] px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-[#4A3D2E]"
        >
          {t.accept}
        </button>
      </div>
    </div>
  </div>

  <!-- Preferences Modal -->
  <div
    id="cookie-modal-overlay"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50"
  >
    <div
      id="cookie-modal"
      class="mx-4 w-full max-w-lg rounded-2xl border border-gray-200 bg-white p-6 shadow-xl dark:border-gray-700 dark:bg-gray-900"
    >
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{t.title}</h3>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-300">{t.message}</p>

      <div class="mt-5 space-y-3">
        <!-- Essential (always on) -->
        <label class="flex cursor-not-allowed items-start gap-3 rounded-lg border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-800/50">
          <input type="checkbox" checked disabled class="mt-0.5 h-4 w-4 accent-[#8B7355]" />
          <div>
            <span class="text-sm font-medium text-gray-900 dark:text-white">{t.essentialLabel}</span>
            <p class="text-xs text-gray-500 dark:text-gray-300">{t.essentialDesc}</p>
          </div>
        </label>

        <!-- Analytics -->
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-gray-200 p-3 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800/50">
          <input id="cookie-check-analytics" type="checkbox" checked class="mt-0.5 h-4 w-4 accent-[#8B7355]" />
          <div>
            <span class="text-sm font-medium text-gray-900 dark:text-white">{t.analyticsLabel}</span>
            <p class="text-xs text-gray-500 dark:text-gray-300">{t.analyticsDesc}</p>
          </div>
        </label>

        <!-- Ads / Marketing -->
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-gray-200 p-3 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800/50">
          <input id="cookie-check-ads" type="checkbox" checked class="mt-0.5 h-4 w-4 accent-[#8B7355]" />
          <div>
            <span class="text-sm font-medium text-gray-900 dark:text-white">{t.adsLabel}</span>
            <p class="text-xs text-gray-500 dark:text-gray-300">{t.adsDesc}</p>
          </div>
        </label>
      </div>

      <div class="mt-6 flex justify-end gap-3">
        <button
          id="cookie-modal-cancel"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          Cancel
        </button>
        <button
          id="cookie-modal-save"
          class="rounded-lg bg-[#5D4E37] px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-[#4A3D2E]"
        >
          {t.save}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'cookie-consent';

    // --- Helpers ---
    function getCookie() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY));
      } catch (_) {
        return null;
      }
    }

    function setCookie(value) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
    }

    function gtagConsentUpdate(analytics, ads) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { dataLayer.push(arguments); };
      gtag('consent', 'update', {
        ad_storage: ads ? 'granted' : 'denied',
        ad_user_data: ads ? 'granted' : 'denied',
        ad_personalization: ads ? 'granted' : 'denied',
        analytics_storage: analytics ? 'granted' : 'denied',
      });
    }

    function vjtConsentUpdate(analytics) {
      if (window.VJTTracker) {
        window.VJTTracker.enabled = !!analytics;
      }
    }

    // --- DOM refs ---
    var banner = document.getElementById('cookie-banner');
    var main = document.getElementById('cookie-banner-main');
    var overlay = document.getElementById('cookie-modal-overlay');
    var checkAnalytics = document.getElementById('cookie-check-analytics');
    var checkAds = document.getElementById('cookie-check-ads');

    // --- If already consented, apply silently and hide ---
    var existing = getCookie();
    if (existing) {
      gtagConsentUpdate(
        existing.analytics || false,
        existing.ads || false
      );
      vjtConsentUpdate(existing.analytics || false);
      return; // banner stays hidden
    }

    // --- Show banner ---
    banner.classList.remove('hidden');

    // --- Accept All ---
    document.getElementById('cookie-btn-accept').addEventListener('click', function () {
      setCookie({ analytics: true, ads: true });
      gtagConsentUpdate(true, true);
      vjtConsentUpdate(true);
      banner.classList.add('hidden');
    });

    // --- Reject All ---
    document.getElementById('cookie-btn-reject').addEventListener('click', function () {
      setCookie({ analytics: false, ads: false });
      gtagConsentUpdate(false, false);
      vjtConsentUpdate(false);
      banner.classList.add('hidden');
    });

    // --- Open Preferences ---
    document.getElementById('cookie-btn-preferences').addEventListener('click', function () {
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
    });

    // --- Close modal (Cancel / overlay click) ---
    function closeModal() {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }
    document.getElementById('cookie-modal-cancel').addEventListener('click', closeModal);
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closeModal();
    });

    // --- Save Preferences ---
    document.getElementById('cookie-modal-save').addEventListener('click', function () {
      var analytics = checkAnalytics.checked;
      var ads = checkAds.checked;
      setCookie({ analytics: analytics, ads: ads });
      gtagConsentUpdate(analytics, ads);
      vjtConsentUpdate(analytics);
      banner.classList.add('hidden');
      closeModal();
    });
  })();
</script>
