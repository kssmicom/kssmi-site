---
<section id="inquiry-form-section" class="pt-8 pb-16 lg:pt-12 lg:pb-24 bg-[#F5F5F4] contain-below-fold--lg" dir={isRTL ? 'rtl' : 'ltr'}>
  <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="font-Playfair text-[32px] lg:text-[42px] font-bold mb-4 text-[#5D4E37] leading-tight">
        {pt.projectFormTitle}
      </h2>
      <p class="text-stone-600 max-w-2xl mx-auto text-lg leading-relaxed">
        {pt.projectFormDesc}
      </p>
    </div>

    <!-- Form Container -->
    <div class="bg-[#FAFAFA] rounded-xl shadow-lg p-8 lg:p-10 border border-stone-100 max-w-5xl mx-auto">
      <!-- Success Message (hidden by default) -->
      <div id="form-success" class="hidden text-center py-10">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">{fm.successTitle}</h3>
        <p class="text-gray-600">{fm.successMessage}</p>
      </div>

      <!-- Error Message (hidden by default) -->
      <div id="form-error" class="hidden text-center py-6 px-4 bg-red-50 rounded-lg mb-6">
        <div class="flex items-center justify-center gap-2 text-red-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="error-message">An error occurred. Please try again.</span>
        </div>
      </div>

      <!-- Form -->
      <form id="inquiry-form" class="space-y-6">
        <!-- Hidden Fields for Context -->
        <input type="hidden" name="source" value="product_page" />
        <input type="hidden" name="product_url" value={currentUrl} />
        <input type="hidden" name="language" value={lang} />
        <input type="hidden" name="client_ip" id="client-ip" value="" />
        <input type="hidden" name="client_country" id="client-country" value="" />
        {productName && (
          <input type="hidden" name="product_name" value={productName} />
        )}

        <!-- Name / Organization Field -->
        <div>
          <label
            for="name"
            class="block text-sm font-medium text-gray-700 mb-2"
          >
            {pt.nameOrg} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name organization"
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg
                   focus:outline-none focus:ring-2 focus:ring-[#8B7355] focus:border-[#8B7355]
                   transition-colors duration-200
                   placeholder:text-gray-400"
            placeholder={ph.name}
          />
        </div>

        <!-- Email Field -->
        <div>
          <label
            for="email"
            class="block text-sm font-medium text-gray-700 mb-2"
          >
            {pt.officialEmail} <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg
                   focus:outline-none focus:ring-2 focus:ring-[#8B7355] focus:border-[#8B7355]
                   transition-colors duration-200
                   placeholder:text-gray-400"
            placeholder={ph.email}
          />
        </div>

        <!-- Project Details Field -->
        <div>
          <label
            for="details"
            class="block text-sm font-medium text-gray-700 mb-2"
          >
            {pt.projectDetails} <span class="text-red-500">*</span>
          </label>
          <textarea
            id="details"
            name="details"
            rows="9"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg
                   focus:outline-none focus:ring-2 focus:ring-[#8B7355] focus:border-[#8B7355]
                   transition-colors duration-200 resize-y
                   placeholder:text-gray-400"
            placeholder={ph.details}
          ></textarea>
        </div>

        <!-- Cloudflare Turnstile Widget (only in production) -->
        <div id="turnstile-container" class={`flex justify-center ${isDev ? 'hidden' : ''}`} data-sitekey={TURNSTILE_SITE_KEY || ''}></div>

        <!-- Turnstile Error Message (hidden by default) - shown right below Turnstile -->
        <div id="turnstile-error" class="hidden text-center py-3 px-4 bg-red-50 rounded-lg">
          <div class="flex items-center justify-center gap-2 text-red-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span id="turnstile-error-message" class="text-sm">Please click the security verification checkbox above to prove you are human.</span>
          </div>
        </div>

        <!-- Development Notice -->
        {isDev && (
          <div class="text-center text-xs text-amber-600 bg-amber-50 py-2 px-4 rounded-lg">
            Development Mode: Turnstile disabled for localhost testing
          </div>
        )}

        <!-- Submit Button -->
        <div class="pt-4">
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-[#5D4E37] text-white py-4 px-6 rounded-lg font-semibold
                   hover:bg-[#4A3D2E] active:bg-[#4a4030]
                   transition-colors duration-200
                   focus:outline-none focus:ring-2 focus:ring-[#8B7355] focus:ring-offset-2
                   flex items-center justify-center gap-2
                   disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="btn-text">{pt.submitRequest}</span>
            <svg id="btn-arrow" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
            <svg id="btn-spinner" class="hidden animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </div>

        <!-- Security Notice -->
        <div class="pt-4 text-center">
          <div class="flex items-center justify-center gap-4 text-xs text-gray-500">
            <!-- Lock Icon -->
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              {pt.secure256 || 'Secure 256-bit Encrypted'}
            </span>
            <span class="text-gray-400">|</span>
            <span>{pt.ndasAvailable || 'NDAs available'}</span>
          </div>
        </div>
      </form>
    </div>

    <!-- Alternative Contact Methods -->
    <div class="mt-10 text-center">
      <p class="text-gray-500 text-sm mb-4">{pt.contactDirectly || 'Or contact us directly:'}</p>
      <div class="flex flex-wrap justify-center gap-x-10 gap-y-4">
        <a
          href="tel:+86-135-1053-2553"
          class="flex items-center gap-2 text-gray-600 hover:text-[#5D4E37] transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="text-sm">+86-135-1053-2553</span>
        </a>
        <!-- Email (Keep in sync with Footer.astro email obfuscation) -->
        <a
          href="#email"
          data-email-user="sales"
          data-email-domain="kssmi.com"
          class="flex items-center gap-2 text-gray-600 hover:text-[#5D4E37] transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="text-sm">sales#kssmi.com</span>
        </a>
        <a
          href="https://wa.me/8613510532553"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-gray-600 hover:text-green-600 transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.5-.173-.007-.371-.009-.57-.009-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="text-sm">WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Define Turnstile callback BEFORE loading script (production only) -->
{!isDev && (
  <script is:inline>
    // Turnstile configuration
    var tc = document.getElementById('turnstile-container');
    window.TURNSTILE_SITE_KEY = tc ? tc.getAttribute('data-sitekey') : '';
    window.turnstileToken = null;

    // Called when Turnstile script loads
    window.onTurnstileLoad = function() {
      var container = document.getElementById('turnstile-container');
      if (!container) return;

      // Clear existing widget
      container.innerHTML = '';

      // Create widget div
      var widgetDiv = document.createElement('div');
      container.appendChild(widgetDiv);

      // Render Turnstile widget
      try {
        window.turnstile.render(widgetDiv, {
          sitekey: window.TURNSTILE_SITE_KEY,
          theme: 'light',
          callback: function(token) {
            window.turnstileToken = token;
            var errorEl = document.getElementById('turnstile-error');
            if (errorEl) errorEl.classList.add('hidden');
          },
          'expired-callback': function() {
            window.turnstileToken = null;
          }
        });
      } catch (e) { /* silent */ }
    };

    // Re-render after View Transitions
    document.addEventListener('astro:page-load', function() {
      window.turnstileToken = null;
      setTimeout(function() {
        if (typeof window.turnstile !== 'undefined') {
          window.onTurnstileLoad();
        }
      }, 100);
    });
  </script>
)}

<!-- Lazy-load Turnstile Script only when form approaches viewport (production only) -->
{!isDev && (
  <script is:inline>
    (function() {
      var turnstileStarted = false;
      var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting && !turnstileStarted) {
          turnstileStarted = true;
          observer.disconnect();
          // Already loaded from a previous View Transition? Render immediately
          if (typeof window.turnstile !== 'undefined' && window.turnstile.render) {
            window.onTurnstileLoad();
          } else {
            var script = document.createElement('script');
            script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
            script.async = true;
            script.defer = true;
            document.head.appendChild(script);
          }
        }
      }, { rootMargin: '300px' });
      var formSection = document.getElementById('inquiry-form-section');
      if (formSection) observer.observe(formSection);
    })();
  </script>
)}

<script define:vars={{ isDev, pt, turnstileErrorMsg, fm }}>
  // Fetch real visitor IP and country from client side
  async function fetchClientIP() {
    try {
      // Use ipapi.co - free, no API key needed, returns IP + country
      const response = await fetch('https://ipapi.co/json/', {
        method: 'GET',
        headers: { 'Accept': 'application/json' }
      }).catch(() => null);

      if (response && response.ok) {
        const data = await response.json().catch(() => null);
        if (data) {
          const clientIpInput = document.getElementById('client-ip');
          const clientCountryInput = document.getElementById('client-country');

          if (clientIpInput && data.ip) {
            clientIpInput.value = data.ip;
          }
          if (clientCountryInput && data.country_code) {
            clientCountryInput.value = data.country_code;
          }

          return { ip: data.ip, country: data.country_code };
        }
      }
    } catch (error) { /* silent */ }
    return { ip: null, country: null };
  }

  // Defer IP fetch until user first interacts with the form (avoids blocking page load)
  let ipFetched = false;
  document.addEventListener('focusin', function handler(e) {
    const form = document.getElementById('inquiry-form');
    if (form && form.contains(e.target) && !ipFetched) {
      ipFetched = true;
      fetchClientIP();
      document.removeEventListener('focusin', handler);
    }
  });

  // Form elements helper
  function getFormElements() {
    return {
      form: document.getElementById('inquiry-form'),
      submitBtn: document.getElementById('submit-btn'),
      btnText: document.getElementById('btn-text'),
      btnArrow: document.getElementById('btn-arrow'),
      btnSpinner: document.getElementById('btn-spinner'),
      errorContainer: document.getElementById('form-error'),
      errorMessage: document.getElementById('error-message'),
      turnstileErrorContainer: document.getElementById('turnstile-error'),
      turnstileErrorMessage: document.getElementById('turnstile-error-message'),
    };
  }

  // Loading state
  function setLoading(loading) {
    const { submitBtn, btnText, btnArrow, btnSpinner } = getFormElements();
    if (loading) {
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = fm.submitting;
      if (btnArrow) btnArrow.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');
    } else {
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = pt.submitRequest || 'Submit Request';
      if (btnArrow) btnArrow.classList.remove('hidden');
      if (btnSpinner) btnSpinner.classList.add('hidden');
    }
  }

  // Error display
  function showError(message) {
    const { errorContainer, errorMessage } = getFormElements();
    if (errorMessage) errorMessage.textContent = message;
    if (errorContainer) {
      errorContainer.classList.remove('hidden');
      errorContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function hideError() {
    const { errorContainer } = getFormElements();
    if (errorContainer) errorContainer.classList.add('hidden');
  }

  function showTurnstileError(message) {
    const { turnstileErrorContainer, turnstileErrorMessage } = getFormElements();
    if (turnstileErrorMessage) turnstileErrorMessage.textContent = message;
    if (turnstileErrorContainer) {
      turnstileErrorContainer.classList.remove('hidden');
      turnstileErrorContainer.style.display = 'block';
    }
  }

  function hideTurnstileError() {
    const { turnstileErrorContainer } = getFormElements();
    if (turnstileErrorContainer) turnstileErrorContainer.classList.add('hidden');
  }

  // Redirect helper
  function redirectToThankYou(lang) {
    const thankYouUrl = (lang === 'en') ? '/thank-you/' : `/${lang}/thank-you/`;
    window.location.href = thankYouUrl;
  }

  // Form submission setup
  function setupFormSubmission() {
    const { form } = getFormElements();
    if (!form) return;

    // Clone and replace to remove old listeners
    const newForm = form.cloneNode(true);
    form.parentNode.replaceChild(newForm, form);

    newForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      hideError();
      hideTurnstileError();

      // Check Turnstile (skip in dev) - use global token
      const token = window.turnstileToken;
      if (!isDev && !token) {
        showTurnstileError(turnstileErrorMsg);
        return;
      }

      // Gather form data
      const formData = new FormData(newForm);
      if (!isDev && token) {
        formData.append('cf-turnstile-response', token);
      }

      setLoading(true);

      try {
        const apiUrl = isDev ? 'http://localhost:4325/send-mail.php' : '/send-mail.php';

        const response = await fetch(apiUrl, {
          method: 'POST',
          body: formData
        });

        if (!response.ok) {
          const contentType = response.headers.get('content-type');
          if (contentType && contentType.includes('text/html')) {
            throw new Error('PHP_NOT_CONFIGURED');
          }
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const result = await response.json();

        if (result.success) {
          const currentLang = formData.get('language') || 'en';
          redirectToThankYou(currentLang);
        } else {
          const errorMsg = result.errors
            ? result.errors.join('. ')
            : (result.message || fm.errorDefault);
          showError(errorMsg);
          setLoading(false);
        }
      } catch (error) {

        if (isDev && (error.message.includes('Failed to fetch') || error.message.includes('NetworkError') || error.message === 'PHP_NOT_CONFIGURED')) {
          const name = formData.get('name');
          const email = formData.get('email');
          const details = formData.get('details');
          const product = formData.get('product_name') || 'N/A';

          const subject = encodeURIComponent(`Inquiry from Kssmi Website - ${name}`);
          const body = encodeURIComponent(
            `Name: ${name}\nEmail: ${email}\nProduct: ${product}\n\nProject Details:\n${details}`
          );

          showError(fm.phpNotRunning);

          const mailtoLink = document.createElement('a');
          mailtoLink.href = `mailto:sales@kssmi.com?subject=${subject}&body=${body}`;
          mailtoLink.className = 'inline-block mt-3 px-6 py-3 bg-[#5D4E37] text-white rounded-lg hover:bg-[#4A3D2E]';
          mailtoLink.textContent = fm.openEmailClient;
          mailtoLink.id = 'mailto-fallback';

          const existingBtn = document.getElementById('mailto-fallback');
          if (existingBtn) existingBtn.remove();

          const { errorContainer } = getFormElements();
          if (errorContainer) errorContainer.appendChild(mailtoLink);

          setLoading(false);
          return;
        }

        if (error.message === 'PHP_NOT_CONFIGURED') {
          showError(fm.phpNotConfigured);
        } else if (error.message.includes('Failed to fetch') || error.message.includes('NetworkError')) {
          showError(fm.cannotConnect);
        } else if (error.message.includes('Unexpected token')) {
          showError(fm.invalidResponse);
        } else {
          showError(fm.errorPrefix.replace('{0}', error.message));
        }

        setLoading(false);
      }
    });
  }

  // Initialize form
  setupFormSubmission();

  // Email Button Logic - Construct mailto dynamically to bypass obfuscation
  // Keep in sync with Footer.astro email obfuscation JS
  function initEmailButtons() {
    const emailButtons = document.querySelectorAll('[data-email-user][data-email-domain]');
    emailButtons.forEach(function(btn) {
      const user = btn.getAttribute('data-email-user');
      const domain = btn.getAttribute('data-email-domain');
      const mailtoUrl = 'mailto:' + user + '@' + domain;

      // On hover, set the real href so browser shows it in status bar
      btn.onmouseenter = function() {
        this.href = mailtoUrl;
      };

      // On mouse leave, reset to placeholder
      btn.onmouseleave = function() {
        this.href = '#email';
      };

      // On click, ensure href is set and let browser handle it
      btn.onclick = function(e) {
        this.href = mailtoUrl;
      };
    });
  }

  // Initialize email buttons
  initEmailButtons();

  // Re-setup after View Transitions
  document.addEventListener('astro:page-load', function() {
    setupFormSubmission();
    initEmailButtons();
  });
</script>
