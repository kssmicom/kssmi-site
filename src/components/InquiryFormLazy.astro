---
/** InquiryFormLazy — loads InquiryForm via fetch immediately — saves 44KB from initial HTML */
interface Props {
  lang?: string;
  productName?: string;
  productSku?: string;
  productUrl?: string;
  source?: string;
}
const {
  lang = 'en',
  productName = '',
  productSku = '',
  productUrl = '',
  source = 'general_inquiry',
} = Astro.props;
---

<div
  id="inquiry-form-lazy"
  data-lang={lang}
  data-product={productName}
  data-product-sku={productSku}
  data-product-url={productUrl}
  data-source={source}
  style="min-height:200px"
  class="inquiry-form-placeholder scroll-mt-[80px]"
></div>

<script>
  function cleanText(value: string, maxLength: number): string {
    return value.replace(/[\u0000-\u001f\u007f]/g, '').trim().slice(0, maxLength);
  }

  function localProductPath(value: string): string {
    if (!value) return '';
    try {
      const parsed = new URL(value, window.location.origin);
      if (parsed.origin !== window.location.origin) return '';
      return parsed.pathname.startsWith('/') ? parsed.pathname : '';
    } catch (_) {
      return '';
    }
  }

  function setHidden(form: HTMLFormElement, name: string, value: string): void {
    let input = form.querySelector(`input[name="${name}"]`) as HTMLInputElement | null;
    if (!input) {
      input = document.createElement('input');
      input.type = 'hidden';
      input.name = name;
      form.appendChild(input);
    }
    input.value = value;
  }

  function loadInquiryForm(): void {
    const el = document.getElementById('inquiry-form-lazy');
    if (!el || el.dataset.loaded === 'true') return;
    el.dataset.loaded = 'true';
    const lang = el.dataset.lang || 'en';
    const url = '/inquiry-form/' + lang + '/';
    fetch(url)
      .then(function (r) { return r.text(); })
      .then(function (html) {
        el.innerHTML = html;

        const form = el.querySelector('form') as HTMLFormElement | null;
        if (form) {
          const params = new URLSearchParams(window.location.search);
          const source = cleanText(el.dataset.source || 'general_inquiry', 128);
          const isProductPage = source === 'product_page';
          const productName = cleanText(
            isProductPage
              ? (el.dataset.product || '')
              : (params.get('product_name') || params.get('product') || el.dataset.product || ''),
            256
          );
          const productSku = cleanText(
            isProductPage ? (el.dataset.productSku || '') : (params.get('sku') || el.dataset.productSku || ''),
            80
          ).toUpperCase();
          const requestedProductUrl = isProductPage
            ? (el.dataset.productUrl || window.location.pathname)
            : (params.get('product_url') || el.dataset.productUrl || window.location.pathname);
          const productUrl = localProductPath(requestedProductUrl) || window.location.pathname;

          setHidden(form, 'source', source);
          setHidden(form, 'product_name', productName || 'General Inquiry');
          setHidden(form, 'product_sku', productSku);
          setHidden(form, 'product_url', productUrl);
          setHidden(form, 'language', lang);
        }

        const scripts = el.querySelectorAll('script');
        scripts.forEach(function (s) {
          const ns = document.createElement('script');
          Array.from(s.attributes).forEach(function (a) { ns.setAttribute(a.name, a.value); });
          ns.textContent = s.textContent;
          s.replaceWith(ns);
        });
      })
      .catch(function () {
        el.innerHTML = '<p class="text-gray-500 text-center py-8">Form failed to load. Please <a href="/contact" class="text-[#8B7355] underline">contact us</a> directly.</p>';
      });
  }

  // Run on initial load AND on Astro View Transitions (SPA navigation)
  loadInquiryForm();
  document.addEventListener('astro:page-load', loadInquiryForm);
</script>
