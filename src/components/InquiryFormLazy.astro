---
/**
 * Kept under its established name so existing pages and CTA anchors continue to
 * work. The form itself is rendered with the page instead of fetched and
 * injected after load: Turnstile and submission scripts are then managed by
 * Astro normally and there is no second-request failure state.
 */
import InquiryForm from './InquiryForm.astro';

interface Props {
  lang?: string;
  productName?: string;
  productSku?: string;
  productUrl?: string;
  source?: string;
}

const {
  lang = 'en',
  productName = '',
  productSku = '',
  productUrl = '',
  source = 'general_inquiry',
} = Astro.props;
const resolvedProductUrl = productUrl || Astro.url.pathname;
---

<div
  id="inquiry-form-lazy"
  data-source={source}
  data-product={productName}
  data-product-sku={productSku}
  data-product-url={resolvedProductUrl}
  class="scroll-mt-[80px]"
>
  <InquiryForm
    lang={lang}
    productName={productName}
    productSku={productSku}
    productUrl={resolvedProductUrl}
    source={source}
  />
</div>

<script>
  // Preserve product context supplied in legacy campaign links without making
  // the form depend on a second HTTP request. Product-page context always comes
  // from the generated page and must not be replaced by query-string values.
  function cleanText(value: string, maxLength: number): string {
    return value.replace(/[\u0000-\u001f\u007f]/g, '').trim().slice(0, maxLength);
  }

  function localProductPath(value: string): string {
    if (!value) return '';
    try {
      const parsed = new URL(value, window.location.origin);
      return parsed.origin === window.location.origin && parsed.pathname.startsWith('/')
        ? parsed.pathname
        : '';
    } catch {
      return '';
    }
  }

  function setHidden(form: HTMLFormElement, name: string, value: string): void {
    const input = form.querySelector(`input[name="${name}"]`) as HTMLInputElement | null;
    if (input) input.value = value;
  }

  function applyInquiryContext(): void {
    const container = document.getElementById('inquiry-form-lazy');
    const form = container?.querySelector('form') as HTMLFormElement | null;
    if (!container || !form || container.dataset.contextApplied === 'true') return;
    container.dataset.contextApplied = 'true';

    if (container.dataset.source === 'product_page') return;

    const params = new URLSearchParams(window.location.search);
    const productName = cleanText(
      params.get('product_name') || params.get('product') || container.dataset.product || '',
      256,
    );
    const productSku = cleanText(
      params.get('sku') || container.dataset.productSku || '',
      80,
    ).toUpperCase();
    const productUrl = localProductPath(
      params.get('product_url') || container.dataset.productUrl || window.location.pathname,
    ) || window.location.pathname;

    setHidden(form, 'product_name', productName || 'General Inquiry');
    setHidden(form, 'product_sku', productSku);
    setHidden(form, 'product_url', productUrl);
  }

  applyInquiryContext();
  document.addEventListener('astro:page-load', applyInquiryContext);
</script>
