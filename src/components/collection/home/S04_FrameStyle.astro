---
import { getEntry } from 'astro:content';
import { getTranslations, type Translations } from '../../../translations';
import { cardSrc } from '../../../utils/image';

const { lang = 'en' } = Astro.props as { lang?: string };
const isRTL = lang === 'ar';
const t = await getTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;
const entry = await getEntry('collection', `home/s04-frame-style.${lang}`);
const eyebrow = entry?.data?.eyebrow || 'Frame Style';
const heading = entry?.data?.heading || 'Eyewear Frame Style Solutions';
const subheading = entry?.data?.subheading || '';
const materials = entry?.data?.materials || [];
---

<section class="relative pt-11 pb-20 md:pt-14 md:pb-20 bg-gray-50 border-t border-gray-300/80 overflow-hidden" dir={isRTL ? 'rtl' : 'ltr'}>
  <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4 lg:px-0">
    <!-- Section header -->
    <div class="text-center mb-12 md:mb-16">
      <span class="flex items-center justify-center gap-2 text-stone-500 hover:text-amber-700 text-xs font-medium tracking-[0.2em] uppercase mb-4 transition-colors duration-300 cursor-pointer">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
          <path d="M20 3v4M22 5h-4M4 17v2M5 18H3"/>
        </svg>
        — {eyebrow} —
      </span>
      <h2 class="text-2xl md:text-4xl font-bold text-stone-800 bg-gradient-to-r from-[#32170D] via-[#B85C27] to-[#32170D] bg-[length:200%_auto] bg-right hover:bg-left text-transparent bg-clip-text transition-all duration-700 ease-in-out cursor-pointer mb-6">
        {heading}
      </h2>
      <p class="text-base md:text-lg text-stone-600 hover:text-[#5D4E37] leading-relaxed max-w-3xl mx-auto transition-colors duration-300 cursor-pointer">
        {subheading}
      </p>
    </div>

    <!-- Frame Style grid - unified single block, 3 cols -->
    <div class="max-w-[1100px] mx-auto bg-gray-100/60 backdrop-blur-sm rounded-2xl overflow-hidden border border-white/40 shadow-sm">
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-[1px]">
        {materials.map((m: any, i: number) => (
          <div
            class="con-cell group relative bg-white/90 backdrop-blur-md cursor-pointer transition-all duration-500 ease-out motion-safe:animate-[conCellIn_0.6s_cubic-bezier(0.22,1,0.36,1)_both] flex flex-col"
            style={`animation-delay: ${0.1 + i * 0.07}s`}
          >
            <!-- Image -->
            <a href={`${prefix}/product/?style=${m.slug}`} class="relative aspect-[4/3] overflow-hidden bg-gray-200 block">
              <img
                src={cardSrc(m.image)}
                alt={m.name}
                width="400"
                height="300"
                loading={i >= 3 ? 'lazy' : 'eager'}
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-110 motion-safe:group-hover:brightness-105"
              />
            </a>

            <!-- Content (title + subtitle + bullet list) -->
            <div class="p-5 md:p-6 bg-white/70 backdrop-blur-md flex-1 flex flex-col">
              <a href={`${prefix}/product/?style=${m.slug}`} class="block text-center">
                <h3 class="con-title relative text-sm md:text-base font-bold text-stone-800 group-hover:text-amber-700 transition-colors duration-300 mb-1.5 inline-block pb-2">
                  {m.name}
                  <span class="con-underline absolute bottom-0 left-1/2 w-0 h-[1px] bg-stone-700 transition-all duration-500 group-hover:w-[70%] group-hover:-translate-x-1/2"></span>
                </h3>
              </a>

              <p class="text-xs md:text-sm text-stone-600 hover:text-[#5D4E37] leading-relaxed mb-5 text-center transition-colors duration-300 cursor-pointer">
                {m.subtitle}
              </p>

              <ul class="space-y-2.5 flex-1">
                {m.points?.map((point: string) => (
                  <li class="con-point group/item flex items-start gap-2 text-xs md:text-sm text-stone-600 transition-all duration-300 cursor-default">
                    <span class="con-circle mt-0.5 w-4 h-4 rounded-full bg-gray-200/80 flex items-center justify-center mr-1 shrink-0 transition-all duration-300 group-hover/item:bg-amber-700 group-hover/item:scale-110">
                      <svg class="w-2.5 h-2.5 text-stone-500 group-hover/item:text-white transition-all duration-300 group-hover/item:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    <span class="con-text leading-snug transition-colors duration-300 group-hover/item:text-amber-700 group-hover/item:font-medium">{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Bottom accent line - grows on hover -->
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-gray-300 to-transparent group-hover:via-stone-700 transition-all duration-500"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes conCellIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .con-cell {
    will-change: transform, box-shadow;
  }

  .con-cell:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.12);
    z-index: 10;
  }

  @media (prefers-reduced-motion: reduce) {
    .con-cell {
      animation: none;
      opacity: 1;
    }
    .con-cell:hover {
      transform: none;
    }
  }
</style>
