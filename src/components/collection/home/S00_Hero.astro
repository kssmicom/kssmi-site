---
import { getEntry } from 'astro:content';

const { lang = 'en' } = Astro.props as { lang?: string };
const isRTL = lang === 'ar';
const prefix = lang === 'en' ? '' : `/${lang}`;

const entry = await getEntry('collection', `home/s00-hero.${lang}`);
const d = entry?.data || ({} as any);

// All copy comes from the markdown file — nothing is hardcoded here.
const heading = d.heading;
const subheadingLine1 = d.subheadingLine1;
const subheadingLine2 = d.subheadingLine2;
const description = d.description;
const primaryCta = d.primaryCta;
const primaryCtaUrl = d.primaryCtaUrl;
const secondaryCta = d.secondaryCta;
const secondaryCtaUrl = d.secondaryCtaUrl;
const tags: string[] = d.tags || [];
const featureTags: string[] = d.featureTags || [];
const posterImage = d.posterImage;
const posterAlt = d.posterAlt;

// Background video = mp4 URL from the markdown (`videoUrl`). The URL is intentionally kept
// out of the initial <source> so the poster remains the only first-load media request.
// On every device, the client assigns the URL only after both window.load and the first
// real user interaction. This keeps the 15 MB background file out of the critical path.
const videoUrl: string | undefined = d.videoUrl;

// Build locale-aware internal links (external URLs are left untouched)
const toHref = (url?: string) =>
  !url ? undefined : url.startsWith('http') ? url : `${prefix}${url}`;
const primaryHref = toHref(primaryCtaUrl);
const secondaryHref = toHref(secondaryCtaUrl);
---

<section
  id="hero-section"
  class="hero relative w-full overflow-hidden bg-[#1a0f08] -mt-20 pt-20 min-h-screen min-h-svh flex items-center"
  dir={isRTL ? 'rtl' : 'ltr'}
  aria-label={heading}
>
  <!-- Poster image = instant first paint / LCP. It stays as the base layer; the <video>
       is layered on top after load, so it never competes with LCP for bandwidth. -->
  {posterImage && (
    <img
      src={posterImage}
      alt={posterAlt || heading || ''}
      class="absolute inset-0 w-full h-full object-cover" width="1920" height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}

  <!-- Background video: the poster is the default experience. The URL is assigned only
       after window.load and a trusted click or real scroll on the current home page, so
       this element cannot compete with the poster for the initial connection. object-cover
       fills the hero.

       transition:persist keeps the SAME <video> DOM node across Astro view transitions
       (language switch / page navigation). Without it, Astro's morph algorithm removes
       and re-adds the element on every navigation; the browser auto-pauses the video on
       detach, and because the src matches the new node, autoplay never re-triggers —
       the video freezes on the first frame until a hard reload. With transition:persist
       + id="hero-video", Astro keeps this exact node (and its playback state) alive
       across all language switches, so playback continues seamlessly. The id is required
       so Astro can uniquely identify the persisted element. -->
  {videoUrl && (
    <video
      id="hero-video"
      transition:persist
      class="hero-video absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700"
      muted
      loop
      playsinline
      poster={posterImage}
      preload="none"
      data-src={videoUrl}
      aria-hidden="true"
      tabindex="-1"
    ></video>
  )}

  <!-- Dark scrim: stronger on the text (start) side for 4.5:1 contrast -->
  <div
    class="absolute inset-0 bg-linear-to-r from-black/85 via-black/60 to-black/25 ltr-only"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-linear-to-l from-black/85 via-black/60 to-black/25 rtl-only hidden"
    aria-hidden="true"
  ></div>
  <!-- Bottom vignette for tag legibility -->
  <div class="absolute inset-x-0 bottom-0 h-40 bg-linear-to-t from-black/70 to-transparent" aria-hidden="true"></div>

  <!-- Content -->
  <div class="relative z-10 w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4 py-20 md:py-24 lg:py-28">
    <div class="max-w-2xl lg:max-w-3xl">

      <!-- Headline -->
      {heading && (
        <h1 class="hero-fade text-[1.2rem] sm:text-[1.44rem] lg:text-[1.92rem] xl:text-[2.176rem] font-extrabold leading-[1.15] text-white tracking-tight mb-6" style="animation-delay:0.08s">
          {heading}
        </h1>
      )}

      <!-- Emphasized subheading lines -->
      {(subheadingLine1 || subheadingLine2) && (
        <p class="hero-fade text-lg sm:text-xl lg:text-2xl font-semibold leading-snug mb-5" style="animation-delay:0.16s">
          {subheadingLine1 && (
            <span class="block bg-linear-to-r from-[#F5D08A] via-[#F0B85A] to-[#E0A23C] bg-clip-text text-transparent">
              {subheadingLine1}
            </span>
          )}
          {subheadingLine2 && <span class="block text-white/95">{subheadingLine2}</span>}
        </p>
      )}

      <!-- Description -->
      {description && (
        <p class="hero-fade text-sm sm:text-base lg:text-lg text-stone-200/90 leading-relaxed max-w-xl lg:max-w-2xl mb-8" style="animation-delay:0.24s">
          {description}
        </p>
      )}

      <!-- CTAs -->
      {(primaryCta || secondaryCta) && (
        <div class="hero-fade flex flex-col sm:flex-row sm:flex-wrap gap-3.5 sm:gap-4 mb-9" style="animation-delay:0.32s">
          {primaryCta && (
            <a
              href={primaryHref}
              class="group inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-white bg-[#B45309] hover:bg-[#92400E] shadow-lg shadow-amber-950/30 hover:shadow-xl hover:shadow-amber-950/40 hover:-translate-y-0.5 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-black/50 transition-all duration-300 cursor-pointer"
            >
              {primaryCta}
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          )}
          {secondaryCta && (
            <a
              href={secondaryHref}
              class="group inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-white bg-white/10 backdrop-blur-xs border border-white/30 hover:bg-white/20 hover:border-white/50 hover:-translate-y-0.5 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-black/50 transition-all duration-300 cursor-pointer"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M12 3v13M7 8l5-5 5 5"/>
              </svg>
              {secondaryCta}
            </a>
          )}
        </div>
      )}

      <!-- SEO / category tags (smaller bullet row) -->
      {tags.length > 0 && (
        <ul class="hero-fade flex flex-wrap items-center gap-x-5 gap-y-2.5 text-xs sm:text-sm text-stone-200/85" style="animation-delay:0.40s">
          {tags.map((tag) => (
            <li class="inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400/80" aria-hidden="true"></span>
              {tag}
            </li>
          ))}
        </ul>
      )}

      <!-- Process feature tags (third visual row of hero — pill chips) -->
      {featureTags.length > 0 && (
        <ul class="hero-fade flex flex-wrap items-center gap-2.5 text-xs sm:text-sm mt-3.5" style="animation-delay:0.48s">
          {featureTags.map((tag) => (
            <li class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-xs border border-white/25 text-stone-100/90 hover:bg-white/15 hover:border-white/40 transition-colors duration-200">
              {tag}
            </li>
          ))}
        </ul>
      )}

    </div>
  </div>
</section>

<style is:global>
  .hero-fade {
    opacity: 0;
    transform: translateY(18px);
    animation: heroFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes heroFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* RTL: swap which scrim shows */
  [dir='rtl'] .ltr-only { display: none; }
  [dir='rtl'] .rtl-only { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<style>
  /* Feature tags (process tags) — pill chips rendered as the third visual row
     of the hero. The pill style is more prominent than the bullet-dot row and
     visually groups the 5 capability tags as one cohesive unit. */
  ul.hero-fade li.inline-flex {
    white-space: nowrap;
  }
</style>

<script>
  // Policy: every device can play the full-bleed hero video, but the MP4 URL is not assigned
  // until the page has fully loaded AND the visitor clicks or genuinely scrolls on the
  // current home page. Generic scroll events and sticky browser userActivation are
  // intentionally excluded because restoration, browser chrome and earlier pages can
  // trigger them without a current-page gesture.
  const TOUCH_SCROLL_THRESHOLD = 12;
  const interactionOptions: AddEventListenerOptions = { passive: true };
  let pageLoaded = document.readyState === 'complete';
  let interactionSeen = false;
  let loadCallbackPending = false;
  let interactionListenersAttached = false;
  let touchStartY: number | null = null;

  function currentHeroVideos() {
    return Array.from(document.querySelectorAll<HTMLVideoElement>('.hero-video'));
  }

  function loadHeroVideo() {
    currentHeroVideos().forEach((v) => {
      if (!v.isConnected || v.dataset.userStarted !== '1' || v.dataset.loaded || !v.dataset.src) return;
      v.dataset.loaded = '1';
      v.src = v.dataset.src;
      v.load();
      v.play().catch(() => {});
    });
  }

  function fadeInHeroVideo() {
    currentHeroVideos().forEach((v) => {
      if (v.dataset.userStarted !== '1' || v.dataset.fadedIn || !v.dataset.loaded) return;
      const show = () => {
        if (!v.isConnected || v.dataset.userStarted !== '1' || v.dataset.fadedIn || !v.dataset.loaded) return;
        v.dataset.fadedIn = '1';
        requestAnimationFrame(() => {
          if (!v.isConnected || v.dataset.userStarted !== '1') return;
          v.style.opacity = '1';
          // Belt-and-suspenders: if the browser ever paused playback across a view
          // transition (e.g., a browser/UA that doesn't honor transition:persist),
          // resume it. play() is a no-op when the element is already playing, so this
          // costs nothing on the normal path.
          if (v.paused) v.play().catch(() => {});
        });
      };
      if (v.readyState >= 2 /* HAVE_CURRENT_DATA */) {
        show();
      } else {
        v.addEventListener('loadeddata', show, { once: true });
      }
    });
  }

  function runVideoLoad() {
    loadCallbackPending = false;
    loadHeroVideo();
    fadeInHeroVideo();
  }

  function scheduleVideoAfterPolicyGate() {
    if (!pageLoaded || !interactionSeen || loadCallbackPending) return;

    const hasPendingVideo = currentHeroVideos().some(
      (v) => v.dataset.userStarted === '1' && !v.dataset.loaded && Boolean(v.dataset.src)
    );

    if (!hasPendingVideo) {
      fadeInHeroVideo();
      return;
    }

    loadCallbackPending = true;
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(runVideoLoad, { timeout: 1500 });
    } else {
      setTimeout(runVideoLoad, 0);
    }
  }

  function removeInteractionListeners() {
    if (!interactionListenersAttached) return;
    document.removeEventListener('click', markClickInteraction, interactionOptions);
    document.removeEventListener('touchstart', recordTouchStart, interactionOptions);
    document.removeEventListener('touchmove', markTouchScrollInteraction, interactionOptions);
    document.removeEventListener('touchend', clearTouchStart, interactionOptions);
    document.removeEventListener('touchcancel', clearTouchStart, interactionOptions);
    document.removeEventListener('wheel', markWheelInteraction, interactionOptions);
    interactionListenersAttached = false;
    touchStartY = null;
  }

  function addInteractionListeners() {
    if (interactionListenersAttached) return;
    document.addEventListener('click', markClickInteraction, interactionOptions);
    document.addEventListener('touchstart', recordTouchStart, interactionOptions);
    document.addEventListener('touchmove', markTouchScrollInteraction, interactionOptions);
    document.addEventListener('touchend', clearTouchStart, interactionOptions);
    document.addEventListener('touchcancel', clearTouchStart, interactionOptions);
    document.addEventListener('wheel', markWheelInteraction, interactionOptions);
    interactionListenersAttached = true;
  }

  function markCurrentHeroStarted() {
    const videos = currentHeroVideos();
    if (interactionSeen || videos.length === 0) return;
    interactionSeen = true;
    videos.forEach((v) => {
      v.dataset.userStarted = '1';
    });
    removeInteractionListeners();
    scheduleVideoAfterPolicyGate();
  }

  function clickLeavesCurrentPage(event: MouseEvent) {
    const target = event.target instanceof Element ? event.target : null;
    const anchor = target?.closest<HTMLAnchorElement>('a[href]');
    if (!anchor) return false;
    if (anchor.hasAttribute('download') || (anchor.target && anchor.target !== '_self')) return true;

    try {
      const destination = new URL(anchor.href, window.location.href);
      return destination.origin !== window.location.origin
        || destination.pathname !== window.location.pathname
        || destination.search !== window.location.search;
    } catch {
      return true;
    }
  }

  function markClickInteraction(event: MouseEvent) {
    if (!event.isTrusted || clickLeavesCurrentPage(event)) return;
    markCurrentHeroStarted();
  }

  function recordTouchStart(event: TouchEvent) {
    if (!event.isTrusted || interactionSeen || currentHeroVideos().length === 0) {
      touchStartY = null;
      return;
    }
    touchStartY = event.touches[0]?.clientY ?? null;
  }

  function markTouchScrollInteraction(event: TouchEvent) {
    if (!event.isTrusted || touchStartY === null) return;
    const currentY = event.touches[0]?.clientY;
    if (currentY === undefined || Math.abs(currentY - touchStartY) < TOUCH_SCROLL_THRESHOLD) return;
    touchStartY = null;
    markCurrentHeroStarted();
  }

  function clearTouchStart() {
    touchStartY = null;
  }

  function markWheelInteraction(event: WheelEvent) {
    if (!event.isTrusted || (event.deltaX === 0 && event.deltaY === 0)) return;
    markCurrentHeroStarted();
  }

  function syncInteractionGate() {
    const videos = currentHeroVideos();
    interactionSeen = videos.some((v) => v.dataset.userStarted === '1');

    if (videos.length === 0 || interactionSeen) {
      removeInteractionListeners();
    } else {
      addInteractionListeners();
    }

    scheduleVideoAfterPolicyGate();
  }

  function resumeStartedHeroVideos() {
    currentHeroVideos().forEach((v) => {
      if (v.dataset.userStarted === '1' && v.dataset.loaded && v.paused) {
        v.play().catch(() => {});
      }
    });
  }

  syncInteractionGate();

  if (!pageLoaded) {
    window.addEventListener('load', () => {
      pageLoaded = true;
      scheduleVideoAfterPolicyGate();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', () => {
    // Re-evaluate the video element after Astro has installed the current page. A click
    // that navigated here does not count; only a marker on the current/persisted hero does.
    syncInteractionGate();
  });

  // Also cover late script execution where astro:page-load has already fired.
  scheduleVideoAfterPolicyGate();

  // Belt-and-suspenders: explicitly resume playback after every view transition, in
  // case transition:persist ever fails to preserve playback state on a given browser.
  // astro:after-swap fires after the new DOM is in place, before astro:page-load.
  document.addEventListener('astro:after-swap', () => {
    syncInteractionGate();
    resumeStartedHeroVideos();
  });
  // Back/forward cache restore — astro:page-load doesn't fire after bfcache restore.
  window.addEventListener('pageshow', (e) => {
    if ((e as any).persisted) {
      pageLoaded = true;
      syncInteractionGate();
      resumeStartedHeroVideos();
    }
  });
</script>
