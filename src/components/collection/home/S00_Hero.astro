---
import { getEntry } from 'astro:content';

const { lang = 'en' } = Astro.props as { lang?: string };
const isRTL = lang === 'ar';
const prefix = lang === 'en' ? '' : `/${lang}`;

const entry = await getEntry('collection', `home/s00-hero.${lang}`);
const d = entry?.data || ({} as any);

// All copy comes from the markdown file — nothing is hardcoded here.
const heading = d.heading;
const subheadingLine1 = d.subheadingLine1;
const subheadingLine2 = d.subheadingLine2;
const description = d.description;
const primaryCta = d.primaryCta;
const primaryCtaUrl = d.primaryCtaUrl;
const secondaryCta = d.secondaryCta;
const secondaryCtaUrl = d.secondaryCtaUrl;
const tags: string[] = d.tags || [];
const videoUrl = d.videoUrl;
const posterImage = d.posterImage;
const posterAlt = d.posterAlt;

// Adaptive (HLS) background player via Gumlet. The asset ID is derived from the existing
// video URL (…/{assetId}/main.mp4). We mount the player lazily after first paint, so the
// 15 MB progressive MP4 is never fetched and mobile gets a low-bitrate rendition automatically.
const gumletId = typeof videoUrl === 'string' ? videoUrl.split('/').filter(Boolean).at(-2) : undefined;
const embedSrc = gumletId
  ? `https://play.gumlet.io/embed/${gumletId}?background=true&autoplay=true&loop=true&disable_player_controls=true&muted=true`
  : undefined;

// Build locale-aware internal links (external URLs are left untouched)
const toHref = (url?: string) =>
  !url ? undefined : url.startsWith('http') ? url : `${prefix}${url}`;
const primaryHref = toHref(primaryCtaUrl);
const secondaryHref = toHref(secondaryCtaUrl);
---

<section
  class="hero relative w-full overflow-hidden bg-[#1a0f08] -mt-20 pt-20 min-h-[620px] sm:min-h-[700px] lg:min-h-screen flex items-center"
  dir={isRTL ? 'rtl' : 'ltr'}
  aria-label={heading}
>
  <!-- Poster image = instant first paint / LCP. It stays as the base layer; the adaptive
       video player is layered on top after load, so it never competes with LCP for bandwidth. -->
  {posterImage && (
    <img
      src={posterImage}
      alt={posterAlt || heading || ''}
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}

  <!-- Adaptive (HLS) background video via the Gumlet player, mounted lazily by the script
       below. Stays hidden (and unfetched) until after load; skipped under reduced-motion. -->
  {embedSrc && (
    <div
      class="hero-video-mount absolute inset-0 w-full h-full overflow-hidden opacity-0 transition-opacity duration-700"
      data-embed={embedSrc}
      aria-hidden="true"
    ></div>
  )}

  <!-- Dark scrim: stronger on the text (start) side for 4.5:1 contrast -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/25 ltr-only"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-l from-black/85 via-black/60 to-black/25 rtl-only hidden"
    aria-hidden="true"
  ></div>
  <!-- Bottom vignette for tag legibility -->
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-black/70 to-transparent" aria-hidden="true"></div>

  <!-- Content -->
  <div class="relative z-10 w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4 py-20 md:py-24 lg:py-28">
    <div class="max-w-2xl lg:max-w-3xl">

      <!-- Headline -->
      {heading && (
        <h1 class="hero-fade text-[1.2rem] sm:text-[1.44rem] lg:text-[1.92rem] xl:text-[2.176rem] font-extrabold leading-[1.15] text-white tracking-tight mb-6" style="animation-delay:0.08s">
          {heading}
        </h1>
      )}

      <!-- Emphasized subheading lines -->
      {(subheadingLine1 || subheadingLine2) && (
        <p class="hero-fade text-lg sm:text-xl lg:text-2xl font-semibold leading-snug mb-5" style="animation-delay:0.16s">
          {subheadingLine1 && (
            <span class="block bg-gradient-to-r from-[#F5D08A] via-[#F0B85A] to-[#E0A23C] bg-clip-text text-transparent">
              {subheadingLine1}
            </span>
          )}
          {subheadingLine2 && <span class="block text-white/95">{subheadingLine2}</span>}
        </p>
      )}

      <!-- Description -->
      {description && (
        <p class="hero-fade text-sm sm:text-base lg:text-lg text-stone-200/90 leading-relaxed max-w-xl lg:max-w-2xl mb-8" style="animation-delay:0.24s">
          {description}
        </p>
      )}

      <!-- CTAs -->
      {(primaryCta || secondaryCta) && (
        <div class="hero-fade flex flex-col sm:flex-row sm:flex-wrap gap-3.5 sm:gap-4 mb-9" style="animation-delay:0.32s">
          {primaryCta && (
            <a
              href={primaryHref}
              class="group inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-white bg-[#B45309] hover:bg-[#92400E] shadow-lg shadow-amber-950/30 hover:shadow-xl hover:shadow-amber-950/40 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-black/50 transition-all duration-300 cursor-pointer"
            >
              {primaryCta}
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          )}
          {secondaryCta && (
            <a
              href={secondaryHref}
              class="group inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-sm sm:text-base font-semibold text-white bg-white/10 backdrop-blur-sm border border-white/30 hover:bg-white/20 hover:border-white/50 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-black/50 transition-all duration-300 cursor-pointer"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M12 3v13M7 8l5-5 5 5"/>
              </svg>
              {secondaryCta}
            </a>
          )}
        </div>
      )}

      <!-- Process tags -->
      {tags.length > 0 && (
        <ul class="hero-fade flex flex-wrap items-center gap-x-5 gap-y-2.5 text-xs sm:text-sm text-stone-200/85" style="animation-delay:0.40s">
          {tags.map((tag) => (
            <li class="inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400/80" aria-hidden="true"></span>
              {tag}
            </li>
          ))}
        </ul>
      )}

    </div>
  </div>
</section>

<style is:global>
  /* The Gumlet player keeps the video's 16:9 ratio (letterboxes inside the iframe), so we
     over-scale the iframe and center it to emulate object-fit:cover — the video fully covers
     the hero box and overflow is clipped, matching the poster image exactly. */
  .hero-video-mount iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 56.25vw;        /* 16:9 derived from width  */
    min-width: 177.78vh;    /* 16:9 derived from height */
    min-height: 100vh;
    border: 0;
    pointer-events: none;
  }

  .hero-fade {
    opacity: 0;
    transform: translateY(18px);
    animation: heroFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes heroFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* RTL: swap which scrim shows */
  [dir='rtl'] .ltr-only { display: none; }
  [dir='rtl'] .rtl-only { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Lazily mount the Gumlet adaptive-streaming player AFTER first paint, so the hero video
  // never competes with LCP. Skipped entirely under prefers-reduced-motion (poster stays).
  // Uses astro:page-load so it also runs after client-side View Transitions navigations.
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');

  function mountHeroVideo() {
    if (mq.matches) return;
    document.querySelectorAll<HTMLElement>('.hero-video-mount').forEach((mount) => {
      if (mount.dataset.mounted || !mount.dataset.embed) return;
      const iframe = document.createElement('iframe');
      iframe.src = mount.dataset.embed;
      iframe.title = 'Background showreel';
      iframe.loading = 'lazy';
      iframe.tabIndex = -1;
      iframe.setAttribute('referrerpolicy', 'origin');
      iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
      mount.appendChild(iframe);
      mount.dataset.mounted = '1';
      requestAnimationFrame(() => { mount.style.opacity = '1'; });
    });
  }

  function scheduleHeroVideo() {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(mountHeroVideo, { timeout: 2500 });
    } else {
      setTimeout(mountHeroVideo, 1200);
    }
  }

  document.addEventListener('astro:page-load', scheduleHeroVideo);
</script>
