---
import { getEntry } from 'astro:content';
import { translations } from '../../../translations';
import { cardSrc } from '../../../utils/image';

const { lang = 'en' } = Astro.props as { lang?: string };
const isRTL = lang === 'ar';
const t = (translations as any)[lang] || translations.en;
const prefix = lang === 'en' ? '' : `/${lang}`;
const entry = await getEntry('collection', `home/s03-frame-shape.${lang}`);
const eyebrow = entry?.data?.eyebrow || 'Frame Shape';
const heading = entry?.data?.heading || 'Eyewear Frame Shape';
const subheading = entry?.data?.subheading || '';
const highlightedSubheading = subheading.replace(/Mazzucchelli/g, '<span class="text-amber-700 font-medium">Mazzucchelli</span>');
const materials = entry?.data?.materials || [];
---

<section class="relative pt-11 pb-20 md:pt-14 md:pb-20 bg-stone-50 border-t border-stone-300/80 overflow-hidden" dir={isRTL ? 'rtl' : 'ltr'}>
  <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4 lg:px-0">
    <!-- Section header - Clean minimal style -->
    <div class="text-center mb-12 md:mb-16">
      <span class="flex items-center justify-center gap-2 text-stone-500 hover:text-amber-700 text-xs font-medium tracking-[0.2em] uppercase mb-4 transition-colors duration-300 cursor-pointer">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3a.7.7 0 0 1 1.198-.043L16.3 8.9a.7.7 0 0 1-.572 1.1Z"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <circle cx="17.5" cy="17.5" r="3.5"/>
        </svg>
        — {eyebrow} —
      </span>
      <h2 class="text-2xl md:text-4xl font-bold text-stone-800 bg-gradient-to-r from-[#32170D] via-[#B85C27] to-[#32170D] bg-[length:200%_auto] bg-right hover:bg-left text-transparent bg-clip-text transition-all duration-700 ease-in-out cursor-pointer mb-6">
        {heading}
      </h2>
      <p class="text-base md:text-lg text-stone-600 hover:text-[#5D4E37] leading-relaxed max-w-3xl mx-auto transition-colors duration-300 cursor-pointer" set:html={highlightedSubheading}></p>
    </div>

    <!-- Materials grid -->
    <div class="flex flex-wrap justify-center gap-5 md:gap-6">
      {materials.map((m: any, i: number) => (
        <div
          class="mat-card group flex flex-col w-[calc(50%-0.625rem)] sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] xl:w-[calc(25%-1.125rem)] bg-white rounded-2xl overflow-hidden shadow-sm ring-1 ring-stone-200/70 hover:shadow-xl hover:shadow-stone-200/60 hover:ring-stone-300 transition-all duration-500 cursor-pointer motion-safe:animate-[matFadeInUp_0.5s_ease-out_both]"
          style={`animation-delay: ${0.1 + i * 0.05}s`}
        >
          <a href={`${prefix}/product/?shape=${m.slug}`} class="relative aspect-[4/3] overflow-hidden bg-stone-100 block">
            <img
              src={cardSrc(m.image)}
              alt={m.name}
              width="400"
              height="300"
              loading={i >= 4 ? 'lazy' : 'eager'}
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-900/0 to-transparent group-hover:from-stone-900/8 transition-all duration-500"></div>
          </a>

          <div class="p-5 md:p-6 flex flex-col flex-1">
            <a href={`${prefix}/product/?shape=${m.slug}`} class="block text-center">
              <h3 class="text-sm md:text-base font-bold text-stone-800 group-hover:text-amber-700 transition-colors duration-300 mb-1.5">
                {m.name}
              </h3>
            </a>
            <p class="text-xs md:text-sm text-stone-600 hover:text-[#5D4E37] leading-relaxed mb-5 text-center transition-colors duration-300 cursor-pointer">
              {m.subtitle}
            </p>
            <div class="w-10 h-px bg-stone-200 mx-auto mb-5 transition-all duration-500 group-hover:w-20 group-hover:bg-stone-400"></div>
            <ul class="space-y-2.5 flex-1">
              {m.points?.map((point: string) => (
                <li class="mat-point flex items-start gap-3 text-xs md:text-sm text-stone-600 transition-all duration-300 cursor-default">
                  <span class="mat-dot mt-1.5 w-1.5 h-1.5 rounded-full bg-stone-300 shrink-0 transition-all duration-300"></span>
                  <span class="mat-text leading-snug transition-colors duration-300">{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  @keyframes matFadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .mat-point:hover .mat-dot {
    background-color: #B45309;
    transform: scale(1.2);
    box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.18);
  }
  .mat-point:hover .mat-text {
    color: #B45309;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .mat-card,
    [class*="matFadeInUp"] {
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>
