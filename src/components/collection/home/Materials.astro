---
import { getEntry } from 'astro:content';
import { translations } from '../../../translations';
import { cardSrc } from '../../../utils/image';

const { lang = 'en' } = Astro.props as { lang?: string };
const isRTL = lang === 'ar';
const t = (translations as any)[lang] || translations.en;
const prefix = lang === 'en' ? '' : `/${lang}`;
const entry = await getEntry('collection', `home/s01-materials.${lang}`);
const heading = entry?.data?.heading || 'Eyewear Frame Materials';
const subheading = entry?.data?.subheading || '';
const highlightedSubheading = subheading.replace(/Mazzucchelli/g, '<span class="text-amber-600 font-medium">Mazzucchelli</span>');
const materials = entry?.data?.materials || [];
const badgeText = t.product?.materials || 'Frame Materials';
---

<section class="relative pt-11 pb-20 md:pt-14 md:pb-20 bg-white overflow-hidden" dir={isRTL ? 'rtl' : 'ltr'}>
  <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4 lg:px-0">
    <!-- Section header - Clean minimal style -->
    <div class="text-center mb-12 md:mb-16">
      <span class="inline-block text-stone-500 text-xs font-medium tracking-[0.2em] uppercase mb-4">
        — {badgeText} —
      </span>
      <h2 class="text-2xl md:text-4xl font-bold text-stone-800 tracking-tight mb-4">
        {heading}
      </h2>
      <p class="text-base md:text-lg text-stone-600 leading-relaxed max-w-2xl mx-auto" set:html={highlightedSubheading}>
    </div>

    <!-- Materials grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 md:gap-6">
      {materials.map((m: any, i: number) => (
        <div
          class="mat-card group flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm ring-1 ring-stone-100 hover:shadow-xl hover:shadow-stone-200/60 hover:ring-stone-200 transition-all duration-500 cursor-pointer motion-safe:animate-[matFadeInUp_0.5s_ease-out_both]"
          style={`animation-delay: ${0.1 + i * 0.05}s`}
        >
          <a href={`${prefix}/product/?material=${m.slug}`} class="relative aspect-[4/3] overflow-hidden bg-stone-100 block">
            <img
              src={cardSrc(m.image)}
              alt={m.name}
              width="400"
              height="300"
              loading={i >= 4 ? 'lazy' : 'eager'}
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-900/0 to-transparent group-hover:from-stone-900/8 transition-all duration-500"></div>
          </a>

          <div class="p-5 md:p-6 flex flex-col flex-1">
            <a href={`${prefix}/product/?material=${m.slug}`} class="block text-center">
              <h3 class="text-sm md:text-base font-bold text-stone-800 hover:text-stone-600 transition-colors duration-300 mb-1.5">
                {m.name}
              </h3>
            </a>
            <p class="text-xs md:text-sm text-stone-600 leading-relaxed mb-5 text-center">
              {m.subtitle}
            </p>
            <div class="w-10 h-px bg-stone-200 mx-auto mb-5 transition-all duration-500 group-hover:w-20 group-hover:bg-stone-400"></div>
            <ul class="space-y-2.5 flex-1">
              {m.points?.map((point: string) => (
                <li class="mat-point flex items-start gap-3 text-xs md:text-sm text-stone-600 transition-all duration-300 cursor-default">
                  <span class="mat-dot mt-1.5 w-1.5 h-1.5 rounded-full bg-stone-300 shrink-0 transition-all duration-300"></span>
                  <span class="mat-text leading-snug transition-colors duration-300">{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  @keyframes matFadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .mat-point:hover .mat-dot {
    background-color: #8B7355;
    transform: scale(1.2);
    box-shadow: 0 0 0 3px rgba(139, 115, 85, 0.12);
  }
  .mat-point:hover .mat-text {
    color: #5D4E37;
    font-weight: 500;
  }
</style>