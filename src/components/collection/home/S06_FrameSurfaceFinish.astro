---
import { getEntry } from 'astro:content';
import { getTranslations, type Translations } from '../../../translations';
import { cardSrc } from '../../../utils/image';

const { lang = 'en' } = Astro.props as { lang?: string };
const isRTL = lang === 'ar';
const t = await getTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;
const entry = await getEntry('collection', `home/s06-frame-surface-finish.${lang}`);
const eyebrow = entry?.data?.eyebrow || 'Surface Finish';
const heading = entry?.data?.heading || 'Custom Eyewear Frame Surface Finish';
const subheading = entry?.data?.subheading || '';
const materials = entry?.data?.materials || [];
---

<section class="relative pt-11 pb-20 md:pt-14 md:pb-20 bg-gray-50 border-t border-gray-300/80 overflow-hidden" dir={isRTL ? 'rtl' : 'ltr'}>
  <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4 lg:px-0">
    <!-- Section header -->
    <div class="text-center mb-12 md:mb-16">
      <span class="flex items-center justify-center gap-2 text-stone-500 hover:text-amber-700 text-xs font-medium tracking-[0.2em] uppercase mb-4 transition-colors duration-300 cursor-pointer">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/>
          <path d="M2 12l10 5 10-5"/>
        </svg>
        — {eyebrow} —
      </span>
      <h2 class="text-2xl md:text-4xl font-bold text-stone-800 bg-linear-to-r from-[#32170D] via-[#B85C27] to-[#32170D] bg-[length:200%_auto] bg-right hover:bg-left text-transparent bg-clip-text transition-all duration-700 ease-in-out cursor-pointer mb-6">
        {heading}
      </h2>
      <p class="text-base md:text-lg text-stone-600 hover:text-[#5D4E37] leading-relaxed max-w-3xl mx-auto transition-colors duration-300 cursor-pointer">
        {subheading}
      </p>
    </div>

    <!-- Grid -->
    <div class="max-w-[1440px] mx-auto bg-gray-100/60 backdrop-blur-xs rounded-2xl overflow-hidden border border-white/40 shadow-xs">
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-[1px]">
        {materials.map((m: any, i: number) => (
          <div
            class="con-cell group relative bg-white/90 backdrop-blur-md cursor-pointer transition-all duration-500 ease-out motion-safe:animate-[conCellIn_0.6s_cubic-bezier(0.22,1,0.36,1)_both] flex flex-col"
            style={`animation-delay: ${0.1 + i * 0.07}s`}
          >
            <!-- Image -->
            <a href={`${prefix}/product/?surface-finish=${m.slug}`} class="relative aspect-[4/3] overflow-hidden bg-gray-200 block">
              <img
                src={cardSrc(m.image)}
                alt={m.name}
                width="400"
                height="300"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-110 motion-safe:group-hover:brightness-105"
              />
            </a>

            <!-- Content -->
            <div class="p-5 md:p-6 bg-white/70 backdrop-blur-md flex-1 flex flex-col">
              <!-- Title -->
              <a href={`${prefix}/product/?surface-finish=${m.slug}`} class="block text-center">
                <h3 class="con-title relative text-sm md:text-base font-bold text-stone-800 group-hover:text-amber-700 transition-colors duration-300 mb-1.5 inline-block pb-2">
                  {m.name}
                  <!-- Underline -->
                  <span class="con-underline absolute bottom-0 left-1/2 w-0 h-[1px] bg-stone-700 transition-all duration-500 group-hover:w-[70%] group-hover:-translate-x-1/2"></span>
                </h3>
              </a>

              <!-- Subtitle -->
              <p class="text-xs md:text-sm text-stone-600 hover:text-[#5D4E37] leading-relaxed mb-5 text-center transition-colors duration-300 cursor-pointer">
                {m.subtitle}
              </p>

              <p class="flex-1 text-xs md:text-sm text-stone-600 leading-relaxed transition-colors duration-300 group-hover:text-amber-700">
                {m.points?.join(' · ')}
              </p>
            </div>

            <!-- Bottom accent line -->
            <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-linear-to-r from-transparent via-gray-300 to-transparent group-hover:via-stone-700 transition-all duration-500"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes conCellIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .con-cell {
    will-change: transform, box-shadow;
  }

  .con-cell:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.12);
    z-index: 10;
  }

  @media (prefers-reduced-motion: reduce) {
    .con-cell {
      animation: none;
      opacity: 1;
    }
    .con-cell:hover {
      transform: none;
    }
  }
</style>
