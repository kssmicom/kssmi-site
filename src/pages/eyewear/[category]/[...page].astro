---
import ProductCategoryPage from '../../../components/pages/ProductCategoryPage.astro';
import { getCollection } from 'astro:content';
import { isCategoryMatch, getSlug } from '../../../utils/categoryMatching';
import { cardSrc } from '../../../utils/image';
// import { getProductLang } from '../../../utils/language';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const lang = 'en';
  const allProducts = await getCollection('feature');
  if (allProducts.length === 0) return [];

  const allCategorySlugs = new Set<string>();
  for (const p of allProducts) {
    const series = p.data.series || p.data.categories || '';
    for (const cat of String(series).split(',')) {
      const slug = getSlug(cat.trim());
      if (slug) allCategorySlugs.add(slug);
    }
  }


  return [...allCategorySlugs].flatMap((category) => {
    const categoryProducts = allProducts.filter((p) => {
      if (p.data.lang !== lang) return false;
      const series = p.data.series || p.data.categories || '';
      return isCategoryMatch(series, category);
    });
    const sorted = categoryProducts.sort((a: any, b: any) => {
      if (a.data.featured && !b.data.featured) return -1;
      if (!a.data.featured && b.data.featured) return 1;
      const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
      const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
      if (dateA !== dateB) return dateB - dateA;
      return b.id.localeCompare(a.id);
    });

    return paginate(sorted, {
      params: { category },
      pageSize: 12,
      props: { categorySlug: category }
    });
  });
}

const { page, categorySlug } = Astro.props;

// Detect locale from URL path — Astro's i18n routing strips the locale prefix
// before matching, so [lang]/... URLs may land on this English route tree.
const LANGUAGES = ['it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
const urlPath = Astro.url.pathname;
let detectedLang = 'en';
for (const l of LANGUAGES) {
  if (urlPath.startsWith('/' + l + '/') || urlPath === '/' + l) {
    detectedLang = l;
    break;
  }
}
const lang = detectedLang;
const currentPath = lang === 'en' ? '' : lang + '/';

// Fetch fresh — getStaticPaths props may not preserve content entries
const allProducts = await getCollection('feature');
// (currentPath is now set above based on locale detection)

// Filter to current language
const langProducts = (allProducts || []).filter((p: any) => {
  const pLang = p.id.split('.').pop();
  return (pLang && pLang.length === 2) ? pLang === lang : lang === 'en';
});
---

<ProductCategoryPage lang={lang} currentPath={currentPath} categorySlug={categorySlug} page={page} langProducts={langProducts} allProducts={allProducts} baseSegment="eyewear">
    <Fragment slot="cards">
    {page.data.map((item: any, index: number) => {
      const img = cardSrc(item.data.image || '/media/global/placeholder.webp');
      const isLcpCandidate = index === 0;
      const slug = item.data.slug || item.id.split('/').pop()?.replace(/\.[a-z]{2}$/, '') || '';
      const href = `/${currentPath}eyewear/${slug}/`;
      return (
        <a href={href} class="group bg-white rounded-xl shadow-xs border border-stone-200/50 overflow-hidden hover:shadow-md active:shadow-md focus-visible:shadow-md focus-within:shadow-md transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-100">
            <img src={img} alt={item.data.title || ''} class="w-full h-full object-cover group-hover:scale-105 group-active:scale-105 group-focus-visible:scale-105 group-focus-within:scale-105 transition-transform duration-500" width="400" height="300" loading={isLcpCandidate ? 'eager' : 'lazy'} decoding={isLcpCandidate ? 'sync' : 'async'} fetchpriority={isLcpCandidate ? 'high' : 'auto'} />
          </div>
          <div class="p-4">
            {item.data.category && (<span class="text-[10px] font-bold text-[#8B7355] uppercase tracking-wider">{item.data.category}</span>)}
            <h3 class="text-sm font-bold text-stone-900 mt-1 line-clamp-2 group-hover:text-[#5D4E37] group-active:text-[#5D4E37] group-focus-visible:text-[#5D4E37] group-focus-within:text-[#5D4E37] transition-colors">{item.data.title}</h3>
          </div>
        </a>
      );
    })}
  </Fragment></ProductCategoryPage>
