---
/**
 * Category Page with Pagination — Flat URL (English, Root Level)
 * Catches: /product/acetate-sunglasses and /product/acetate-sunglasses/2
 */

import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { translations } from '../../../translations';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { isCategoryMatch, getSlug } from '../../../utils/categoryMatching';
import type { Page } from 'astro';
import Pagination from '../../../components/Pagination.astro';
import { getProductLang } from '../../../utils/language';
import { buildPrimaryCategories, buildSidebarTags } from '../../../utils/sidebar';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const lang = 'en';

  const allProducts = await getCollection('products');

  // Dynamically derive categories from product series fields
  const allCategorySlugs = new Set<string>();
  for (const p of allProducts) {
    const series = p.data.series || p.data.categories || '';
    for (const cat of String(series).split(',')) {
      const slug = getSlug(cat.trim());
      if (slug) allCategorySlugs.add(slug);
    }
  }

  // Ensure all sidebar-navigable category slugs exist, even if no products match exactly
  const SIDEBAR_SLUGS = [
    'sunglasses', 'acetate-sunglasses', 'metal-sunglasses', 'titanium-sunglasses', 'carbon-fiber-sunglasses', 'rimless-sunglasses',
    'optical-frames', 'acetate-optical-frames', 'metal-optical-frames', 'titanium-optical-frames', 'carbon-fiber-optical-frames', 'rimless-optical-frames',
    'fashion-acetate-sunglasses', 'fashion-metal-sunglasses', 'fashion-acetate-optical-frames', 'fashion-metal-optical-frames',
    'luxury-acetate-sunglasses', 'luxury-titanium-sunglasses', 'luxury-acetate-optical-frames', 'luxury-titanium-optical-frames',
    'fashion-eyewear', 'luxury-eyewear', 'carbon-fiber-eyewear', 'rimless-eyewear',
  ];
  for (const s of SIDEBAR_SLUGS) allCategorySlugs.add(s);

  return [...allCategorySlugs].flatMap((category) => {
    const categoryProducts = allProducts.filter((p) => {
      if (getProductLang(p) !== lang) return false;

      const series = p.data.series || p.data.categories || '';
      return isCategoryMatch(series, category);
    });

    const sorted = categoryProducts.sort((a, b) => {
      if (a.data.featured && !b.data.featured) return -1;
      if (!a.data.featured && b.data.featured) return 1;
      const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
      const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
      if (dateA !== dateB) return dateB - dateA;
      return b.id.localeCompare(a.id);
    });

    return paginate(sorted, {
      params: { category },
      pageSize: 12,
      props: { categorySlug: category }
    });
  });
}

interface Props {
  page: Page<{
    id: string;
    data: any;
  }>;
  categorySlug: string;
}

const { page, categorySlug } = Astro.props as Props;
const products = page.data;
const lang = 'en';
const t = translations.en;
const pt = t.product || {
  viewAllCollections: 'View All Collections',
  productsInCategory: 'products in this category',
};

// First product cover for LCP preload
const lcpImage = products[0]?.data?.cover || undefined;

const allProducts = await getCollection('products');
const langProducts = allProducts.filter((product) => {
  const productLang = getProductLang(product);
  return productLang === lang;
});

function getCategoryCount(href: string): number {
  const targetSlug = href.split('/').pop() || '';
  return langProducts.filter(p => {
    const cats = p.data.series || p.data.categories || '';
    return isCategoryMatch(cats, targetSlug);
  }).length;
}

const primaryCategories = buildPrimaryCategories(t, '');

const sidebarTags = buildSidebarTags(t, '');

const categoryTitle = (() => {
  for (const cat of primaryCategories) {
    if (cat.href === `/product/${categorySlug}`) return cat.label;
    for (const sub of cat.items) {
      if (sub.href === `/product/${categorySlug}`) return sub.label;
    }
  }
  for (const group of sidebarTags) {
    if (group.href === `/product/${categorySlug}`) return group.label;
    for (const item of group.items) {
      if (item.href === `/product/${categorySlug}`) return item.label;
    }
  }
  return categorySlug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
})();

// Build breadcrumb for category listing page
const categoryBreadcrumbItems = (() => {
  const items: Array<{ label: string; href: string }> = [
    { label: t.nav.home, href: '/' },
    { label: t.nav.products || 'Products', href: '/product' },
  ];
  // Check if this slug is a subcategory under a primary category
  for (const cat of primaryCategories) {
    if (cat.href === `/product/${categorySlug}`) {
      // It's a top-level category — just add it
      items.push({ label: cat.label, href: `#` });
      return items;
    }
    for (const sub of cat.items) {
      if (sub.href === `/product/${categorySlug}`) {
        // It's a subcategory — add parent then sub
        items.push({ label: cat.label, href: cat.href });
        items.push({ label: sub.label, href: '#' });
        return items;
      }
    }
  }
  // Check tag groups
  for (const group of sidebarTags) {
    if (group.href === `/product/${categorySlug}`) {
      items.push({ label: group.label, href: '#' });
      return items;
    }
    for (const item of group.items) {
      if (item.href === `/product/${categorySlug}`) {
        items.push({ label: group.label, href: group.href });
        items.push({ label: item.label, href: '#' });
        return items;
      }
    }
  }
  // Fallback: just add the title
  items.push({ label: categoryTitle, href: '#' });
  return items;
})();

function isActiveCategory(href: string): boolean {
  const pathWithoutQuery = href.split('?')[0];
  const hrefSlug = pathWithoutQuery.replace('/product/', '');
  return hrefSlug === categorySlug;
}
---

<Layout title={`${categoryTitle} - ${t.nav.products}`} lang={lang} lcpImage={lcpImage}>
  <Header lang={lang} />
  <Breadcrumb items={categoryBreadcrumbItems} lang={lang} />

  <main class="w-full min-h-screen py-6 lg:py-8 bg-stone-50">
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar -->
        <aside class="hidden lg:block lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="bg-gradient-to-br from-white to-[#faf8f5] rounded-xl shadow-sm p-6 border border-stone-200/50">
              <!-- All Products Link -->
              <a href="/product" class="flex items-center justify-between py-1.5 px-2 text-sm lg:text-base font-bold text-[#5D4E37] hover:bg-stone-50 rounded-lg transition-colors mb-3">
                <span>{t.sidebar.all_products}</span>
                <span class="text-xs text-gray-500">{langProducts.length}</span>
              </a>

              <div class="space-y-3">
                {primaryCategories.map((cat) => (
                  <div class="border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                    <a
                      href={cat.href}
                      class={`flex items-center justify-between py-2 px-2 text-sm font-bold rounded-lg transition-colors ${
                        isActiveCategory(cat.href)
                          ? 'bg-[#5D4E37] text-white'
                          : 'text-[#5D4E37] hover:bg-stone-50'
                      }`}
                    >
                      <span>{cat.label}</span>
                      <span class={`text-xs ${
                        isActiveCategory(cat.href) ? 'text-white/70' : 'text-gray-500'
                      }`}>{getCategoryCount(cat.href)}</span>
                    </a>
                    <ul class="ms-3 mt-1 space-y-1">
                      {cat.items.map((sub) => (
                        <li>
                          <a
                            href={sub.href}
                            class={`flex items-center justify-between py-1.5 px-2 text-sm rounded transition-colors ${
                              isActiveCategory(sub.href)
                                ? 'bg-[#5D4E37] text-white'
                                : 'text-gray-600 hover:text-[#5D4E37] hover:bg-stone-50'
                            }`}
                          >
                            <span>{sub.label}</span>
                            <span class={`text-xs ${
                              isActiveCategory(sub.href) ? 'text-white/90' : 'text-gray-500'
                            }`}>{getCategoryCount(sub.href)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <div class="mt-8 pt-6 border-t border-gray-100">
                <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-4">{t.sidebar.tags_filters}</h4>
                <div class="space-y-6">
                  {sidebarTags.map((group) => (
                    <div>
                      <a href={group.href} class="text-sm font-bold text-gray-900 mb-2.5 flex items-center hover:text-[#5D4E37] transition-colors">
                        <span class="text-[#5D4E37] mr-1">#</span> {group.label}
                      </a>
                      <div class="flex flex-col gap-1.5">
                        {group.items.map((tag) => {
                          const isActive = isActiveCategory(tag.href);
                          return (
                            <a
                              href={tag.href}
                              class={`px-3 py-1.5 text-[11px] font-bold rounded-md border transition-all duration-200 w-full ${
                                isActive
                                  ? 'bg-[#5D4E37] text-white border-[#8B7355] shadow-md'
                                  : 'bg-white text-stone-600 border-stone-200 hover:border-[#8B7355] hover:text-[#5D4E37] hover:bg-stone-50'
                              }`}
                            >
                              {tag.label}
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="bg-[#5D4E37] rounded-xl p-6 text-white">
              <h4 class="font-bold mb-2">{pt.needCustomEyewear || 'Need Custom Eyewear?'}</h4>
              <p class="text-sm text-white mb-4">
                {pt.oemServices || 'We offer full OEM & ODM services for your brand.'}
              </p>
              <a
                href="/quote"
                class="inline-block bg-white text-[#5D4E37] px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-lg"
              >
                {t.cta.quote || 'Get Quote'}
              </a>
            </div>
          </div>
        </aside>

        <!-- Product Grid -->
        <div class="col-span-1 lg:col-span-3">
          <h1 class="text-base lg:text-lg font-bold text-stone-900 mb-6">{categoryTitle}</h1>
          {page.total === 0 ? (
            <div class="text-center py-16 bg-white rounded-xl shadow-sm">
              <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
              <p class="text-gray-500 mb-4">{pt.noProducts || 'No products in this category.'}</p>
              <a href="/product" class="text-[#5D4E37] hover:underline">View All Products</a>
            </div>
          ) : (
            <>
              <!-- Results Info -->
              <div class="flex justify-between items-center mb-6 text-sm text-gray-500">
                <span>
                  {(pt.showingResults || 'Showing {start}-{end} of {total} products')
                    .replace('{start}', String(page.start + 1))
                    .replace('{end}', String(Math.min(page.end, page.total)))
                    .replace('{total}', String(page.total))}
                </span>
              </div>

              <div class="grid grid-cols-2 xl:grid-cols-3 gap-x-4 gap-y-6 xl:gap-x-6 xl:gap-y-10">
                {products.map((product: any, index: number) => (
                  <ProductCard product={product} lang={lang} index={index} />
                ))}
              </div>

              <Pagination
                currentPage={page.currentPage}
                lastPage={page.lastPage}
                basePath="/product"
                categorySlug={categorySlug}
                prevUrl={page.url.prev}
                nextUrl={page.url.next}
                prevLabel={pt.previousPage || 'Previous'}
                nextLabel={pt.nextPage || 'Next'}
              />
            </>
          )}
        </div>
      </div>

      <!-- Back to All -->
      <div class="mt-12 text-center">
        <a
          href="/product"
          class="inline-flex items-center gap-2 text-[#5D4E37] hover:text-[#5D4E37] font-medium transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          {pt.viewAllCollections}
        </a>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
