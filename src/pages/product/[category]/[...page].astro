---
import ProductCard from '../../../components/ProductCard.astro';
import ProductCategoryPage from '../../../components/pages/ProductCategoryPage.astro';
import { getCollection } from 'astro:content';
import { translations, getTranslations, type Translations } from '../../../translations';
import { isCategoryMatch, getSlug } from '../../../utils/categoryMatching';
import { getProductLang } from '../../../utils/language';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const lang = 'en';
  const allProducts = await getCollection('products');

  const allCategorySlugs = new Set<string>();
  for (const p of allProducts) {
    const series = p.data.series || p.data.categories || '';
    for (const cat of String(series).split(',')) {
      const slug = getSlug(cat.trim());
      if (slug) allCategorySlugs.add(slug);
    }
  }

  const SIDEBAR_SLUGS = [
    'sunglasses', 'acetate-sunglasses', 'metal-sunglasses', 'titanium-sunglasses', 'carbon-fiber-sunglasses', 'rimless-sunglasses',
    'optical-frames', 'acetate-optical-frames', 'metal-optical-frames', 'titanium-optical-frames', 'carbon-fiber-optical-frames', 'rimless-optical-frames',
    'fashion-acetate-sunglasses', 'fashion-metal-sunglasses', 'fashion-acetate-optical-frames', 'fashion-metal-optical-frames',
    'luxury-acetate-sunglasses', 'luxury-titanium-sunglasses', 'luxury-acetate-optical-frames', 'luxury-titanium-optical-frames',
    'fashion-eyewear', 'luxury-eyewear', 'carbon-fiber-eyewear', 'rimless-eyewear',
  ];
  for (const s of SIDEBAR_SLUGS) allCategorySlugs.add(s);

  return [...allCategorySlugs].flatMap((category) => {
    const categoryProducts = allProducts.filter((p) => {
      if (getProductLang(p) !== lang) return false;
      const series = p.data.series || p.data.categories || '';
      return isCategoryMatch(series, category);
    });

    const sorted = categoryProducts.sort((a: any, b: any) => {
      if (a.data.featured && !b.data.featured) return -1;
      if (!a.data.featured && b.data.featured) return 1;
      const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
      const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
      if (dateA !== dateB) return dateB - dateA;
      return b.id.localeCompare(a.id);
    });

    return paginate(sorted, {
      params: { category },
      pageSize: 12,
      props: { categorySlug: category }
    });
  });
}

const { page, categorySlug } = Astro.props;

// Detect locale from URL path — Astro's i18n routing strips the locale prefix
// before matching, so [lang]/product/[category] URLs may land on this English
// route tree.  Read the locale from the URL so the correct translations and
// sidebar links (with locale prefix) are used.
// Detect locale — Astro.url.pathname may have the locale prefix stripped by i18n
// routing.  Try Astro.currentLocale first (set by i18n config), then fall back to
// URL path inspection.
const LANGUAGES = ['it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
let detectedLang = (Astro as any).currentLocale || 'en';
if (!detectedLang || detectedLang === 'en') {
  const urlPath = Astro.url.pathname;
  for (const l of LANGUAGES) {
    if (urlPath.startsWith('/' + l + '/') || urlPath === '/' + l) {
      detectedLang = l;
      break;
    }
  }
}
const lang = detectedLang || 'en';
const currentPath = lang === 'en' ? '' : lang + '/';

// Fetch fresh — getStaticPaths props may not preserve content entries
const allProducts = await getCollection('products');

// Filter to current language
const langProducts = (allProducts || []).filter((p: any) => {
  const pLang = p.id.split('.').pop();
  return (pLang && pLang.length === 2) ? pLang === lang : lang === 'en';
});
---

<ProductCategoryPage { lang, currentPath, categorySlug, page } langProducts={langProducts} allProducts={allProducts} baseSegment="product" >
  <Fragment slot="cards">
    {page.data.map((product: any, index: number) => (
      <ProductCard product={product} lang={lang} index={index} />
    ))}
  </Fragment>
</ProductCategoryPage>