---
/**
 * Product Detail Page & Category Page (English - Root Level)
 * Handles both product detail pages (/product/kss-011-...) and category pages (/product/carbon-fiber-sunglasses)
 */

import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { getTranslations, type Translations } from '../../translations';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TechnicalSpecs from '../../components/TechnicalSpecs.astro';
import InquiryFormLazy from '../../components/InquiryFormLazy.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import SamplePricing from '../../components/SamplePricing.astro';
import OrderProductionSection from '../../components/OrderProductionSection.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import PartnerBrandSection from '../../components/PartnerBrandSection.astro';
import { samplePricing } from '../../config/samplePricing';
import { isCategoryMatch } from '../../utils/categoryMatching';
import { getProductLang } from '../../utils/language';
import { cardSrc } from '../../utils/image';
import { buildPrimaryCategories, buildSidebarTags } from '../../utils/sidebar';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const lang = 'en';


  // Get all product slugs
  const productSlugs = new Set(
    products
      .filter(product => getProductLang(product) === lang)
      .map((product: any) => (product.data.slug || '').toLowerCase())
  );

  const paths: any[] = [];

  // Add product detail pages
  products
    .filter(product => getProductLang(product) === lang)
    .forEach((product: any) => {
      const slug = (product.data.slug || '').toLowerCase();
      if (slug) {
        paths.push({ params: { slug }, props: { product, type: 'product', categorySlug: null } });
      }
    });



  return paths;
}

const { product, type } = Astro.props;
const { lang: langParam } = Astro.params;
let lang = langParam || 'en';
// Detect locale from URL — Astro may route prefixed URLs to English route tree
const LANGUAGES = ['it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
const urlPath = Astro.url.pathname;
for (const l of LANGUAGES) {
  if (urlPath.startsWith('/' + l + '/') || urlPath === '/' + l) {
    lang = l;
    break;
  }
}
const currentPath = lang === 'en' ? '' : lang + '/';

const t = await getTranslations(lang);
const pt = t.product || {};



if (!product) {
  return Astro.redirect('/404');
}



// ============ SIDEBAR DATA ============
const allProductsForCount = await getCollection('products');
const langProductsForCount = allProductsForCount.filter((p: any) => getProductLang(p) === lang);

const primaryCategories = buildPrimaryCategories(t, '');

const sidebarTags = buildSidebarTags(t, '');

function getCategoryCount(href: string): number {
  const pathWithoutQuery = href.split('?')[0];
  const targetSlug = pathWithoutQuery.split('/').pop() || '';
  return langProductsForCount.filter((p: any) => {
    const cats = p.data.series || '';
    return isCategoryMatch(cats, targetSlug);
  }).length;
}

// ============ PRODUCT PAGE DATA ============
let cover = '';
let gallery: string[] = [];
let title = '';
let productDisplayName = '';
let materials = '';
let moq = '';
let categories = '';
let itemNo = '';
let colors = '';
let serviceMode = '';
let customizable = false;
let seoTitle = '';
let seoDescription = '';
let seoKeywords = '';
let size = '';
let frameMaterial = '';
let lensMaterial = '';
let designStyle = '';
let nosePads = '';
let hinge = '';
let logo = '';
let carbonFiberFeature = '';
let cats: string[] = [];
let ProductContent: any = null;
let breadcrumbItems: any[] = [];
let productSchema: any = null;
let categorySchema: any = null;
let imageSlug = '';



if (type === 'product' && product) {
  const data = product.data as any;
  title = data.title || '';
  materials = data.materials || '';
  moq = data.moq || '';
  categories = data.categories || data.series || '';
  itemNo = data.itemNo || '';
  productDisplayName = itemNo && !title.toUpperCase().includes(itemNo.toUpperCase())
    ? `${itemNo} ${title}`.trim()
    : title;
  colors = data.colors || '';
  serviceMode = data.serviceMode || '';
  customizable = data.customizable || false;
  seoTitle = data.seoTitle || '';
  seoDescription = data.seoDescription || '';
  seoKeywords = data.seoKeywords || '';
  size = data.size || '';
  frameMaterial = data.frameMaterial || '';
  lensMaterial = data.lensMaterial || '';
  designStyle = data.designStyle || '';
  nosePads = data.nosePads || '';
  hinge = data.hinge || '';
  logo = data.logo || '';
  carbonFiberFeature = data.carbonFiberFeature || '';

  imageSlug = (data.slug || '').replace(/\/$/, '') || 'product';
  const publicDir = path.join(process.cwd(), 'public', 'media', 'products', imageSlug);

  if (fs.existsSync(publicDir)) {
    const allFiles = fs.readdirSync(publicDir)
      .filter((file: string) => (file.endsWith('.webp') || file.endsWith('.jpg') || file.endsWith('.png')) && !file.includes('-400') && !file.includes('-120w'))
      .sort((a: string, b: string) => {
        const numA = parseInt(a.match(/-(\d+)\.\w+$/)?.[1] || '0', 10);
        const numB = parseInt(b.match(/-(\d+)\.\w+$/)?.[1] || '0', 10);
        return numA - numB;
      });

    const allImagePaths = allFiles.map((file: string) => `/media/products/${imageSlug}/${file}`);

    if (allImagePaths.length > 0) {
      cover = allImagePaths[0];
      gallery = allImagePaths.slice(1);
    }
  } else {
    cover = data.cover || '';
    gallery = data.gallery || [];
  }

  const rendered = await render(product);
  ProductContent = rendered.Content;

  // Map from URL slug -> { translationKey, parentSlug }
  // parentSlug = the top-level category slug for hierarchical breadcrumb
  const slugBreadcrumbMap: Record<string, { key: string; parentSlug?: string }> = {
    'sunglasses':                    { key: 'sunglasses' },
    'optical-frames':                { key: 'optical_frames' },
    'acetate-sunglasses':            { key: 'acetate_sunglasses',      parentSlug: 'sunglasses' },
    'metal-sunglasses':              { key: 'metal_sunglasses',        parentSlug: 'sunglasses' },
    'titanium-sunglasses':           { key: 'titanium_sunglasses',     parentSlug: 'sunglasses' },
    'carbon-fiber-sunglasses':       { key: 'carbon_fiber_sunglasses', parentSlug: 'sunglasses' },
    'rimless-sunglasses':            { key: 'rimless_sunglasses',      parentSlug: 'sunglasses' },
    'acetate-optical-frames':        { key: 'acetate_glasses',         parentSlug: 'optical-frames' },
    'acetate-glasses':               { key: 'acetate_glasses',         parentSlug: 'optical-frames' },
    'metal-optical-frames':          { key: 'metal_glasses',           parentSlug: 'optical-frames' },
    'metal-glasses':                 { key: 'metal_glasses',           parentSlug: 'optical-frames' },
    'titanium-optical-frames':       { key: 'titanium_glasses',        parentSlug: 'optical-frames' },
    'titanium-glasses':              { key: 'titanium_glasses',        parentSlug: 'optical-frames' },
    'carbon-fiber-optical-frames':   { key: 'carbon_glasses',          parentSlug: 'optical-frames' },
    'carbon-optical-frames':         { key: 'carbon_glasses',          parentSlug: 'optical-frames' },
    'rimless-optical-frames':        { key: 'rimless_glasses',         parentSlug: 'optical-frames' },
    'rimless-glasses':               { key: 'rimless_glasses',         parentSlug: 'optical-frames' },
  };

  // Priority order: subcategories (with parentSlug) first, then top-level
  // Get series slugs from data.series OR data.categories
  const seriesValue = data.series || data.categories || '';
  const seriesSlugs = seriesValue.split(',').map((s: string) => s.trim().toLowerCase()).filter(Boolean);

  // Build breadcrumb: find subcategory (has parentSlug) and resolve hierarchy
  let parentEntry: { slug: string; key: string } | null = null;
  let subEntry: { slug: string; key: string } | null = null;

  for (const slug of seriesSlugs) {
    const entry = slugBreadcrumbMap[slug];
    if (!entry) continue;
    if (entry.parentSlug && !subEntry) {
      // It's a subcategory — use it and resolve parent
      subEntry = { slug, key: entry.key };
      if (!parentEntry) {
        const parentMapEntry = slugBreadcrumbMap[entry.parentSlug];
        if (parentMapEntry) {
          parentEntry = { slug: entry.parentSlug, key: parentMapEntry.key };
        }
      }
    } else if (!entry.parentSlug && !parentEntry) {
      // Top-level only (no parent), will be used if no subcategory found
      parentEntry = { slug, key: entry.key };
    }
  }

  // Build breadcrumb items
  breadcrumbItems = [
    { label: t.nav.home, href: '/' },
    { label: t.nav.products || 'Products', href: '/product' },
  ];
  if (parentEntry) {
    breadcrumbItems.push({
      label: (t.sidebar as any)[parentEntry.key] || parentEntry.slug,
      href: `/product/${parentEntry.slug}`
    });
  }
  if (subEntry) {
    breadcrumbItems.push({
      label: (t.sidebar as any)[subEntry.key] || subEntry.slug,
      href: `/product/${subEntry.slug}`
    });
  }
  breadcrumbItems.push({ label: productDisplayName, href: '#' });

  // Keep cats for schema use (from categories or series)
  cats = seriesSlugs;

  // Generate schema specs
  const schemaSpecs: any[] = [];
  if (itemNo) schemaSpecs.push({ "@type": "PropertyValue", "name": pt.itemNo || "Item Number", "value": itemNo });
  if (moq) schemaSpecs.push({ "@type": "PropertyValue", "name": pt.moq || "MOQ", "value": moq });
  if (serviceMode) schemaSpecs.push({ "@type": "PropertyValue", "name": pt.service || "Service Mode", "value": serviceMode });
  if (customizable) schemaSpecs.push({ "@type": "PropertyValue", "name": pt.customizable || "Customizable", "value": "Yes" });

  function formatSchemaKey(key: string): string {
    const camelKey = key.replace(/(?:^\w|[A-Z]|\b\w)/g, (w: string, i: number) => i === 0 ? w.toLowerCase() : w.toUpperCase()).replace(/\s+/g, '');
    if ((pt as any)[camelKey]) return (pt as any)[camelKey];
    if ((pt as any)[key]) return (pt as any)[key];
    if (/^[a-z]+[A-Z][a-zA-Z]*$/.test(key)) {
      return key.replace(/([A-Z])/g, ' $1').split(' ').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
    }
    return key;
  }

  const schemaSpecKeys = [
    'size',
    'frameMaterial',
    'lensMaterial',
    'designStyle',
    'nosePads',
    'hinge',
    'electroplating',
    'logo',
    'carbonFiberFeature'
  ];

  for (const key of schemaSpecKeys) {
    const value = data[key];
    const v = Array.isArray(value) ? value.join(', ') : value;
    if (v === undefined || v === null || v === '') continue;
    schemaSpecs.push({ "@type": "PropertyValue", "name": formatSchemaKey(key), "value": String(v) });
  }

  const siteUrl = new URL('/', Astro.site ?? 'https://kssmi.com').href.replace(/\/$/, '');
  const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://kssmi.com').href;
  const productImages = [cover, ...gallery]
    .filter(Boolean)
    .map(img => img.startsWith('http') ? img : `https://kssmi.com${img}`);

  productSchema = {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${canonicalUrl}#product`,
    "url": canonicalUrl,
    "name": productDisplayName,
    "image": productImages.length > 0 ? productImages : undefined,
    "description": seoDescription || productDisplayName,
    "sku": itemNo || undefined,
    "mpn": itemNo || undefined,
    "brand": {
      "@type": "Brand",
      "@id": `${siteUrl}/#brand`,
      "name": "Kssmi Eyewear"
    },
    "manufacturer": {
      "@id": `${siteUrl}/#organization`
    },
    "offers": {
      "@type": "Offer",
      "@id": `${canonicalUrl}#ready-stock-sample-offer`,
      "url": canonicalUrl,
      "name": pt.samplePricing.readyStock,
      "price": samplePricing.readyStock,
      "priceCurrency": samplePricing.currency,
      "itemCondition": "https://schema.org/NewCondition",
      "description": pt.samplePricing.readyStockDescription,
      "seller": {
        "@id": `${siteUrl}/#organization`
      }
    },
    "material": materials || undefined,
    "color": colors || undefined,
    "category": cats.length > 0 ? cats[0] : undefined,
    "additionalProperty": schemaSpecs.length > 0 ? schemaSpecs : undefined
  };

}

---


<Layout
  title={seoTitle || productDisplayName}
  description={seoDescription}
  keywords={seoKeywords}
  lang={lang}
  image={cover}
  lcpImage={cover}
  type="product"
>
  {productSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}

  <div class="sr-only" data-pagefind-meta="title">{productDisplayName}</div>
  {itemNo && <div class="sr-only" data-pagefind-meta="itemNo">{itemNo}</div>}
  {itemNo && <div class="sr-only" data-pagefind-weight="10">{itemNo}</div>}
  {materials && <div class="sr-only" data-pagefind-meta="materials">{materials}</div>}
  {colors && <div class="sr-only" data-pagefind-meta="colors">{colors}</div>}
  {categories && <div class="sr-only" data-pagefind-meta="category">{categories}</div>}
  {cover && <meta data-pagefind-meta="image[content]" content={cover} />}

  <Header lang={lang} />

  <main data-pagefind-body="true">
    <div id="pagefind-content" class="contents">
    <Breadcrumb items={breadcrumbItems} lang={lang} />

    <section class="py-6 lg:py-10 bg-stone-50">
      <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

          <ProductGallery
            cover={cover}
            gallery={gallery}
            productName={productDisplayName}
            lang={lang}
            customizable={customizable}
            customizableLabel={pt.customizableBadge || pt.customizable || 'Customizable'}
          />

          <div class="lg:py-4">
            {categories && (
              <p class="text-sm text-[#5D4E37] font-medium mb-2 hover:text-[#5D4E37] active:text-[#5D4E37] focus-visible:text-[#5D4E37] focus-within:text-[#5D4E37] transition-colors duration-200">- {pt.kssmiCollection}</p>
            )}
            <h1 class="text-lg lg:text-xl font-bold mb-6 text-gray-900">{productDisplayName}</h1>
            <p class="text-sm font-medium text-gray-900 mb-6">
              {pt.customizationPositioning}
            </p>

            <div class="border-y border-gray-200 py-6 mb-6 space-y-3">
              {itemNo && (
                <div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
                  <span class="w-[42%] min-w-0 shrink-0 break-words text-sm text-gray-500 sm:w-auto sm:min-w-[160px]">{pt.itemNo}:</span>
                  <span class="min-w-0 break-words text-sm font-medium text-gray-900">{itemNo}</span>
                </div>
              )}
              {colors && (
                <div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
                  <span class="w-[42%] min-w-0 shrink-0 break-words text-sm text-gray-500 sm:w-auto sm:min-w-[160px]">{pt.color}:</span>
                  <span class="min-w-0 break-words text-sm font-medium text-gray-900">{colors}</span>
                </div>
              )}
              {materials && (
                <div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
                  <span class="w-[42%] min-w-0 shrink-0 break-words text-sm text-gray-500 sm:w-auto sm:min-w-[160px]">{pt.materials}:</span>
                  <span class="min-w-0 break-words text-sm font-medium text-gray-900">{materials}</span>
                </div>
              )}
              <div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
                <span class="w-[42%] min-w-0 shrink-0 break-words text-sm text-gray-500 sm:w-auto sm:min-w-[160px]">{pt.serviceMode}:</span>
                <span class="min-w-0 break-words text-sm font-medium text-gray-900">{serviceMode || 'OEM / ODM'}</span>
              </div>
              <div class="flex items-start gap-2 hover:bg-stone-100 active:bg-stone-100 focus-visible:bg-stone-100 focus-within:bg-stone-100 -mx-3 px-3 py-1 rounded-sm transition-colors cursor-default">
                <span class="w-[42%] min-w-0 shrink-0 break-words text-sm text-gray-500 sm:w-auto sm:min-w-[160px]">{pt.moq}:</span>
                <span class="min-w-0 break-words text-sm font-medium text-gray-900">{moq || '100 PCS/Model'}</span>
              </div>
              <SamplePricing lang={lang} />
            </div>

            <div class="flex flex-wrap gap-4 mb-8">
              <a href="#inquiry-form-lazy" class="flex-1 min-w-[200px] bg-[#5D4E37] text-white px-6 py-4 rounded-lg font-semibold hover:bg-[#4A3D2E] focus-visible:bg-[#4A3D2E] focus-within:bg-[#4A3D2E] active:bg-[#4a4030] transition-colors duration-200 text-center flex items-center justify-center gap-2">
                {pt.customizeModel || 'Customize for Your Brand'}
              </a>
              <a href={`/${currentPath}product`} class="flex-1 min-w-[200px] border-2 border-[#8B7355] text-[#5D4E37] px-6 py-4 rounded-lg font-semibold hover:bg-[#4A3D2E] active:bg-[#4A3D2E] focus-visible:bg-[#4A3D2E] focus-within:bg-[#4A3D2E] hover:text-white active:text-white focus-visible:text-white focus-within:text-white transition-colors duration-200 text-center flex items-center justify-center gap-2">
                {pt.browseReferenceModels || pt.backToCatalog}
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-gray-900">
              <p class="border-s border-gray-300 ps-3"><span class="font-medium">{pt.referenceModelStart} </span>{pt.referenceModelStartDetail}</p>
              <p class="border-s border-gray-300 ps-3"><span class="font-medium">{pt.ownDesignStart} </span>{pt.ownDesignStartDetail}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <TechnicalSpecs product={product} lang={lang}>
      {ProductContent && <ProductContent slot="highlights" />}
    </TechnicalSpecs>

    <PartnerBrandSection lang={lang} />

    <OrderProductionSection lang={lang} itemNo={itemNo} />

    <InquiryFormLazy
      lang={lang}
      productName={productDisplayName}
      productSku={itemNo}
      productUrl={Astro.url.pathname}
      source="product_page"
    />

    <RelatedProducts currentProductId={product.id} lang={lang} limit={4} />
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
