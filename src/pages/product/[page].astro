---
import ProductCard from '../../components/ProductCard.astro';
import ProductListingPage from '../../components/pages/ProductListingPage.astro';
import { getCollection } from 'astro:content';
import { getProductLang } from '../../utils/language';
import { cardSrc } from '../../utils/image';
import { getTranslations } from '../../translations';

let lang = 'en';
// Detect locale from URL — Astro may route prefixed URLs to English route tree
const LANGUAGES = ['it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
const urlPath = Astro.url.pathname;
for (const l of LANGUAGES) {
  if (urlPath.startsWith('/' + l + '/') || urlPath === '/' + l) {
    lang = l;
    break;
  }
}
const currentPath = lang === 'en' ? '' : lang + '/';

const PAGE_SIZE = 12;

const allProducts = await getCollection('products');
const langProducts = allProducts.filter((p: any) => getProductLang(p) === lang);

const sortedProducts = langProducts.sort((a: any, b: any) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  if (dateA !== dateB) return dateB - dateA;
  return b.id.localeCompare(a.id);
});

const totalPages = Math.ceil(sortedProducts.length / PAGE_SIZE);

export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const lang = 'en';
  const all = await getCollection('products');
  const en = all.filter((p: any) => getProductLang(p) === 'en');
  const sorted = en.sort((a: any, b: any) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    if (dateA !== dateB) return dateB - dateA;
    return b.id.localeCompare(a.id);
  });
  const total = Math.ceil(sorted.length / PAGE_SIZE);
  return Array.from({ length: total }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const pageNum = parseInt(page, 10);

if (pageNum < 2 || pageNum > totalPages) {
  return Astro.redirect('/product');
}

const start = (pageNum - 1) * PAGE_SIZE;
const products = sortedProducts.slice(start, start + PAGE_SIZE);

const t = await getTranslations(lang);
const lcpImage = products[0]?.data?.cover ? cardSrc(products[0].data.cover) : undefined;

const breadcrumbItems = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.products || 'Products', href: '/product' },
];
---

<ProductListingPage
  lang={lang}
  currentPath={currentPath}
  baseSegment="product"
  products={products}
  allProducts={sortedProducts}
  currentPage={pageNum}
  totalPages={totalPages}
  basePath="/product"
  breadcrumbItems={breadcrumbItems}
  title={t.nav.products}
  lcpImage={lcpImage}
>
  <Fragment slot="cards">
    {products.map((product: any, index: number) => (
      <ProductCard product={product} lang={lang} index={index} />
    ))}
  </Fragment>
</ProductListingPage>