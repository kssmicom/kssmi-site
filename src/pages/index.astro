---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { translations } from '../translations';
import { cardSrc } from '../utils/image';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Materials from '../components/collection/home/Materials.astro';
import Construction from '../components/collection/home/Construction.astro';

const lang = 'en';
const t = translations[lang] || translations.en;

// Get content entry
const entry = await getEntry('collection', 'home/home.en');

const title = entry?.data?.seoTitle || "Kssmi - Premium Eyewear & Sunglasses Manufacturer";
const description = entry?.data?.seoDescription || "Since 2003, Kssmi has been a leading ODM & OEM eyewear manufacturer in Shenzhen, China.";

// LCP preload: first material image from the materials section (use -400 variant)
const s01entry = await getEntry('collection', 'home/s01-materials.en');
const lcpImage = s01entry?.data?.materials?.[0]?.image ? cardSrc(s01entry.data.materials[0].image) : undefined;
---

<Layout title={title} description={description} lang={lang} image={"/media/global/404-team.webp"} lcpImage={lcpImage}>
  <Header lang={lang} />

  <main>
    <Materials lang="en" />
    <Construction lang="en" />
  </main>

  <Footer lang={lang} />
</Layout>
