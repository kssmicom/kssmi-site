---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { translations } from '../translations';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import S00_Hero from '../components/collection/home/S00_Hero.astro';
import Materials from '../components/collection/home/Materials.astro';
import Construction from '../components/collection/home/Construction.astro';
import S03_FrameShape from '../components/collection/home/S03_FrameShape.astro';
import S04_FrameStyle from '../components/collection/home/S04_FrameStyle.astro';

const lang = 'en';
const t = translations[lang] || translations.en;

// Get content entry
const entry = await getEntry('collection', 'home/home.en');

const title = entry?.data?.seoTitle || "Kssmi - Premium Eyewear & Sunglasses Manufacturer";
const description = entry?.data?.seoDescription || "Since 2003, Kssmi has been a leading ODM & OEM eyewear manufacturer in Shenzhen, China.";

// LCP preload: the hero (S00) is now the first paint — preload its full-bleed poster.
const heroEntry = await getEntry('collection', 'home/s00-hero.en');
const lcpImage = heroEntry?.data?.posterImage;
---

<Layout title={title} description={description} lang={lang} image={"/media/global/404-team.webp"} lcpImage={lcpImage} preconnectVideo={true}>
  <Header lang={lang} />

  <main>
    <S00_Hero lang="en" />
    <Materials lang="en" />
    <Construction lang="en" />
    <S03_FrameShape lang="en" />
    <S04_FrameStyle lang="en" />
  </main>

  <Footer lang={lang} />
</Layout>
