---
import { getCollection, render } from 'astro:content';
import { cardSrc } from '../utils/image';
import Layout from '../layouts/Layout.astro';
import { getTranslations, type Translations } from '../translations';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteBenefits from '../components/sections/QuoteBenefits.astro';
import InquiryFormLazy from '../components/InquiryFormLazy.astro';

export async function getStaticPaths() {
  const collectionEntries = await getCollection('collection');

  return collectionEntries
    .filter(entry => {
      const lang = entry.data.lang;
      const slug = entry.data.slug;
      const fileType = entry.data.fileType;

      // Must be English language
      if (lang !== 'en') return false;

      // Must have a valid slug (not undefined, not empty)
      if (!slug || typeof slug !== 'string' || slug.trim() === '') return false;

      // Skip meta/top/bottom files
      if (['meta', 'top', 'bottom'].includes(fileType || '')) return false;

      // Skip pages with dedicated routes. In particular, "home" belongs at /
      // and must not also create a duplicate /home/ document.
      if (slug === 'about-us' || slug === 'contact' || slug === 'home') return false;

      return true;
    })
    .map(entry => {
      const slug = entry.data.slug as string;
      return {
        params: { slug },
        props: { entry },
      };
    });
}

const { entry } = Astro.props;
const { data } = entry;
const { title, layout, cta, ctaLink, image, showQuoteBenefits, showInquiryForm } = data;
let lang = 'en';
// Detect locale from URL — Astro may route prefixed URLs to English route tree
const LANGUAGES = ['it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
const urlPath = Astro.url.pathname;
for (const l of LANGUAGES) {
  if (urlPath.startsWith('/' + l + '/') || urlPath === '/' + l) {
    lang = l;
    break;
  }
}
const currentPath = lang === 'en' ? '' : lang + '/';
const t = await getTranslations(lang);
const { Content } = await render(entry);

// Check if there is actual markdown body content
const hasContent = entry.body && entry.body.trim().length > 0;
---

<Layout title={title} lang={lang} image={image} lcpImage={image ? cardSrc(image) : undefined}>
  <Header lang={lang} />

  <main class="w-full min-h-screen">
    {/* 1st SECTION: Quote Benefits (Optional) */}
    {showQuoteBenefits && <QuoteBenefits lang={lang} />}

    {/* 3rd SECTION: Main Content Area (Only if hasContent or specific criteria) */}
    {hasContent && (
      layout === 'full-width' ? (
        <section class={`w-full py-16 lg:py-24 bg-white ${(showQuoteBenefits) ? 'border-t border-stone-100' : ''}`}>
          {!showQuoteBenefits && image && (
            <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto mb-16 rounded-3xl overflow-hidden aspect-[21/9]">
              <img src={image} alt={title} class="w-full h-full object-cover" width="1260" height="540" loading="eager" decoding="async" fetchpriority="high" />
            </div>
          )}

          <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
            <div class="w-full">
              {!showQuoteBenefits && (
                  <h1 class="text-4xl md:text-6xl font-bold text-stone-900 mb-12 tracking-tight">
                      {title}
                  </h1>
              )}

              <div class="prose prose-lg max-w-none text-stone-900 prose-headings:text-stone-900 prose-p:text-stone-700">
                 <Content />
              </div>

              {cta && (
                <div class="mt-12">
                  <a
                    href={ctaLink || `/${currentPath}contact`}
                    class="inline-flex items-center px-10 py-5 bg-[#5D4E37] text-white font-bold rounded-lg hover:bg-[#4A3D2E] transition-all duration-300 shadow-lg hover:shadow-xl"
                  >
                    {cta}
                  </a>
                </div>
              )}
            </div>
          </div>
        </section>
      ) : (
        /* Sidebar Layout */
        <section class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4 py-24">
          <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
            <div class="lg:col-span-3">
              {image && !showQuoteBenefits && (
                <div class="mb-12 rounded-2xl overflow-hidden shadow-xl aspect-video lg:aspect-auto">
                  <img src={image} alt={title} class="w-full h-auto" width="800" height="450" loading="lazy" decoding="async" />
                </div>
              )}

              {!showQuoteBenefits && (
                  <h1 class="text-4xl font-bold text-stone-900 mb-8 tracking-tight">
                      {title}
                  </h1>
              )}

              <div class="prose prose-lg max-w-none text-stone-700 prose-headings:text-stone-900">
                <Content />
              </div>

              {cta && (
                <div class="mt-12">
                  <a
                    href={ctaLink || `/${currentPath}contact`}
                    class="inline-flex items-center px-10 py-5 bg-[#5D4E37] text-white font-bold rounded-lg hover:bg-[#4A3D2E] transition-all duration-300"
                  >
                    {cta}
                  </a>
                </div>
              )}
            </div>

            <aside class="lg:col-span-1">
              <div class="bg-stone-50 rounded-2xl p-8 sticky top-24 border border-stone-100 shadow-xs">
                <p class="text-sm font-bold text-stone-900 uppercase tracking-widest mb-6 border-b border-stone-200 pb-2">
                  {t.footer?.quickLinksTitle || 'Quick Links'}
                </p>
                <ul class="space-y-4">
                  <li><a href={`/${currentPath}product`} class="text-stone-600 hover:text-[#5D4E37] font-semibold transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-[#8B7355] opacity-0 group-hover:opacity-100 transition-opacity"></span>{t.nav.products}</a></li>
                  <li><a href={`/${currentPath}collection`} class="text-stone-600 hover:text-[#5D4E37] font-semibold transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-[#8B7355] opacity-0 group-hover:opacity-100 transition-opacity"></span>{t.nav.collection}</a></li>
                  <li><a href={`/about-us`} class="text-stone-600 hover:text-[#5D4E37] font-semibold transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-[#8B7355] opacity-0 group-hover:opacity-100 transition-opacity"></span>{t.nav.about}</a></li>
                  <li><a href={`/contact`} class="text-stone-600 hover:text-[#5D4E37] font-semibold transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-[#8B7355] opacity-0 group-hover:opacity-100 transition-opacity"></span>{t.nav.contact}</a></li>
                </ul>
              </div>
            </aside>
          </div>
        </section>
      )
    )}

    {/* 4th SECTION: Inquiry Form */}
    {showInquiryForm && (
      <InquiryFormLazy lang={lang} productName={title} />
    )}
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .prose {
    --tw-prose-body: #374151;
    --tw-prose-headings: #111827;
    --tw-prose-links: #8B7355;
    --tw-prose-bold: 700;
  }
</style>
