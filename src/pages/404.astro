---
/**
 * 404 Rescue Page (English)
 * Non-English 404s redirect to their localized version via inline script.
 * Redirect only triggers once — if already on /{lang}/404, no redirect.
 */
import NotFoundPage from '../components/pages/NotFoundPage.astro';
---
<!-- Render English version immediately (before any JS runs) -->
<NotFoundPage lang="en" />

<!-- Redirect non-English 404s to localized version.
     Inline script runs synchronously in <head> before render,
     so non-English users barely see the English version. -->
<script is:inline>
  (function() {
    var path = window.location.pathname;
    var langs = ['it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
    var found = null;
    for (var i = 0; i < langs.length; i++) {
      if (path.startsWith('/' + langs[i] + '/') || path === '/' + langs[i]) {
        found = langs[i];
        break;
      }
    }
    if (found && path !== '/' + found + '/404' && path !== '/' + found + '/404/') {
      window.location.replace('/' + found + '/404');
    }
  })();
</script>
