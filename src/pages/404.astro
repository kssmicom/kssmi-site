---
import NotFoundPage from '../components/pages/NotFoundPage.astro';
---
<div id="notfound-root"><NotFoundPage lang="en" /></div>
<script is:inline>
  (function() {
    var path = window.location.pathname;
    var langs = ['it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
    var found = null;
    for (var i = 0; i < langs.length; i++) {
      if (path.startsWith('/' + langs[i] + '/') || path === '/' + langs[i]) {
        found = langs[i];
        break;
      }
    }
    // If we detected a non-English language and it's not already /{lang}/404, redirect once
    if (found && path !== '/' + found + '/404' && path !== '/' + found + '/404/') {
      window.location.replace('/' + found + '/404');
    }
  })();
</script>