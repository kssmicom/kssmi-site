---
/**
 * 404 Rescue Page (English)
 * Turns lost visitors into leads — friendly message, 3 targeted links,
 * and a mini contact form with Cloudflare Turnstile anti-spam.
 * Non-English 404s redirect to their localized version via inline script.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';
const isDev = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';
---

<Layout title="Page Not Found | Kssmi Eyewear" lang={lang}>
  <!-- Redirect non-English 404s to localized version -->
  <script is:inline>
    (function() {
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const supportedLangs = ['it', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'tr', 'ar', 'ko', 'zh', 'hi', 'vi', 'jv', 'ms', 'tg'];
      if (pathParts.length > 0 && supportedLangs.includes(pathParts[0])) {
        const lang = pathParts[0];
        if (window.location.pathname !== `/${lang}/404` && window.location.pathname !== `/${lang}/404/`) {
          document.documentElement.style.opacity = '0';
          window.location.replace(`/${lang}/404`);
        }
      }
    })();
  </script>

  <Header lang={lang} />

  <main id="main-content" tabindex="-1" class="w-full min-h-screen bg-stone-50 pt-12 pb-16 flex items-center focus:outline-none">
    <div class="w-[94%] lg:w-[90%] 2xl:w-[85%] max-w-[1200px] mx-auto px-4">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

        <!-- LEFT: Image -->
        <div class="hidden lg:block">
          <div class="relative group">
            <img
              src="/media/global/404-team.webp"
              alt="Kssmi Eyewear Manufacturing Team"
              class="w-full h-auto rounded-2xl shadow-lg object-cover aspect-[4/3] transition-transform duration-500 group-hover:scale-[1.02]"
              loading="eager"
              decoding="async"
            />
            <div class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-sm rounded-lg px-4 py-3 shadow-sm transition-all duration-300 group-hover:bg-white group-hover:shadow-md group-hover:-translate-y-1">
              <p class="text-sm font-semibold text-[#5D4E37]">Kssmi Eyewear Mfg.</p>
              <p class="text-xs text-stone-500">Crafting precision frames since 2003</p>
            </div>
          </div>
        </div>

        <!-- RIGHT: Content -->
        <div class="text-center lg:text-left">
          <!-- Kssmi Logo (mobile only) -->
          <div class="inline-flex flex-col items-center justify-center mb-6 lg:hidden">
            <span class="text-xl font-bold text-[#503629] tracking-tight leading-none uppercase">KSSMI</span>
            <span class="h-[2px] w-5 bg-[#503629] mt-1"></span>
            <span class="text-[8px] font-bold uppercase tracking-[0.2em] text-[#503629] mt-1">Eyewear Mfg.</span>
          </div>

          <!-- 404 Badge -->
          <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-[#8B7355] bg-[#8B7355]/10 px-3 py-1 rounded-full mb-4">
            404
          </span>

          <!-- Warm heading -->
          <h1 class="text-2xl lg:text-3xl font-bold text-[#5D4E37] mb-3 tracking-tight">
            This page has stepped out —
          </h1>
          <p class="text-lg text-[#8B7355] font-medium mb-2">
            but we're still here, crafting eyewear.
          </p>
          <p class="text-base text-stone-500 mb-8 max-w-lg mx-auto lg:mx-0">
            The link you followed may be outdated, or the page may have moved.
            No worries — everything we make is still right here.
          </p>

          <!-- 3 Targeted Links -->
          <div class="mb-10">
            <p class="text-sm font-bold text-stone-400 uppercase tracking-wider mb-4">
              You might be looking for...
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-xl mx-auto lg:mx-0">
              <a href="/quote"
                class="group flex items-center gap-3 bg-white rounded-xl p-4 border border-stone-200 hover:border-[#8B7355] hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                <span class="flex-shrink-0 w-10 h-10 bg-[#8B7355]/10 rounded-lg flex items-center justify-center group-hover:bg-[#8B7355]/20 transition-colors">
                  <svg class="w-5 h-5 text-[#8B7355]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </span>
                <div class="text-left">
                  <span class="block text-sm font-semibold text-[#5D4E37] group-hover:text-[#8B7355] transition-colors">Custom OEM</span>
                  <span class="block text-xs text-stone-400">Get a quote</span>
                </div>
              </a>

              <a href="/product"
                class="group flex items-center gap-3 bg-white rounded-xl p-4 border border-stone-200 hover:border-[#8B7355] hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                <span class="flex-shrink-0 w-10 h-10 bg-[#8B7355]/10 rounded-lg flex items-center justify-center group-hover:bg-[#8B7355]/20 transition-colors">
                  <svg class="w-5 h-5 text-[#8B7355]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                  </svg>
                </span>
                <div class="text-left">
                  <span class="block text-sm font-semibold text-[#5D4E37] group-hover:text-[#8B7355] transition-colors">Catalog</span>
                  <span class="block text-xs text-stone-400">Browse products</span>
                </div>
              </a>

              <a href="/about-us"
                class="group flex items-center gap-3 bg-white rounded-xl p-4 border border-stone-200 hover:border-[#8B7355] hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                <span class="flex-shrink-0 w-10 h-10 bg-[#8B7355]/10 rounded-lg flex items-center justify-center group-hover:bg-[#8B7355]/20 transition-colors">
                  <svg class="w-5 h-5 text-[#8B7355]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </span>
                <div class="text-left">
                  <span class="block text-sm font-semibold text-[#5D4E37] group-hover:text-[#8B7355] transition-colors">Factory</span>
                  <span class="block text-xs text-stone-400">Our capabilities</span>
                </div>
              </a>
            </div>
          </div>

          <!-- Divider with humor -->
          <div class="flex items-center justify-center lg:justify-start gap-3 mb-8">
            <span class="h-[1px] w-10 bg-[#8B7355]/20"></span>
            <p class="text-xs text-stone-400 italic">
              We craft every frame to precise specs. This URL? Not so much.
            </p>
            <span class="h-[1px] w-10 bg-[#8B7355]/20"></span>
          </div>

          <!-- Mini Rescue Form (with Turnstile) -->
          <div class="bg-white rounded-xl p-6 border border-stone-200 shadow-sm max-w-xl mx-auto lg:mx-0 mb-8">
            <p class="text-sm font-bold text-[#5D4E37] mb-1">Didn't find what you needed?</p>
            <p class="text-xs text-stone-400 mb-4">Tell us what you're looking for — a real person will get back to you.</p>

            <!-- Form error message (hidden) -->
            <div id="form-error" class="hidden text-center py-2 mb-3 bg-red-50 rounded-lg">
              <span id="error-message" class="text-xs text-red-600"></span>
            </div>

            <form id="rescue-form" class="space-y-3">
              <input
                type="email"
                name="email"
                placeholder="Your email address"
                required
                class="w-full px-4 py-2.5 text-sm border border-stone-200 rounded-lg focus:border-[#8B7355] focus:ring-2 focus:ring-[#8B7355]/10 outline-none transition-all bg-stone-50"
              />
              <textarea
                name="details"
                rows="3"
                placeholder="What were you looking for?&#10;Describe what you need — the more details, the better we can help."
                required
                class="w-full px-4 py-2.5 text-sm border border-stone-200 rounded-lg focus:border-[#8B7355] focus:ring-2 focus:ring-[#8B7355]/10 outline-none transition-all bg-stone-50 resize-y min-h-[80px]"
              ></textarea>

              <!-- Hidden fields -->
              <input type="hidden" name="name" value="404 Rescue" />
              <input type="hidden" name="product_name" id="field-page" value="" />
              <input type="hidden" name="source" value="404 Page" />
              <input type="hidden" name="language" value="en" />
              <input type="hidden" name="client_ip" id="client-ip" value="" />
              <input type="hidden" name="client_country" id="client-country" value="" />

              <!-- Turnstile -->
              <div id="turnstile-container" class={`flex justify-center ${isDev ? 'hidden' : ''}`}></div>
              <div id="turnstile-error" class="hidden text-center py-2 px-3 bg-red-50 rounded-lg">
                <span id="turnstile-error-message" class="text-xs text-red-600">Please complete the security check above.</span>
              </div>

              <!-- Submit -->
              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-[#5D4E37] text-white py-2.5 rounded-lg text-sm font-semibold hover:bg-[#8B7355] transition-colors duration-300 flex items-center justify-center gap-2 disabled:opacity-50"
              >
                <svg id="btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span id="btn-text">Send &amp; We'll Help</span>
                <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
              </button>
            </form>

            <!-- Form success (hidden) -->
            <div id="form-success" class="hidden text-center py-4">
              <svg class="w-10 h-10 text-green-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-sm font-semibold text-[#5D4E37]">Message sent!</p>
              <p class="text-xs text-stone-400">We'll get back to you shortly.</p>
            </div>
          </div>

          <!-- Back to Home -->
          <a href="/"
            class="inline-flex items-center gap-2 text-sm font-medium text-[#8B7355] hover:text-[#5D4E37] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Homepage
          </a>
        </div>
      </div>

      <!-- Search Bar -->
      <div class="mt-16 max-w-2xl mx-auto">
        <p class="text-center text-xs font-bold text-stone-400 uppercase tracking-wider mb-4">
          Or search for what you need
        </p>
        <form id="search-form" action="/search" method="GET" class="relative group">
          <div class="flex items-center border-2 border-stone-200 bg-white rounded-full overflow-hidden focus-within:border-[#8B7355] shadow-sm transition-all duration-300 focus-within:ring-4 focus-within:ring-[#8B7355]/10">
            <input
              id="search-input"
              type="search"
              name="q"
              autocomplete="off"
              class="flex-grow py-3.5 px-5 bg-transparent border-none outline-none text-sm text-stone-900 placeholder-stone-400 font-medium focus:ring-0"
              placeholder="Search products, materials, styles..."
            />
            <button type="button" id="search-clear" class="hidden px-3 text-stone-400 hover:text-[#5D4E37] transition-colors flex-shrink-0" aria-label="Clear search">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
            <button type="submit" class="px-5 py-2 mr-1.5 bg-[#5D4E37] text-white rounded-full hover:bg-[#8B7355] transition-all duration-300 font-bold tracking-wide text-xs uppercase shadow-md flex-shrink-0 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <span>Search</span>
            </button>
          </div>
        </form>
      </div>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<style is:global>
  input[type="search"]::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }
  input[type="search"]::-moz-search-clear-button {
    display: none;
  }
</style>

<!-- Turnstile: define callback BEFORE loading script (production only) -->
{!isDev && (
  <script is:inline>
    window.TURNSTILE_SITE_KEY = "0x4AAAAAACGlmQDIODBgCmpo";
    window.turnstileToken = null;

    window.onTurnstileLoad = function() {
      var container = document.getElementById('turnstile-container');
      if (!container) return;
      container.innerHTML = '';
      var widgetDiv = document.createElement('div');
      container.appendChild(widgetDiv);
      try {
        window.turnstile.render(widgetDiv, {
          sitekey: window.TURNSTILE_SITE_KEY,
          theme: 'light',
          callback: function(token) {
            window.turnstileToken = token;
            var errorEl = document.getElementById('turnstile-error');
            if (errorEl) errorEl.classList.add('hidden');
          },
          'expired-callback': function() {
            window.turnstileToken = null;
          }
        });
      } catch (e) {
        console.error('Turnstile render error:', e);
      }
    };
  </script>
)}

{!isDev && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>
)}

<script define:vars={{ isDev }}>
  // --- Search clear logic (matches /search page) ---
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;

  function updateClearButton() {
    if (searchInput && searchClear) {
      if (searchInput.value.trim()) {
        searchClear.classList.remove('hidden');
      } else {
        searchClear.classList.add('hidden');
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', updateClearButton);
  }

  if (searchClear && searchInput) {
    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      searchClear.classList.add('hidden');
      searchInput.focus();
    });
  }

  // Initial state (handles browser autofill)
  updateClearButton();

  // --- Set page URL in hidden field ---
  const pageField = document.getElementById('field-page') as HTMLInputElement | null;
  if (pageField) pageField.value = window.location.pathname;

  // --- Fetch client IP (reused from InquiryForm pattern) ---
  async function fetchClientIP() {
    try {
      const response = await fetch('https://ipapi.co/json/', {
        method: 'GET',
        headers: { 'Accept': 'application/json' }
      });
      if (response.ok) {
        const data = await response.json();
        const ipInput = document.getElementById('client-ip') as HTMLInputElement | null;
        const countryInput = document.getElementById('client-country') as HTMLInputElement | null;
        if (ipInput && data.ip) ipInput.value = data.ip;
        if (countryInput && data.country_code) countryInput.value = data.country_code;
      }
    } catch (e) { /* silent */ }
  }
  fetchClientIP();

  // --- Form elements ---
  function getEls() {
    return {
      form: document.getElementById('rescue-form') as HTMLFormElement | null,
      submitBtn: document.getElementById('submit-btn') as HTMLButtonElement | null,
      btnText: document.getElementById('btn-text')!,
      btnIcon: document.getElementById('btn-icon')!,
      btnSpinner: document.getElementById('btn-spinner')!,
      errorContainer: document.getElementById('form-error')!,
      errorMessage: document.getElementById('error-message')!,
      turnstileError: document.getElementById('turnstile-error')!,
      successEl: document.getElementById('form-success')!,
    };
  }

  function setLoading(loading: boolean) {
    const { submitBtn, btnText, btnIcon, btnSpinner } = getEls();
    if (submitBtn) submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Sending...' : "Send & We'll Help";
    if (loading) { btnIcon.classList.add('hidden'); btnSpinner.classList.remove('hidden'); }
    else { btnIcon.classList.remove('hidden'); btnSpinner.classList.add('hidden'); }
  }

  // --- Form submission (clone pattern from InquiryForm) ---
  function setupForm() {
    const { form } = getEls();
    if (!form) return;

    const newForm = form.cloneNode(true) as HTMLFormElement;
    form.parentNode!.replaceChild(newForm, form);

    newForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const { errorContainer, errorMessage, turnstileError, successEl } = getEls();
      errorContainer.classList.add('hidden');
      turnstileError.classList.add('hidden');

      // Check Turnstile (skip in dev)
      const token = (window as any).turnstileToken;
      if (!isDev && !token) {
        turnstileError.classList.remove('hidden');
        return;
      }

      const formData = new FormData(newForm);
      if (!isDev && token) {
        formData.append('cf-turnstile-response', token);
      }

      setLoading(true);

      try {
        const apiUrl = isDev ? 'http://localhost:4325/send-mail.php' : '/send-mail.php';
        const response = await fetch(apiUrl, { method: 'POST', body: formData });

        if (!response.ok) {
          const ct = response.headers.get('content-type');
          if (ct && ct.includes('text/html')) throw new Error('PHP_NOT_CONFIGURED');
          throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
          newForm.classList.add('hidden');
          successEl.classList.remove('hidden');
        } else {
          errorMessage.textContent = result.message || 'Something went wrong. Please try again.';
          errorContainer.classList.remove('hidden');
          setLoading(false);
        }
      } catch (err: any) {
        console.error('404 form error:', err);
        errorMessage.textContent = 'Unable to send. Please email us at sales@kssmi.com.';
        errorContainer.classList.remove('hidden');
        setLoading(false);
      }
    });
  }

  setupForm();
</script>
