---
import ProductListingPage from '../../components/pages/ProductListingPage.astro';
import { getCollection } from 'astro:content';
// import { getProductLang } 
import { cardSrc } from '../../utils/image';
import { getTranslations } from '../../translations';

const lang = 'en';
const currentPath = '';
const PAGE_SIZE = 12;

const allProducts = await getCollection('blog');
  if (allProducts.length === 0) return [];
const langProducts = allProducts.filter((p: any) => p.data.lang === lang);

const sortedProducts = langProducts.sort((a: any, b: any) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const dateA = a.data.published ? new Date(a.data.published).getTime() : 0;
  const dateB = b.data.published ? new Date(b.data.published).getTime() : 0;
  if (dateA !== dateB) return dateB - dateA;
  return b.id.localeCompare(a.id);
});

const totalPages = Math.ceil(sortedProducts.length / PAGE_SIZE);

export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const lang = 'en';
  const all = await getCollection('blog');
  const en = all.filter((p: any) => p.data.lang === 'en');
  const sorted = en.sort((a: any, b: any) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    const dateA = a.data.published ? new Date(a.data.published).getTime() : 0;
    const dateB = b.data.published ? new Date(b.data.published).getTime() : 0;
    if (dateA !== dateB) return dateB - dateA;
    return b.id.localeCompare(a.id);
  });
  const total = Math.ceil(sorted.length / PAGE_SIZE);
  return Array.from({ length: total }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const pageNum = parseInt(page, 10);

if (pageNum < 2 || pageNum > totalPages) {
  return Astro.redirect('/blog');
}

const start = (pageNum - 1) * PAGE_SIZE;
const items = sortedProducts.slice(start, start + PAGE_SIZE);

const t = await getTranslations(lang);
const lcpImage = products[0]?.data?.image ? cardSrc(products[0].data.cover) : undefined;

const breadcrumbItems = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.blog || 'Blog' || 'Products', href: '/blog' },
];
---

<ProductListingPage
  lang={lang}
  currentPath={currentPath}
  baseSegment="blog"
  products={products}
  allProducts={sortedProducts}
  currentPage={pageNum}
  totalPages={totalPages}
  basePath="/product"
  breadcrumbItems={breadcrumbItems}
  title={t.nav.blog || 'Blog'}
  lcpImage={lcpImage}
>
    <Fragment slot="cards">
    {items.map((item: any) => {
      const img = item.data.image || '/media/global/placeholder.webp';
      const itemSlug = item.data.slug || item.id.split('/').pop()?.replace(/\.[a-z]{2}$/, '') || '';
      const href = `/${currentPath}blog/${itemSlug}/`;
      return (
        <a href={href} class="group bg-white rounded-xl shadow-sm border border-stone-200/50 overflow-hidden hover:shadow-md transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-100">
            <img src={img} alt={item.data.title || ''} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="300" loading="lazy" decoding="async" />
          </div>
          <div class="p-4">
            {item.data.category && (<span class="text-[10px] font-bold text-[#8B7355] uppercase tracking-wider">{item.data.category}</span>)}
            <h3 class="text-sm font-bold text-stone-900 mt-1 line-clamp-2 group-hover:text-[#5D4E37] transition-colors">{item.data.title}</h3>
            {item.data.excerpt && (<p class="text-xs text-stone-600 mt-2 line-clamp-2">{item.data.excerpt}</p>)}
          </div>
        </a>
      );
    })}
  </Fragment></ProductListingPage>