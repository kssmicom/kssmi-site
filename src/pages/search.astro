---
// English search page (default locale)
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { translations } from '../translations';

const t = translations.en;
const lang = 'en';
const pt = t.product || {};
const viewDetailsText = pt.viewDetails || 'View Details';
---

<Layout title="Search Results | Kssmi" lang="en" noindex={true}>
  <Header lang={lang} />

  <div id="search-page" data-lang="en" data-view-details={viewDetailsText}>
  <section class="w-full min-h-screen bg-stone-100 pt-8 pb-24">
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">

      <!-- Search Header Block -->
      <div class="text-center mb-6 relative max-w-4xl mx-auto">
        <!-- Kssmi Text Logo -->
        <div class="inline-flex flex-col items-center justify-center w-20 h-20 rounded-full bg-white border border-stone-300 hover:border-[#8B7355] hover:shadow-lg transition-all duration-700 ease-out mb-4 shadow-sm">
          <span class="text-sm font-bold text-[#503629] tracking-tight leading-none uppercase">KSSMI</span>
          <span class="h-[1px] w-4 bg-stone-400 mt-[2px]"></span>
          <span class="text-[7px] font-bold uppercase tracking-[0.15em] text-stone-500 mt-[2px]">Eyewear Mfg.</span>
        </div>

        <h1 class="text-[22px] md:text-[27px] font-bold text-[#5D4E37] mb-3 tracking-tight">
          Search Results
        </h1>

        <!-- Query display (updated by JS) -->
        <div id="search-info" class="hidden">
          <div class="inline-block relative">
            <p class="text-lg text-stone-600 mb-2 font-light">
              Found matches for <span id="query-display" class="font-bold text-[#5D4E37] border-b-2 border-[#8B7355]/20"></span>
            </p>
          </div>

          <div class="flex items-center justify-center gap-3">
            <span class="h-[1px] w-10 bg-[#8B7355]/30"></span>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#5D4E37]">
              <span id="count-number">0</span> Results Found
            </p>
            <span class="h-[1px] w-10 bg-[#8B7355]/30"></span>
          </div>
        </div>
      </div>

      <!-- Search Form Block -->
      <div class="max-w-3xl mx-auto mb-8 relative z-10">
        <form action="/search" method="GET" class="relative group">
          <div class="absolute inset-0 bg-[#5D4E37]/5 rounded-full blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

          <div class="flex items-center border-2 border-stone-200 bg-white rounded-full overflow-hidden focus-within:border-[#8B7355] shadow-sm transition-all duration-300 focus-within:ring-4 focus-within:ring-[#8B7355]/10 relative z-10">
            <label for="search-input" class="sr-only">Search products</label>
            <input
              type="search"
              name="q"
              id="search-input"
              placeholder="Search products, technical specs, and articles..."
              class="flex-grow py-4 px-6 bg-transparent border-none outline-none text-base text-stone-900 placeholder-stone-400 font-medium focus:ring-0"
            >

            <!-- Clear Button (X icon) -->
            <button type="button" id="search-clear" class="hidden px-2 text-stone-400 hover:text-stone-600 transition-colors" aria-label="Clear search">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>

            <!-- Search Button -->
            <button type="submit" class="px-5 py-2.5 mr-1.5 bg-[#5D4E37] text-white rounded-full hover:bg-[#4A3D2E] transition-all duration-300 font-bold tracking-wide text-xs uppercase shadow-md flex-shrink-0 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <span>Search</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="hidden text-center py-4">
        <svg class="w-12 h-12 mx-auto animate-spin text-[#5D4E37]" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="mt-4 text-stone-600">Searching...</p>
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="text-center py-6">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-white border border-stone-200 rounded-full mb-8 shadow-sm">
          <svg class="w-8 h-8 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <h2 class="text-3xl font-bold text-[#5D4E37] mb-4">{pt.searchTitle || 'Search Kssmi'}</h2>
        <p class="text-base text-stone-600 mb-10 max-w-md mx-auto">
          {pt.searchDesc || 'Find products, articles, and more. Enter a search term above.'}
        </p>

        <!-- Suggestions -->
        <div class="mt-12 max-w-5xl mx-auto">
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-[#5D4E37] mb-8">{pt.recommendedSearches || 'Recommended Searches'}</h3>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="/search?q=optical+frames" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">
              Optical Frames
            </a>
            <a href="/search?q=sunglasses" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">
              Sunglasses
            </a>
            <a href="/search?q=acetate" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">
              Acetate
            </a>
            <a href="/search?q=titanium" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">
              Titanium
            </a>
            <a href="/search?q=metal" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">
              Metal
            </a>
          </div>
        </div>
      </div>

      <!-- Results Grid -->
      <div id="search-results" class="hidden grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-6 lg:gap-x-6 lg:gap-y-10">
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden text-center py-6">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-white border border-stone-200 rounded-full mb-8 shadow-sm hover:border-[#8B7355] transition-colors duration-500">
          <svg class="w-8 h-8 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h2 class="text-3xl font-bold text-[#5D4E37] mb-4">{pt.noMatches || 'No Matches Found'}</h2>
        <p class="text-base text-stone-600 mb-10 max-w-md mx-auto" id="no-results-text">
          {pt.noMatchesDesc || "We couldn't locate any items matching your criteria. Please refine your keywords."}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="/" class="inline-flex items-center px-8 py-3 bg-[#5D4E37] text-white font-bold uppercase tracking-wider text-xs rounded-full hover:bg-[#4A3D2E] transition-colors duration-300 shadow-lg">
            {pt.backToHome || 'Back to Home'}
          </a>
          <a href="/product" class="inline-flex items-center px-8 py-3 border-2 border-[#5D4E37] text-[#5D4E37] font-bold uppercase tracking-wider text-xs rounded-full hover:bg-[#4A3D2E] hover:text-white transition-all duration-300">
            View Catalog
          </a>
        </div>

        <!-- Suggestions -->
        <div class="mt-12 max-w-5xl mx-auto">
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-[#5D4E37] mb-8">{pt.recommendedSearches || 'Recommended Searches'}</h3>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="/search?q=optical+frames" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">Optical Frames</a>
            <a href="/search?q=sunglasses" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">Sunglasses</a>
            <a href="/search?q=acetate" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">Acetate</a>
            <a href="/search?q=titanium" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">Titanium</a>
            <a href="/search?q=metal" class="px-5 py-2.5 bg-white border border-stone-200 text-stone-700 text-xs font-bold tracking-wide uppercase rounded-sm hover:border-[#8B7355] hover:text-[#5D4E37] transition-all duration-300 shadow-sm hover:shadow-md">Metal</a>
          </div>
        </div>
      </div>

      <!-- Error State -->
      <div id="error-state" class="hidden text-center py-6">
        <p class="text-red-600">Search is not available. Please try again later.</p>
      </div>

      <!-- Pagination -->
      <div id="pagination" class="hidden mt-12 flex justify-center">
        <div id="pagination-container"></div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  </div>
</Layout>

<style is:global>
  /* Hide browser-native clear button on search inputs */
  input[type="search"]::-webkit-search-cancel-button,
  input[type="search"]::-webkit-search-decoration {
    display: none;
  }

  /* ── Search Result Card (mirrors ProductCard.astro) ── */
  .src-card {
    display: block;
    text-decoration: none;
  }
  .src-card-inner {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
    overflow: hidden;
    transition: box-shadow 0.3s ease;
  }
  .src-card:hover .src-card-inner {
    box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
  }
  .src-img-wrap {
    position: relative;
    width: 100%;
    padding-top: 75%;
    overflow: hidden;
    background-color: #f3f4f6;
  }
  .src-img,
  .src-img-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .src-img {
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .src-card:hover .src-img {
    transform: scale(1.05);
  }
  .src-img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
  }
  .src-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }
  .src-card:hover .src-overlay {
    opacity: 1;
  }
  .src-overlay-pill {
    background: black;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: translateY(0.5rem);
    transition: transform 0.3s ease;
  }
  .src-card:hover .src-overlay-pill {
    transform: translateY(0);
  }
  .src-overlay-pill .src-arrow {
    transition: transform 0.3s ease;
  }
  .src-card:hover .src-overlay-pill .src-arrow {
    transform: translateX(4px);
  }
  .src-info {
    padding: 1rem 1.25rem;
    text-align: center;
  }
  .src-item-no {
    font-size: 0.75rem;
    color: #6B5340;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .src-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
    line-clamp: 2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.3s ease;
  }
  .src-card:hover .src-title {
    color: #8B7355;
  }

  /* ── Pagination (matches Pagination.astro) ── */
  .search-pagination-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #e5e7eb;
    color: #4b5563;
    background: transparent;
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
    cursor: pointer;
  }
  .search-pagination-btn:hover {
    background-color: #f9fafb;
    border-color: #8B7355;
    color: #5D4E37;
  }
  .search-pagination-btn.active {
    background-color: #5D4E37;
    color: #ffffff;
    box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
  }
  .search-pagination-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    color: #4b5563;
    background: transparent;
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
    cursor: pointer;
  }
  @media (min-width: 640px) {
    .search-pagination-nav-btn {
      padding: 0.375rem 1rem;
    }
  }
  .search-pagination-nav-btn:hover {
    background-color: #f9fafb;
    border-color: #8B7355;
    color: #5D4E37;
  }
  .search-pagination-nav-btn:disabled {
    color: #6b7280;
    cursor: not-allowed;
  }
  .search-goto-input {
    width: 2.5rem;
    height: 2.5rem;
    text-align: center;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: #4b5563;
    background: transparent;
    outline: none;
  }
  @media (min-width: 640px) {
    .search-goto-input {
      width: 3.5rem;
    }
  }
  .search-goto-input:focus {
    border-color: #8B7355;
    box-shadow: 0 0 0 1px #8B7355;
  }
  .search-goto-btn {
    display: inline-flex;
    align-items: center;
    padding: 0 0.5rem;
    height: 2.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    color: #4b5563;
    background: transparent;
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
    cursor: pointer;
  }
  .search-goto-btn:hover {
    background-color: #f9fafb;
    border-color: #8B7355;
    color: #5D4E37;
  }
</style>

<script>
  import Fuse from 'fuse.js';

  document.addEventListener('astro:page-load', () => {
  // Get translation text from data attribute
  const searchPage = document.getElementById('search-page');
  const VIEW_DETAILS = searchPage?.dataset.viewDetails || 'View Details';
  const lang = searchPage?.dataset.lang || 'en';
  // Read query fresh from URL each time (prevents stale-closure display bugs)
  function getQuery() {
    return new URLSearchParams(window.location.search).get('q') || '';
  }

  // DOM elements
  const searchInput = document.getElementById('search-input');
  const searchClear = document.getElementById('search-clear');
  const searchInfo = document.getElementById('search-info');
  const queryDisplay = document.getElementById('query-display');
  const countNumber = document.getElementById('count-number');
  const loadingState = document.getElementById('loading-state');
  const emptyState = document.getElementById('empty-state');
  const searchResults = document.getElementById('search-results');
  const noResults = document.getElementById('no-results');
  const errorState = document.getElementById('error-state');
  const pagination = document.getElementById('pagination');
  const paginationContainer = document.getElementById('pagination-container');

  const RESULTS_PER_PAGE = 12;
  let currentPage = 1;
  let allResults = [];
  let fuse = null;

  // Initialize Fuse.js with the unified search index
  async function initFuse() {
    try {
      const res = await fetch('/api/search-index/en.json', { cache: 'no-store' });
      if (!res.ok) throw new Error(`Failed to fetch search index: ${res.status}`);
      const items = await res.json();

      fuse = new Fuse(items, {
        keys: [
          { name: 'itemNo',      weight: 0.40 },
          { name: 'slug',        weight: 0.30 },
          { name: 'title',       weight: 0.20 },
          { name: 'keywords',    weight: 0.05 },
          { name: 'description', weight: 0.05 },
        ],
        threshold: 0.4,
        includeScore: true,
        ignoreLocation: true,
        minMatchCharLength: 2,
      });
      // Keep the raw items for the substring pre-filter
      fuse._items = items;
      return true;
    } catch (err) {
      return false;
    }
  }

  // Guarantee that product codes containing the query substring always appear
  function substringFilter(items, q) {
    const lower = q.toLowerCase().replace(/\s+/g, '');
    return items.filter(item => {
      const itemNo  = (item.itemNo  || '').toLowerCase().replace(/\s+/g, '');
      const slug    = (item.slug    || '').toLowerCase().replace(/-/g, '');
      const title   = (item.title   || '').toLowerCase();
      return itemNo.includes(lower) || slug.includes(lower) || title.includes(lower);
    });
  }

  async function performSearch(searchQuery) {
    if (!searchQuery) {
      showEmpty();
      return;
    }

    showLoading();

    try {
      if (!fuse) {
        const initSuccess = await initFuse();
        if (!initSuccess) {
          showError();
          return;
        }
      }

      // 1. Guaranteed substring matches (always included)
      const rawItems = fuse._items || [];
      const subMatches = substringFilter(rawItems, searchQuery);
      const subMatchUrls = new Set(subMatches.map(i => i.url));

      // 2. Fuse fuzzy matches
      const fuseResults = fuse.search(searchQuery).map(r => r.item);

      // 3. Merge: substring matches first, then additional Fuse results
      const merged = [...subMatches];
      for (const item of fuseResults) {
        if (!subMatchUrls.has(item.url)) {
          merged.push(item);
        }
      }

      if (merged.length === 0) {
        showNoResults();
        return;
      }

      allResults = merged;

      if (countNumber) {
        countNumber.textContent = allResults.length.toString();
      }

      showResults();
      renderPage(1);

    } catch (error) {
      showError();
    }
  }

  // Clear button functionality
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      if (searchInput.value.trim()) {
        searchClear?.classList.remove('hidden');
      } else {
        searchClear?.classList.add('hidden');
      }
    });
  }

  if (searchClear && searchInput) {
    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      searchClear.classList.add('hidden');
      searchInput.focus();
    });
  }

  // Pre-fill search input
  if (searchInput && getQuery()) {
    searchInput.value = getQuery();
    if (searchInput.value.trim()) {
      searchClear?.classList.remove('hidden');
    }
  }

  function hideAllStates() {
    loadingState?.classList.add('hidden');
    emptyState?.classList.add('hidden');
    searchResults?.classList.add('hidden');
    noResults?.classList.add('hidden');
    errorState?.classList.add('hidden');
    pagination?.classList.add('hidden');
    searchInfo?.classList.add('hidden');
  }

  function showLoading() {
    hideAllStates();
    loadingState?.classList.remove('hidden');
    searchInfo?.classList.remove('hidden');
    if (queryDisplay) queryDisplay.textContent = getQuery();
  }

  function showEmpty() {
    hideAllStates();
    emptyState?.classList.remove('hidden');
  }

  function showNoResults() {
    hideAllStates();
    noResults?.classList.remove('hidden');
    searchInfo?.classList.remove('hidden');
    if (queryDisplay) queryDisplay.textContent = getQuery();
    if (countNumber) countNumber.textContent = '0';
  }

  function showError() {
    hideAllStates();
    errorState?.classList.remove('hidden');
  }

  function showResults() {
    hideAllStates();
    searchResults?.classList.remove('hidden');
    searchInfo?.classList.remove('hidden');
    if (queryDisplay) queryDisplay.textContent = getQuery();
  }


  function createResultCard(item, index = -1) {
    const url = item.url || '#';
    const title = item.title || 'Untitled';
    const type = item.type || 'product';

    if (type === 'product') {
      const itemNo = item.itemNo || '';
      const image = item.image400 || item.image || null;
      const imgAttrs = index === 0
        ? `loading="eager" fetchpriority="high" decoding="sync"`
        : `loading="lazy" decoding="async"`;
      const imageContent = image
        ? `<img src="${image}" alt="${title}" width="400" height="300" ${imgAttrs} class="src-img" />`
        : `<div class="src-img-placeholder">
             <svg style="width:3rem;height:3rem;color:#6b7280" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                 d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
             </svg>
           </div>`;
      return `
        <a href="${url}" class="src-card">
          <div class="src-card-inner">
            <div class="src-img-wrap">
              ${imageContent}
              <div class="src-overlay">
                <span class="src-overlay-pill">
                  ${VIEW_DETAILS}
                  <svg class="src-arrow" style="width:1rem;height:1rem" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
            <div class="src-info">
              ${itemNo ? `<p class="src-item-no">${itemNo}</p>` : ''}
              <h2 class="src-title">${title}</h2>
            </div>
          </div>
        </a>`;
    }

    // Blog / Page
    const desc = item.description || '';
    const image = item.image400 || item.image || null;
    const isPage = type === 'page';
    const imgAttrs = index === 0
      ? `loading="eager" fetchpriority="high" decoding="sync"`
      : `loading="lazy" decoding="async"`;
    const kssmiLogo = `
      <div style="
        display:flex;flex-direction:column;align-items:center;justify-content:center;
        gap:4px;padding:1rem;
      ">
        <span style="
          font-size:1.6rem;font-weight:800;color:#503629;
          letter-spacing:0.15em;text-transform:uppercase;line-height:1;
        ">KSSMI</span>
        <span style="height:2px;width:2.5rem;background:#503629;display:block;"></span>
        <span style="
          font-size:0.5rem;font-weight:700;color:#503629;
          letter-spacing:0.25em;text-transform:uppercase;margin-top:2px;
        ">${isPage ? 'PAGE' : 'ARTICLE'}</span>
      </div>
    `;
    const imageContent = image
      ? `<img src="${image}" alt="${title}" width="400" height="300" ${imgAttrs} class="src-img" />`
      : `<div class="src-img-placeholder" style="background:#faf8f5;">${kssmiLogo}</div>`;
    return `
      <a href="${url}" class="src-card">
        <div class="src-card-inner">
          <div class="src-img-wrap">
            ${imageContent}
            <div class="src-overlay">
              <span class="src-overlay-pill">
                ${VIEW_DETAILS}
                <svg class="src-arrow" style="width:1rem;height:1rem" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
          <div class="src-info">
            <h2 class="src-title" style="-webkit-line-clamp:1">${title}</h2>
            ${desc ? `<p style="font-size:0.72rem;color:#6b7280;margin-top:0.2rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden">${desc}</p>` : ''}
          </div>
        </div>
      </a>`;
  }

  function renderPage(page) {
    currentPage = page;
    const startIndex = (page - 1) * RESULTS_PER_PAGE;
    const endIndex = startIndex + RESULTS_PER_PAGE;
    const pageResults = allResults.slice(startIndex, endIndex);

    if (searchResults) {
      searchResults.innerHTML = pageResults.map((item, i) => createResultCard(item, i)).join('');
    }
    renderPagination();
  }

  function renderPagination() {
    const totalPages = Math.ceil(allResults.length / RESULTS_PER_PAGE);

    if (totalPages <= 1) {
      pagination?.classList.add('hidden');
      return;
    }

    pagination?.classList.remove('hidden');
    if (!paginationContainer) return;

    const btnClass = 'search-pagination-btn';
    const btnActiveClass = 'search-pagination-btn active';
    const navBtnClass = 'search-pagination-nav-btn';

    let html = '<nav class="flex justify-center items-center gap-2" aria-label="Pagination">';

    // Previous Button
    if (currentPage > 1) {
      html += `<button data-page="${currentPage - 1}" class="${navBtnClass}" aria-label="Previous">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        <span class="hidden sm:inline">Previous</span>
      </button>`;
    } else {
      html += `<span class="${navBtnClass}" style="cursor:not-allowed;opacity:0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        <span class="hidden sm:inline">Previous</span>
      </span>`;
    }

    // Desktop Page Numbers
    html += '<div class="hidden sm:flex items-center gap-1">';
    // First page
    html += `<button data-page="1" class="${currentPage === 1 ? btnActiveClass : btnClass}" aria-current="${currentPage === 1 ? 'page' : undefined}">1</button>`;
    // Ellipsis before
    if (currentPage > 3) html += '<span class="px-2 text-gray-500">...</span>';
    // Pages around current (skip first and last)
    for (let i = 2; i < totalPages; i++) {
      if (Math.abs(i - currentPage) <= 1) {
        html += `<button data-page="${i}" class="${i === currentPage ? btnActiveClass : btnClass}">${i}</button>`;
      }
    }
    // Ellipsis after
    if (currentPage < totalPages - 2) html += '<span class="px-2 text-gray-500">...</span>';
    // Last page
    if (totalPages > 1) {
      html += `<button data-page="${totalPages}" class="${currentPage === totalPages ? btnActiveClass : btnClass}" aria-current="${currentPage === totalPages ? 'page' : undefined}">${totalPages}</button>`;
    }
    html += '</div>';

    // Mobile Page Numbers
    html += '<div class="flex sm:hidden items-center gap-1 flex-nowrap">';
    if (currentPage > 1) {
      html += `<button data-page="1" class="${btnClass}">1</button>`;
      if (currentPage > 3) html += '<span class="text-gray-500 text-xs px-0.5">...</span>';
    }
    html += `<span class="${btnActiveClass}" aria-current="page">${currentPage}</span>`;
    if (currentPage < totalPages) {
      if (currentPage < totalPages - 2) html += '<span class="text-gray-500 text-xs px-0.5">...</span>';
      html += `<button data-page="${totalPages}" class="${btnClass}">${totalPages}</button>`;
    }
    html += '</div>';

    // Go to Page Input
    html += `
      <div class="flex items-center gap-1">
        <span class="hidden sm:inline text-gray-400 text-sm">|</span>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="${String(totalPages).length}"
          placeholder="#" class="search-goto-input" aria-label="Go to page"
          data-last-page="${totalPages}">
        <button type="button" class="search-goto-btn" aria-label="Go">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
      </div>`;

    // Next Button
    if (currentPage < totalPages) {
      html += `<button data-page="${currentPage + 1}" class="${navBtnClass}" aria-label="Next">
        <span class="hidden sm:inline">Next</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>`;
    } else {
      html += `<span class="${navBtnClass}" style="cursor:not-allowed;opacity:0.5">
        <span class="hidden sm:inline">Next</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </span>`;
    }

    html += '</nav>';
    paginationContainer.innerHTML = html;

    // Use event delegation + rAF to avoid forced reflow from querySelectorAll
    // after innerHTML (browser hasn't laid out new DOM yet — reading it forces sync layout)
    requestAnimationFrame(() => {
      // Click handler for page buttons via event delegation (one listener, not N)
      if (!paginationContainer._hasPageListener) {
        paginationContainer._hasPageListener = true;
        paginationContainer.addEventListener('click', (e) => {
          const btn = (e.target as Element).closest('button[data-page]');
          if (btn) {
            const page = parseInt(btn.getAttribute('data-page') || '1');
            renderPage(page);
            searchResults?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }

      // Go-to-page handlers via event delegation
      if (!paginationContainer._hasGotoListener) {
        paginationContainer._hasGotoListener = true;
        paginationContainer.addEventListener('click', (e) => {
          const gotoBtn = (e.target as Element).closest('.search-goto-btn');
          if (gotoBtn) {
            const input = paginationContainer.querySelector('.search-goto-input') as HTMLInputElement;
            if (!input) return;
            const raw = input.value.trim();
            if (!raw) return;
            const p = parseInt(raw, 10);
            if (isNaN(p)) return;
            const lp = parseInt(input.getAttribute('data-last-page') || '1', 10);
            if (p < 1 || p > lp) return;
            renderPage(p);
            searchResults?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
        paginationContainer.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && (e.target as Element).closest('.search-goto-input')) {
            e.preventDefault();
            const input = e.target as HTMLInputElement;
            const raw = input.value.trim();
            if (!raw) return;
            const p = parseInt(raw, 10);
            if (isNaN(p)) return;
            const lp = parseInt(input.getAttribute('data-last-page') || '1', 10);
            if (p < 1 || p > lp) return;
            renderPage(p);
            searchResults?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }
    });
  }

  // Form submission
  const searchForm = searchInput?.closest('form');
  if (searchForm) {
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const newQuery = searchInput?.value.trim() || '';
      if (newQuery) {
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('q', newQuery);
        history.pushState({}, '', newUrl.toString());
        performSearch(newQuery);
      } else {
        showEmpty();
      }
    });
  }

  // Run search on page load
  const initialQuery = getQuery();
  if (initialQuery) {
    performSearch(initialQuery);
  } else {
    showEmpty();
  }
  }); // End astro:page-load
</script>
