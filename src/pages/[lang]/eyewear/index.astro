---
import ProductListingPage from '../../../components/pages/ProductListingPage.astro';
import { getCollection } from 'astro:content';
import { getTranslations, LANGUAGES } from '../../../translations';
import { cardSrc } from '../../../utils/image';

export async function getStaticPaths() {
  const allItems = await getCollection('feature');
  const languages = LANGUAGES.filter(l => l !== 'en');
  return languages.map((lang) => {
    const langItems = allItems.filter((item: any) => item.data.lang === lang);
    const sortedItems = langItems.sort((a: any, b: any) => {
      const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
      const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
      if (dateA !== dateB) return dateB - dateA;
      return b.id.localeCompare(a.id);
    });
    return { params: { lang }, props: { sortedItems, lang } };
  });
}

const { sortedItems, lang } = Astro.props;
const currentPath = lang + '/';
const PAGE_SIZE = 12;

const items = sortedItems.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(sortedItems.length / PAGE_SIZE);
const t = await getTranslations(lang);
const lcpImage = items[0]?.data?.image ? cardSrc(items[0].data.image) : undefined;

const breadcrumbItems = [
  { label: t.nav.home, href: '/' + lang },
  { label: t.nav.feature || 'Eyewear', href: '#' },
];
---

<ProductListingPage
  lang={lang}
  currentPath={currentPath}
  baseSegment="eyewear"
  products={items}
  allProducts={sortedItems}
  currentPage={1}
  totalPages={totalPages}
  basePath={'/' + currentPath + 'eyewear'}
  breadcrumbItems={breadcrumbItems}
  title={t.nav.feature || 'Eyewear'}
  lcpImage={lcpImage}
>
  <Fragment slot="cards">
    {items.map((item: any) => {
      const img = item.data.image || '/media/global/placeholder.webp';
      const slug = item.data.slug || item.id.split('/').pop()?.replace(/\.[a-z]{2}$/, '') || '';
      const href = `/${slug}/`;
      return (
        <a href={href} class="group bg-white rounded-xl shadow-sm border border-stone-200/50 overflow-hidden hover:shadow-md transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-100">
            <img src={img} alt={item.data.title || ''} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="300" loading="lazy" decoding="async" />
          </div>
          <div class="p-4">
            {item.data.category && (
              <span class="text-[10px] font-bold text-[#8B7355] uppercase tracking-wider">{item.data.category}</span>
            )}
            <h3 class="text-sm font-bold text-stone-900 mt-1 line-clamp-2 group-hover:text-[#5D4E37] transition-colors">{item.data.title}</h3>
          </div>
        </a>
      );
    })}
  </Fragment>
</ProductListingPage>