---
import ProductListingPage from '../../../components/pages/ProductListingPage.astro';
import { getCollection } from 'astro:content';
// import { getProductLang } 
import { cardSrc } from '../../../utils/image';
import { getTranslations, LANGUAGES } from '../../../translations';

export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const allProducts = await getCollection('feature');
  if (allProducts.length === 0) return [];
  const languages = LANGUAGES.filter(l => l !== 'en');
  return languages.flatMap((lang) => {
    const langProducts = allProducts.filter((p: any) => p.data.lang === lang);
    const sortedProducts = langProducts.sort((a: any, b: any) => {
      if (a.data.featured && !b.data.featured) return -1;
      if (!a.data.featured && b.data.featured) return 1;
      const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
      const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
      if (dateA !== dateB) return dateB - dateA;
      return b.id.localeCompare(a.id);
    });
    const total = Math.ceil(sortedProducts.length / PAGE_SIZE);
    return Array.from({ length: total }, (_, i) => ({
      params: { lang, page: String(i + 2) },
    }));
  });
}

const { lang, page } = Astro.params;
const currentPath = lang + '/';
const PAGE_SIZE = 12;

const allProducts = await getCollection('feature');
  if (allProducts.length === 0) return [];
const langProducts = allProducts.filter((p: any) => p.data.lang === lang);

const sortedProducts = langProducts.sort((a: any, b: any) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  if (dateA !== dateB) return dateB - dateA;
  return b.id.localeCompare(a.id);
});

const totalPages = Math.ceil(sortedProducts.length / PAGE_SIZE);
const pageNum = parseInt(page, 10);

if (pageNum < 2 || pageNum > totalPages) {
  return Astro.redirect('/' + lang + '/eyewear');
}

const start = (pageNum - 1) * PAGE_SIZE;
const items = sortedProducts.slice(start, start + PAGE_SIZE);

const t = await getTranslations(lang);
const lcpImage = items[0]?.data?.image ? cardSrc(items[0].data.image) : undefined;

const breadcrumbItems = [
  { label: t.nav.home, href: '/' + lang },
  { label: t.nav.feature || 'Eyewear', href: '/' + lang + '/eyewear' },
];
---

<ProductListingPage
  lang={lang}
  currentPath={currentPath}
  baseSegment="eyewear"
  products={items}
  allProducts={sortedProducts}
  currentPage={pageNum}
  totalPages={totalPages}
  basePath={'/' + currentPath + 'eyewear'}
  breadcrumbItems={breadcrumbItems}
  title={t.nav.feature || 'Eyewear'}
  lcpImage={lcpImage}
>
    <Fragment slot="cards">
    {items.map((item: any, index: number) => {
      const img = cardSrc(item.data.image || '/media/global/placeholder.webp');
      const isLcpCandidate = index === 0;
      const slug = item.data.slug || item.id.split('/').pop()?.replace(/\.[a-z]{2}$/, '') || '';
      const href = `/${currentPath}eyewear/${slug}/`;
      return (
        <a href={href} class="group bg-white rounded-xl shadow-xs border border-stone-200/50 overflow-hidden hover:shadow-md active:shadow-md focus-visible:shadow-md focus-within:shadow-md transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-100">
            <img src={img} alt={item.data.title || ''} class="w-full h-full object-cover group-hover:scale-105 group-active:scale-105 group-focus-visible:scale-105 group-focus-within:scale-105 transition-transform duration-500" width="400" height="300" loading={isLcpCandidate ? 'eager' : 'lazy'} decoding={isLcpCandidate ? 'sync' : 'async'} fetchpriority={isLcpCandidate ? 'high' : 'auto'} />
          </div>
          <div class="p-4">
            {item.data.category && (<span class="text-[10px] font-bold text-[#8B7355] uppercase tracking-wider">{item.data.category}</span>)}
            <h3 class="text-sm font-bold text-stone-900 mt-1 line-clamp-2 group-hover:text-[#5D4E37] group-active:text-[#5D4E37] group-focus-visible:text-[#5D4E37] group-focus-within:text-[#5D4E37] transition-colors">{item.data.title}</h3>
          </div>
        </a>
      );
    })}
  </Fragment></ProductListingPage>
