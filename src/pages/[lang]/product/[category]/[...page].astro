---
/**
 * Category Page (Multilingual)
 * Displays products filtered by a specific category
 * URL format: /[lang]/product/[category-slug] (e.g., /ko/product/luxury-glasses)
 *
 * IMPORTANT: All category URLs use English slugs for consistency across languages.
 * Products may have translated category names, but they map to English slugs.
 */

import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import { translations } from '../../../../translations';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { isCategoryMatch, getSlug } from '../../../../utils/categoryMatching';
import Pagination from '../../../../components/Pagination.astro';

// Category translation mapping: maps translated category names to English slugs
// Function to get canonical slug from any category name
function getCanonicalSlug(categoryName: string): string {
  return getSlug(categoryName);
}

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allProducts = await getCollection('products');

  // Dynamically derive categories from product series fields
  const allCategorySlugs = new Set<string>();
  for (const p of allProducts) {
    const series = p.data.series || p.data.categories || '';
    for (const cat of String(series).split(',')) {
      const slug = getSlug(cat.trim());
      if (slug) allCategorySlugs.add(slug);
    }
  }

  // Ensure all sidebar-navigable category slugs exist, even if no products match exactly
  const SIDEBAR_SLUGS = [
    'sunglasses', 'acetate-sunglasses', 'metal-sunglasses', 'titanium-sunglasses', 'carbon-fiber-sunglasses', 'rimless-sunglasses',
    'optical-frames', 'acetate-optical-frames', 'metal-optical-frames', 'titanium-optical-frames', 'carbon-fiber-optical-frames', 'rimless-optical-frames',
    'fashion-acetate-sunglasses', 'fashion-metal-sunglasses', 'fashion-acetate-optical-frames', 'fashion-metal-optical-frames',
    'luxury-acetate-sunglasses', 'luxury-titanium-sunglasses', 'luxury-acetate-optical-frames', 'luxury-titanium-optical-frames',
    'carbon-fiber-eyewear', 'rimless-eyewear',
  ];
  for (const s of SIDEBAR_SLUGS) allCategorySlugs.add(s);

  const languages = Object.keys(translations).filter(lang => lang !== 'en');

  const paths = [];

  // For each language, create pages for all dynamic categories
  for (const lang of languages) {
    // Get all products in this language
    const langProducts = allProducts.filter(p => {
      const normalizedId = p.id.replace(/\.md$/, '');
      const parts = normalizedId.split('.');
      const pLang = parts.length > 1 ? parts.pop() : 'en';
      return pLang === lang;
    });

    // For each dynamic category, find matching products
    for (const canonicalSlug of allCategorySlugs) {
      // Find products that map to this category
      const categoryProducts = langProducts.filter(p => {
        const cats = p.data.series || p.data.categories || '';
        return isCategoryMatch(cats, canonicalSlug);
      });

      // Create page if there are products OR if it's a sidebar-navigable slug
      if (categoryProducts.length > 0 || SIDEBAR_SLUGS.includes(canonicalSlug)) {
        const sorted = categoryProducts.sort((a, b) => {
          if (a.data.featured && !b.data.featured) return -1;
          if (!a.data.featured && b.data.featured) return 1;
          const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
          const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
          if (dateA !== dateB) return dateB - dateA;
          return b.id.localeCompare(a.id);
        });
        paths.push(...paginate(sorted, {
          params: { lang, category: canonicalSlug },
          pageSize: 12,
          props: { categorySlug: canonicalSlug, lang }
        }));
      }
    }
  }

  return paths;
}

const { page, categorySlug, lang } = Astro.props;
const products = page.data;
const t = translations[lang as keyof typeof translations] || translations.en;
type TranslationType = typeof translations.en;
const sidebar = (t as TranslationType).sidebar;
const currentPath = `${lang}/`;
const isRTL = lang === 'ar';

// First product cover for LCP preload
const lcpImage = (products[0] as any)?.data?.cover || undefined;

// Format category name for display (fallback)
let categoryTitle = categorySlug
  .split('-')
  .map((word: any) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');

// Get product translations
const pt = t.product || {
  viewAllCollections: "View All Collections",
  productsInCategory: "products in this category",
  allProducts: "All Products",
};

// Get all products for count
const allProducts = await getCollection('products');
const langProducts = allProducts.filter((product) => {
  const normalizedId = product.id.replace(/\.md$/, '');
  const parts = normalizedId.split('.');
  const productLang = parts.length > 1 ? parts.pop() : 'en';
  return productLang === lang;
});

// Helper for category counts
function getCategoryCount(href: string): number {
  const pathWithoutQuery = href.split('?')[0];
  const targetSlug = pathWithoutQuery.split('/').pop() || '';
  return langProducts.filter(p => {
    const cats = p.data.series || p.data.categories || [];
    return isCategoryMatch(cats, targetSlug);
  }).length;
}

// Sidebar Categories - Matches Header Mega Menu Structure
// Primary Categories (Hierarchical)
const primaryCategories = [
  {
    label: sidebar.sunglasses,
    href: `/${currentPath}product/sunglasses`,
    items: [
      { label: sidebar.acetate_sunglasses, href: `/${currentPath}product/acetate-sunglasses` },
      { label: sidebar.metal_sunglasses, href: `/${currentPath}product/metal-sunglasses` },
      { label: sidebar.titanium_sunglasses, href: `/${currentPath}product/titanium-sunglasses` },
      { label: sidebar.carbon_fiber_sunglasses, href: `/${currentPath}product/carbon-fiber-sunglasses` },
      { label: sidebar.rimless_sunglasses, href: `/${currentPath}product/rimless-sunglasses` }
    ]
  },
  {
    label: sidebar.optical_frames,
    href: `/${currentPath}product/optical-frames`,
    items: [
      { label: sidebar.acetate_glasses, href: `/${currentPath}product/acetate-optical-frames` },
      { label: sidebar.metal_glasses, href: `/${currentPath}product/metal-optical-frames` },
      { label: sidebar.titanium_glasses, href: `/${currentPath}product/titanium-optical-frames` },
      { label: sidebar.carbon_glasses, href: `/${currentPath}product/carbon-fiber-optical-frames` },
      { label: sidebar.rimless_glasses, href: `/${currentPath}product/rimless-optical-frames` }
    ]
  }
];

// Tags / Filters (Flat Groups)
const sidebarTags = [
  {
    label: sidebar.fashion_group || sidebar.fashion,
    href: `/${currentPath}product/fashion-eyewear`,
    items: [
      { label: sidebar.fashion_acetate_sunglasses, href: `/${currentPath}product/fashion-acetate-sunglasses` },
      { label: sidebar.fashion_metal_sunglasses, href: `/${currentPath}product/fashion-metal-sunglasses` },
      { label: sidebar.fashion_acetate_glasses, href: `/${currentPath}product/fashion-acetate-optical-frames` },
      { label: sidebar.fashion_metal_glasses, href: `/${currentPath}product/fashion-metal-optical-frames` }
    ]
  },
  {
    label: sidebar.luxury_group || sidebar.luxury,
    href: `/${currentPath}product/luxury-eyewear`,
    items: [
      { label: sidebar.luxury_acetate_sunglasses, href: `/${currentPath}product/luxury-acetate-sunglasses` },
      { label: sidebar.luxury_titanium_sunglasses, href: `/${currentPath}product/luxury-titanium-sunglasses` },
      { label: sidebar.luxury_acetate_glasses, href: `/${currentPath}product/luxury-acetate-optical-frames` },
      { label: sidebar.luxury_titanium_glasses, href: `/${currentPath}product/luxury-titanium-optical-frames` }
    ]
  },
  {
    label: sidebar.carbon_fiber_group || sidebar.carbon_fiber,
    href: `/${currentPath}product/carbon-fiber-eyewear`,
    items: [
      { label: sidebar.carbon_fiber_sunglasses, href: `/${currentPath}product/carbon-fiber-sunglasses` },
      { label: sidebar.carbon_glasses, href: `/${currentPath}product/carbon-fiber-optical-frames` }
    ]
  },
  {
    label: sidebar.rimless_group || sidebar.rimless,
    href: `/${currentPath}product/rimless-eyewear`,
    items: [
      { label: sidebar.rimless_sunglasses, href: `/${currentPath}product/rimless-sunglasses` },
      { label: sidebar.rimless_glasses, href: `/${currentPath}product/rimless-optical-frames` }
    ]
  }
];



// Check if current category matches any in sidebar
function isActiveCategory(href: string): boolean {
  const pathWithoutQuery = href.split('?')[0];
  const hrefSlug = pathWithoutQuery.replace(`/${currentPath}product/`, '').replace('/product/', '');
  return hrefSlug === categorySlug;
}

// Find localized category title from sidebar definitions
// First check primary categories
for (const cat of primaryCategories) {
  if (isActiveCategory(cat.href)) {
    categoryTitle = cat.label;
    break;
  }
  const sub = cat.items.find(s => isActiveCategory(s.href));
  if (sub) {
    categoryTitle = sub.label;
    break;
  }
}
// Then check sidebar tags if no match found
if (categoryTitle === categorySlug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')) {
  for (const tag of sidebarTags) {
    if (isActiveCategory(tag.href)) {
      categoryTitle = tag.label;
      break;
    }
  }
}

// Build breadcrumb items
const categoryBreadcrumbItems = (() => {
  const items: Array<{ label: string; href: string }> = [
    { label: t.nav.home, href: `/${lang}` },
    { label: t.nav.products || 'Products', href: `/${lang}/product` },
  ];
  for (const cat of primaryCategories) {
    if (isActiveCategory(cat.href)) {
      items.push({ label: cat.label, href: '#' });
      return items;
    }
    for (const sub of cat.items) {
      if (isActiveCategory(sub.href)) {
        items.push({ label: cat.label, href: cat.href });
        items.push({ label: sub.label, href: '#' });
        return items;
      }
    }
  }
  for (const group of sidebarTags) {
    if (isActiveCategory(group.href)) {
      items.push({ label: group.label, href: '#' });
      return items;
    }
    for (const item of group.items) {
      if (isActiveCategory(item.href)) {
        items.push({ label: group.label, href: group.href });
        items.push({ label: item.label, href: '#' });
        return items;
      }
    }
  }
  items.push({ label: categoryTitle, href: '#' });
  return items;
})();
---

<Layout title={`${categoryTitle} - ${t.nav.products}`} lang={lang} lcpImage={lcpImage}>
  <Header lang={lang} />
  <Breadcrumb items={categoryBreadcrumbItems} lang={lang} />

  <main class="w-full min-h-screen py-6 lg:py-8 bg-stone-50">
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar -->
        <aside class="hidden lg:block lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="bg-gradient-to-br from-white to-[#faf8f5] rounded-xl shadow-sm p-6 border border-stone-200/50">
              <!-- All Products Link - Page Title -->
              <div class="flex items-center mb-3">
                <a href={`/${currentPath}product`} class="flex-1 text-base lg:text-lg font-bold text-[#5D4E37] hover:underline">
                  {sidebar.all_products}
                </a>
                <span class="text-xs font-normal text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">
                  {langProducts.length}
                </span>
              </div>

              <div class="space-y-3">
                {primaryCategories.map((cat) => (
                  <div class="border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                    <a
                      href={cat.href}
                      class={`flex items-center justify-between py-2 px-2 text-sm font-bold rounded-lg transition-colors ${
                        isActiveCategory(cat.href)
                          ? 'bg-[#5D4E37] text-white'
                          : 'text-[#5D4E37] hover:bg-stone-50'
                      }`}
                    >
                      <span class="flex items-center gap-2">
                        {cat.label}
                        <span class={`text-xs font-normal px-2 py-0.5 rounded-full ${
                          isActiveCategory(cat.href) ? 'bg-white/20 text-white' : 'bg-gray-100 text-gray-600'
                        }`}>{getCategoryCount(cat.href)}</span>
                      </span>
                      <svg class={`w-4 h-4 ${isActiveCategory(cat.href) ? 'text-white/70' : 'text-gray-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                    <ul class="ms-3 mt-1 space-y-1">
                      {cat.items.map((sub) => (
                        <li>
                          <a
                            href={sub.href}
                            class={`flex items-center justify-between py-1.5 px-2 text-sm rounded transition-colors ${
                              isActiveCategory(sub.href)
                                ? 'bg-[#5D4E37] text-white'
                                : 'text-gray-600 hover:text-[#5D4E37] hover:bg-stone-50'
                            }`}
                          >
                            <span>{sub.label}</span>
                            <span class={`text-xs ${
                              isActiveCategory(sub.href) ? 'text-white/90' : 'text-gray-400'
                            }`}>{getCategoryCount(sub.href)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <div class="mt-8 pt-6 border-t border-gray-100">
                <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-4">{sidebar.tags_filters}</h4>
                <div class="space-y-6">
                  {sidebarTags.map((group) => (
                    <div>
                      <a href={group.href} class="text-sm font-bold text-gray-900 mb-2.5 flex items-center hover:text-[#5D4E37] transition-colors">
                        <span class="text-[#5D4E37] mr-1">#</span> {group.label}
                      </a>
                      <div class="flex flex-col gap-1.5">
                        {group.items.map((tag) => {
                          const isActive = isActiveCategory(tag.href);
                          return (
                            <a
                              href={tag.href}
                              class={`px-3 py-1.5 text-[11px] font-bold rounded-md border transition-all duration-200 w-full ${
                                isActive
                                  ? 'bg-[#5D4E37] text-white border-[#8B7355] shadow-md'
                                  : 'bg-white text-stone-600 border-stone-200 hover:border-[#8B7355] hover:text-[#5D4E37] hover:bg-stone-50'
                              }`}
                            >
                              {tag.label}
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="bg-[#5D4E37] rounded-xl p-6 text-white">
              <h4 class="font-bold mb-2">{pt.needCustomEyewear || 'Need Custom Eyewear?'}</h4>
              <p class="text-sm text-white mb-4">
                {pt.oemServices || 'We offer full OEM & ODM services for your brand.'}
              </p>
              <a
                href={`/${currentPath}quote`}
                class="inline-block bg-white text-[#5D4E37] px-4 py-2 rounded-lg text-sm font-semibold hover:bg-gray-100 transition-colors"
              >
                {t.cta.quote || 'Get Quote'}
              </a>
            </div>
          </div>
        </aside>

        <!-- Product Grid -->
        <div class="col-span-1 lg:col-span-3">
          {page.total === 0 ? (
            <div class="text-center py-16 bg-white rounded-xl shadow-sm">
              <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
              <p class="text-gray-500 mb-4">No products in this category.</p>
              <a href={`/${currentPath}product`} class="text-[#5D4E37] hover:underline">View All Products</a>
            </div>
          ) : (
            <>
              <!-- Results Info -->
              <div class="flex justify-between items-center mb-6 text-sm text-gray-500">
                <span>
                  {(pt.showingResults || 'Showing {start}-{end} of {total} products')
                    .replace('{start}', String(page.start + 1))
                    .replace('{end}', String(Math.min(page.end, page.total)))
                    .replace('{total}', String(page.total))}
                </span>
              </div>

              <div class="grid grid-cols-2 xl:grid-cols-3 gap-4 xl:gap-6">
                {products.map((product: any, index: number) => (
                  <ProductCard product={product} lang={lang} index={index} />
                ))}
              </div>

              <Pagination
                currentPage={page.currentPage}
                lastPage={page.lastPage}
                basePath={`/${currentPath}product`}
                categorySlug={categorySlug}
                prevUrl={page.url.prev}
                nextUrl={page.url.next}
                prevLabel={pt.previousPage || 'Previous'}
                nextLabel={pt.nextPage || 'Next'}
              />
            </>
          )}
        </div>
      </div>

      <!-- Back to All -->
      <div class="mt-12 text-center">
        <a
          href={`/${currentPath}product`}
          class="inline-flex items-center gap-2 text-[#5D4E37] hover:text-[#5D4E37] font-medium transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          {pt.viewAllCollections}
        </a>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
