---
// Keep the existing placeholder available when its language selector is used.
// Content and its noindex policy remain in the shared collection page.
import CollectionPage from '../../collection/index.astro';

export function getStaticPaths() {
  const languages = ['it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
  return languages.map(lang => ({ params: { lang } }));
}
---
<CollectionPage />
