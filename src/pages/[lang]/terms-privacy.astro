---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { translations } from '../../translations';

export async function getStaticPaths() {
  const languages = ['it', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'tr', 'ar', 'ko', 'zh', 'hi', 'vi', 'jv', 'ms', 'tg'];
  return languages.map((lang) => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;

const langPrefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout title="Page Not Found | Kssmi Eyewear" lang={lang} noindex={true}>
  <Header lang={lang} />

  <main class="min-h-[60vh] flex items-center justify-center bg-gradient-to-b from-stone-50 to-white">
    <meta http-equiv="refresh" content={`0;url=${langPrefix}/404/`} />
    <div class="text-center">
      <div class="text-6xl font-bold text-stone-300 mb-4">404</div>
      <p class="text-stone-500">Redirecting...</p>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
