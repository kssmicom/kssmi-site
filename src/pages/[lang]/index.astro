---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { translations } from '../../translations';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import S00_Hero from '../../components/collection/home/S00_Hero.astro';
import Materials from '../../components/collection/home/Materials.astro';
import Construction from '../../components/collection/home/Construction.astro';
import S03_FrameShape from '../../components/collection/home/S03_FrameShape.astro';
import S04_FrameStyle from '../../components/collection/home/S04_FrameStyle.astro';
import S05_FrameColor from '../../components/collection/home/S05_Frame_Color.astro';
import S06_FrameSurfaceFinish from '../../components/collection/home/S06_FrameSurfaceFinish.astro';

// Generate all language routes
export async function getStaticPaths() {
  const languages = ['it', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'tr', 'ar', 'ko', 'zh', 'hi', 'vi', 'jv', 'ms', 'tg'];
  return languages.map((lang) => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;
const t = translations[lang] || translations.en;
const isRTL = lang === 'ar';

// Read the merged single file
const entry = await getEntry('collection', `home/home.${lang}`);

const title = entry?.data?.seoTitle || "Kssmi - Premium Eyewear & Sunglasses Manufacturer";
const description = entry?.data?.seoDescription || "Premium eyewear manufacturer in China.";

// LCP preload: the hero (S00) is the first paint — preload its full-bleed poster.
const heroEntry = await getEntry('collection', `home/s00-hero.${lang}`);
const lcpImage = heroEntry?.data?.posterImage;
---

<Layout title={title} description={description} lang={lang} image={"/media/global/404-team.webp"} lcpImage={lcpImage} preconnectVideo={true}>
  <Header lang={lang} />

  <main dir={isRTL ? 'rtl' : 'ltr'}>
    <S00_Hero lang={lang} />
    <Materials lang={lang} />
    <Construction lang={lang} />
    <S03_FrameShape lang={lang} />
    <S04_FrameStyle lang={lang} />
    <S05_FrameColor lang={lang} />
    <S06_FrameSurfaceFinish lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
