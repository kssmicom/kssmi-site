---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const languages = ['it', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'tr', 'ar', 'ko', 'zh', 'hi', 'vi', 'jv', 'ms', 'tg'];
  return languages.map((lang) => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;

const i18n = {
  en: { title: 'About Us', heading: 'About Us', underConstruction: 'This page is under construction.', message: "We're working on something great. In the meantime, explore our full catalog of precision-crafted eyewear.", browseProducts: 'Browse Products', backToHome: 'Back to Home' },
  it: { title: 'Chi Siamo', heading: 'Chi Siamo', underConstruction: 'Questa pagina è in costruzione.', message: 'Stiamo lavorando a qualcosa di grandioso. Nel frattempo, esplora il nostro catalogo completo di occhiali di precisione.', browseProducts: 'Sfoglia Prodotti', backToHome: 'Torna alla Home' },
  es: { title: 'Sobre Nosotros', heading: 'Sobre Nosotros', underConstruction: 'Esta página está en construcción.', message: 'Estamos trabajando en algo grandioso. Mientras tanto, explora nuestro catálogo completo de gafas de precisión.', browseProducts: 'Explorar Productos', backToHome: 'Volver al Inicio' },
  fr: { title: 'À Propos', heading: 'À Propos', underConstruction: 'Cette page est en construction.', message: 'Nous travaillons sur quelque chose de grand. En attendant, explorez notre catalogue complet de lunettes de précision.', browseProducts: 'Parcourir les Produits', backToHome: "Retour à l'Accueil" },
  de: { title: 'Über Uns', heading: 'Über Uns', underConstruction: 'Diese Seite befindet sich im Aufbau.', message: 'Wir arbeiten an etwas Großartigem. Erkunden Sie in der Zwischenzeit unseren vollständigen Katalog an Präzisionsbrillen.', browseProducts: 'Produkte Durchsuchen', backToHome: 'Zurück zur Startseite' },
  pt: { title: 'Sobre Nós', heading: 'Sobre Nós', underConstruction: 'Esta página está em construção.', message: 'Estamos a trabalhar em algo grandioso. Entretanto, explore o nosso catálogo completo de óculos de precisão.', browseProducts: 'Explorar Produtos', backToHome: 'Voltar ao Início' },
  ru: { title: 'О Нас', heading: 'О Нас', underConstruction: 'Эта страница находится в разработке.', message: 'Мы работаем над чем-то великим. А пока ознакомьтесь с нашим полным каталогом высокоточных очков.', browseProducts: 'Смотреть Товары', backToHome: 'Вернуться на Главную' },
  ja: { title: '会社概要', heading: '会社概要', underConstruction: 'このページは準備中です。', message: '現在、より良いものを準備しています。その間、精密に作られたアイウェアの全カタログをご覧ください。', browseProducts: '製品を見る', backToHome: 'ホームに戻る' },
  tr: { title: 'Hakkımızda', heading: 'Hakkımızda', underConstruction: 'Bu sayfa yapım aşamasındadır.', message: 'Harika bir şey üzerinde çalışıyoruz. Bu arada, hassas işçilikle üretilmiş gözlük kataloğumuzu keşfedin.', browseProducts: 'Ürünlere Göz At', backToHome: 'Ana Sayfaya Dön' },
  ar: { title: 'من نحن', heading: 'من نحن', underConstruction: 'هذه الصفحة قيد الإنشاء.', message: 'نحن نعمل على شيء رائع. في الوقت الحالي، استكشف كتالوجنا الكامل من النظارات المصنوعة بدقة.', browseProducts: 'تصفح المنتجات', backToHome: 'العودة للرئيسية' },
  ko: { title: '회사 소개', heading: '회사 소개', underConstruction: '이 페이지는 준비 중입니다.', message: '멋진 것을 준비하고 있습니다. 그동안 정밀하게 제작된 안경 전체 카탈로그를 둘러보세요.', browseProducts: '제품 보기', backToHome: '홈으로 돌아가기' },
  zh: { title: '关于我们', heading: '关于我们', underConstruction: '此页面正在建设中。', message: '我们正在打造精彩内容。与此同时，欢迎浏览我们的精密工艺眼镜全系列产品。', browseProducts: '浏览产品', backToHome: '返回首页' },
  hi: { title: 'हमारे बारे में', heading: 'हमारे बारे में', underConstruction: 'यह पृष्ठ निर्माणाधीन है।', message: 'हम कुछ शानदार पर काम कर रहे हैं। तब तक, हमारे सटीकता से निर्मित चश्मों की पूरी सूची देखें।', browseProducts: 'उत्पाद देखें', backToHome: 'होम पर वापस जाएं' },
  vi: { title: 'Về Chúng Tôi', heading: 'Về Chúng Tôi', underConstruction: 'Trang này đang được xây dựng.', message: 'Chúng tôi đang xây dựng điều gì đó tuyệt vời. Trong lúc chờ đợi, hãy khám phá danh mục kính mắt chế tác chính xác của chúng tôi.', browseProducts: 'Xem Sản Phẩm', backToHome: 'Về Trang Chủ' },
  jv: { title: 'Babagan Kita', heading: 'Babagan Kita', underConstruction: 'Kaca iki lagi digawe.', message: 'Kita lagi nggarap sing apik. Saiki, delengen katalog kaca mata presisi lengkap kita.', browseProducts: 'Deleng Produk', backToHome: 'Balik menyang Kaca Utama' },
  ms: { title: 'Tentang Kami', heading: 'Tentang Kami', underConstruction: 'Halaman ini sedang dalam pembinaan.', message: 'Kami sedang membangun sesuatu yang hebat. Sementara itu, terokai katalog penuh cermin mata ketepatan kami.', browseProducts: 'Lihat Produk', backToHome: 'Kembali ke Laman Utama' },
  tg: { title: 'Дар Бораи Мо', heading: 'Дар Бораи Мо', underConstruction: 'Ин саҳифа дар ҳоли сохташавӣ аст.', message: 'Мо дар болои чизи бузурге кор карда истодаем. Дар ин муддат, феҳристи пурраи айнакҳои дақиқи моро аз назар гузаронед.', browseProducts: 'Маҳсулотро Дидан', backToHome: 'Ба Саҳифаи Асосӣ Бозгашт' },
};

const t = i18n[lang] || i18n.en;
const isRTL = lang === 'ar';
---

<Layout title={`${t.title} | Kssmi Eyewear`} lang={lang} noindex={true}>
  <Header lang={lang} />

  <main class="w-full min-h-[70vh] bg-stone-50 pt-12 pb-24 flex items-center" dir={isRTL ? 'rtl' : 'ltr'}>
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[820px] mx-auto px-4 text-center">
      <div class="inline-flex flex-col items-center justify-center mb-8">
        <span class="text-3xl font-bold text-[#503629] tracking-tight leading-none uppercase">KSSMI</span>
        <span class="h-[2px] w-8 bg-[#503629] mt-1.5"></span>
        <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-[#503629] mt-1.5">Eyewear Mfg.</span>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold text-[#5D4E37] mb-4 tracking-tight">{t.heading}</h1>

      <div class="inline-flex items-center justify-center w-16 h-16 bg-white border border-stone-200 rounded-full mb-8 shadow-sm">
        <svg class="w-6 h-6 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </div>

      <p class="text-lg text-stone-600 mb-3 font-medium">{t.underConstruction}</p>
      <p class="text-base text-stone-600 mb-10 max-w-md mx-auto">{t.message}</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`/${lang}/product/`} class="inline-flex items-center px-8 py-3 bg-[#5D4E37] text-white font-bold uppercase tracking-wider text-xs rounded-full hover:bg-[#4A3D2E] transition-colors duration-300 shadow-lg">
          {t.browseProducts}
        </a>
        <a href={`/${lang}/`} class="inline-flex items-center px-8 py-3 border-2 border-[#5D4E37] text-[#5D4E37] font-bold uppercase tracking-wider text-xs rounded-full hover:bg-[#5D4E37] hover:text-white transition-all duration-300">
          {t.backToHome}
        </a>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
