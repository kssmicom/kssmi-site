---
import ProductCategoryPage from '../../../../components/pages/ProductCategoryPage.astro';
import { getCollection } from 'astro:content';
import { getTranslations, LANGUAGES, type Translations } from '../../../../translations';
import { isCategoryMatch, getSlug } from '../../../../utils/categoryMatching';
import { cardSrc } from '../../../../utils/image';
// import { getProductLang } from '../../../../utils/language';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allProducts = await getCollection('blog');
  if (allProducts.length === 0) return [];

  const allCategorySlugs = new Set<string>();
  for (const p of allProducts) {
    const series = p.data.series || p.data.categories || '';
    for (const cat of String(series).split(',')) {
      const slug = getSlug(cat.trim());
      if (slug) allCategorySlugs.add(slug);
    }
  }


  const languages = LANGUAGES.filter(l => l !== 'en');
  const paths = [];

  for (const lang of languages) {
    const langProducts = allProducts.filter(p => p.data.lang === lang);
    for (const canonicalSlug of allCategorySlugs) {
      const categoryProducts = langProducts.filter(p => {
        const cats = p.data.series || p.data.categories || '';
        return isCategoryMatch(cats, canonicalSlug);
      });
      if (categoryProducts.length > 0 ) {
        const sorted = categoryProducts.sort((a: any, b: any) => {
          if (a.data.featured && !b.data.featured) return -1;
          if (!a.data.featured && b.data.featured) return 1;
          const dateA = a.data.published ? new Date(a.data.published).getTime() : 0;
          const dateB = b.data.published ? new Date(b.data.published).getTime() : 0;
          if (dateA !== dateB) return dateB - dateA;
          return b.id.localeCompare(a.id);
        });
        paths.push(...paginate(sorted, {
          params: { lang, category: canonicalSlug },
          pageSize: 12,
          props: { categorySlug: canonicalSlug, lang }
        }));
      }
    }
  }
  return paths;
}

const { page, categorySlug, lang } = Astro.props;
const allProducts = await getCollection('blog');
const currentPath = lang + '/';

// Filter to current language
const langProducts = (allProducts || []).filter((p: any) => {
  const pLang = p.id.split('.').pop();
  return (pLang && pLang.length === 2) ? pLang === lang : lang === 'en';
});
---

<ProductCategoryPage lang={lang} currentPath={currentPath} categorySlug={categorySlug} page={page} langProducts={langProducts} allProducts={allProducts} baseSegment="blog">
    <Fragment slot="cards">
    {page.data.map((item: any, index: number) => {
      const img = cardSrc(item.data.image || '/media/global/placeholder.webp');
      const isLcpCandidate = index === 0;
      const itemSlug = item.data.slug || item.id.split('/').pop()?.replace(/\.[a-z]{2}$/, '') || '';
      const href = `/${currentPath}blog/${itemSlug}/`;
      return (
        <a href={href} class="group bg-white rounded-xl shadow-xs border border-stone-200/50 overflow-hidden hover:shadow-md transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-100">
            <img src={img} alt={item.data.title || ''} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="300" loading={isLcpCandidate ? 'eager' : 'lazy'} decoding={isLcpCandidate ? 'sync' : 'async'} fetchpriority={isLcpCandidate ? 'high' : 'auto'} />
          </div>
          <div class="p-4">
            {item.data.category && (<span class="text-[10px] font-bold text-[#8B7355] uppercase tracking-wider">{item.data.category}</span>)}
            <h3 class="text-sm font-bold text-stone-900 mt-1 line-clamp-2 group-hover:text-[#5D4E37] transition-colors">{item.data.title}</h3>
            {item.data.excerpt && (<p class="text-xs text-stone-600 mt-2 line-clamp-2">{item.data.excerpt}</p>)}
          </div>
        </a>
      );
    })}
  </Fragment></ProductCategoryPage>
