---
/**
 * Blog Listing Pagination Pages (Multilingual)
 * Catches: /it/blog/2, /fr/blog/3, etc.
 */

import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { translations } from '../../../translations';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { isCategoryMatch } from '../../../utils/categoryMatching';
import { buildPrimaryCategories, buildSidebarTags } from '../../../utils/sidebar';
import { cardSrc } from '../../../utils/image';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Pagination from '../../../components/Pagination.astro';

const baseSegment = 'blog';

export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const allItems = await getCollection('blog');
  const languages = Object.keys(translations).filter(lang => lang !== 'en');

  return languages.flatMap((lang) => {
    const langItems = allItems.filter((item) => item.data.lang === lang);

    const sortedItems = langItems.sort((a, b) => {
      const dateA = a.data.published ? new Date(a.data.published).getTime() : 0;
      const dateB = b.data.published ? new Date(b.data.published).getTime() : 0;
      if (dateA !== dateB) return dateB - dateA;
      return b.id.localeCompare(a.id);
    });

    const total = Math.ceil(sortedItems.length / PAGE_SIZE);
    return Array.from({ length: total - 1 }, (_, i) => ({
      params: { lang, page: String(i + 2) },
    }));
  });
}

const { lang, page } = Astro.params;

const PAGE_SIZE = 12;
const allItems = await getCollection('blog');

const langItems = allItems.filter((item) => item.data.lang === lang);

const sortedItems = langItems.sort((a, b) => {
  const dateA = a.data.published ? new Date(a.data.published).getTime() : 0;
  const dateB = b.data.published ? new Date(b.data.published).getTime() : 0;
  if (dateA !== dateB) return dateB - dateA;
  return b.id.localeCompare(a.id);
});

const totalPages = Math.ceil(sortedItems.length / PAGE_SIZE);
const pageNum = parseInt(page, 10);

if (pageNum < 2 || pageNum > totalPages) {
  return Astro.redirect(`/${lang}/blog`);
}

const start = (pageNum - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;
const items = sortedItems.slice(start, end);

const t = translations[lang as keyof typeof translations] || translations.en;
const pt = t.product || {
  viewAllCollections: "View All Collections",
};
const currentPath = `${lang}/`;
const isRTL = lang === 'ar';

const lcpImage = items[0]?.data?.image ? cardSrc(items[0].data.image) : undefined;

const primaryCategories = buildPrimaryCategories(t, currentPath, baseSegment);

const sidebarTags = buildSidebarTags(t, currentPath, baseSegment);

const breadcrumbItems = [
  { label: t.nav.home, href: `/${lang}` },
  { label: t.nav.blog || 'Blog', href: '#' },
];

function getCategoryCount(href: string): number {
  const targetSlug = href.split('/').pop() || '';
  return langItems.filter((item) => {
    const cat = item.data.category || '';
    return isCategoryMatch(cat, targetSlug);
  }).length;
}
---

<Layout noHreflang title={`${t.nav.blog} - Page ${pageNum}`} lang={lang} lcpImage={lcpImage}>
  <Header lang={lang} />
  <Breadcrumb items={breadcrumbItems} lang={lang} />

  <main class="w-full min-h-screen py-6 lg:py-8 bg-stone-50" dir={isRTL ? 'rtl' : 'ltr'}>
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar -->
        <aside class="hidden lg:block lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="bg-gradient-to-br from-white to-[#faf8f5] rounded-xl shadow-sm p-6 border border-stone-200/50">
              <!-- All Posts Link - Page Title (Active) -->
              <a href={`/${currentPath}blog`} class="flex items-center justify-between py-1.5 px-2 text-sm lg:text-base font-bold bg-[#5D4E37] text-white rounded-lg mb-3">
                <span>{t.sidebar.all_posts}</span>
                <span class="text-xs font-normal text-white/70">{langItems.length}</span>
              </a>

              <div class="space-y-3">
                {primaryCategories.map((cat) => (
                  <div class="border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                    <a
                      href={cat.href}
                      class="flex items-center justify-between py-2 px-2 text-sm font-bold text-[#5D4E37] hover:bg-stone-50 rounded-lg transition-colors"
                    >
                      <span>{cat.label}</span>
                      <span class="text-xs text-gray-500">{getCategoryCount(cat.href)}</span>
                    </a>
                    <ul class="ml-3 mt-1 space-y-1">
                      {cat.items.map((sub) => (
                        <li>
                          <a
                            href={sub.href}
                            class="flex items-center justify-between py-1.5 px-2 text-sm text-gray-600 hover:text-[#5D4E37] hover:bg-stone-50 rounded transition-colors"
                          >
                            <span>{sub.label}</span>
                            <span class="text-xs text-gray-500">{getCategoryCount(sub.href)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <div class="mt-8 pt-6 border-t border-gray-100">
                <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-4">{t.sidebar.tags_filters}</h4>
                <div class="space-y-6">
                  {sidebarTags.map((group) => (
                    <div>
                      <a href={group.href} class="text-sm font-bold text-gray-900 mb-2.5 flex items-center hover:text-[#5D4E37] transition-colors">
                        <span class="text-[#5D4E37] mr-1">#</span> {group.label}
                      </a>
                      <div class="flex flex-col gap-1.5">
                        {group.items.map((tag) => (
                          <a
                            href={tag.href}
                            class="px-3 py-1.5 text-[11px] font-bold rounded-md border bg-stone-50 text-stone-600 border-stone-200 hover:border-[#8B7355] hover:text-[#5D4E37] hover:bg-stone-100 transition-all duration-200 w-full"
                          >
                            {tag.label}
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="bg-[#5D4E37] rounded-xl p-6 text-white">
              <h4 class="font-bold mb-2">{pt.needCustomEyewear || 'Need Custom Eyewear?'}</h4>
              <p class="text-sm text-white mb-4">
                {pt.oemServices || 'We offer full OEM & ODM services for your brand.'}
              </p>
              <a
                href={`/${currentPath}quote`}
                class="inline-block bg-white text-[#5D4E37] px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300 hover:scale-105 hover:shadow-lg"
              >
                {t.cta.quote || 'Get Quote'}
              </a>
            </div>
          </div>
        </aside>

        <!-- Blog Grid -->
        <div class="col-span-1 lg:col-span-3">
          <h1 class="text-base lg:text-lg font-bold text-stone-900 mb-3">{t.nav.blog} —{t.pagination?.page || 'Page'} {pageNum}</h1>
          {items.length === 0 ? (
            <div class="text-center py-16 bg-white rounded-xl shadow-sm">
              <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
              <p class="text-gray-500 mb-4">{t.blog?.emptyState || 'No blog posts yet. Check back soon!'}</p>
              <a href={`/${currentPath}`} class="text-[#5D4E37] hover:underline">
                {pt.returnHome || 'Return to Homepage'}
              </a>
            </div>
          ) : (
            <>
              <div class="flex justify-between items-center mb-3 text-sm text-gray-500">
                <span>
                  {(pt.showingResults || 'Showing {start}-{end} of {total} posts').replace('{start}', String(start + 1)).replace('{end}', String(Math.min(end, langItems.length))).replace('{total}', String(langItems.length))}
                </span>
              </div>

              <div class="grid grid-cols-2 xl:grid-cols-3 gap-4 xl:gap-6">
                {items.map((item: any) => {
                  const img = item.data.image || '/media/global/placeholder.webp';
                  const itemSlug = item.data.slug || item.id.split('/').pop()?.replace(/\.[a-z]{2}$/, '') || '';
                  const href = `/${currentPath}blog/${itemSlug}/`;
                  return (
                    <a href={href} class="group bg-white rounded-xl shadow-sm border border-stone-200/50 overflow-hidden hover:shadow-md transition-all duration-300">
                      <div class="aspect-[4/3] overflow-hidden bg-stone-100">
                        <img src={img} alt={item.data.title || ''} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width="400" height="300" loading="lazy" decoding="async" />
                      </div>
                      <div class="p-4">
                        {item.data.category && (
                          <span class="text-[10px] font-bold text-[#8B7355] uppercase tracking-wider">{item.data.category}</span>
                        )}
                        <h3 class="text-sm font-bold text-stone-900 mt-1 line-clamp-2 group-hover:text-[#5D4E37] transition-colors">{item.data.title}</h3>
                        {item.data.excerpt && (
                          <p class="text-xs text-stone-600 mt-2 line-clamp-2">{item.data.excerpt}</p>
                        )}
                      </div>
                    </a>
                  );
                })}
              </div>

              <Pagination
                currentPage={pageNum}
                lastPage={totalPages}
                basePath={`/${currentPath}blog`}
                prevLabel={pt.previousPage || 'Previous'}
                nextLabel={pt.nextPage || 'Next'}
              />
            </>
          )}
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
