---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { translations } from '../../../translations';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  let allPosts: any[] = [];
  try {
    const maybePosts = await getCollection('blog');
    if (maybePosts) allPosts = maybePosts;
  } catch (e) {
    // Collection might be empty or missing during initial setup
    if (import.meta.env.DEV) console.warn(`Blog collection empty or missing: ${e}`);
  }
  const languages = ['it', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'tr', 'ar', 'ko', 'zh', 'hi', 'vi', 'jv', 'ms', 'tg'];

  return languages.map((lang) => {
    const langPosts = allPosts.filter((post) => {
      const postLang = post.data.lang || 'en';
      return postLang === lang;
    });

    return {
      params: { lang },
      props: { posts: langPosts, lang }  // Pass lang in props too!
    };
  });
}

const { posts, lang } = Astro.props;

const t = (translations as any)[lang] || translations.en;

const isRTL = lang === 'ar';

const currentPath = `${lang}/`;
---

<Layout title={t.nav.blog} lang={lang}>
  <Header lang={lang} />

  <!-- LAYER 1: WRAPPER -->
  <main class="w-full min-h-screen py-12 lg:py-20 border-b border-stone-100 relative z-10" dir={isRTL ? 'rtl' : 'ltr'}>
    <!-- LAYER 2: CONSTRAINT -->
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1860px] mx-auto px-4">
      <!-- LAYER 3: BLOCK -->
      <h1 class="text-4xl md:text-5xl font-bold mb-12 text-center">{t.nav.blog}</h1>

      <!-- Blog Grid -->
      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-gray-600">{t.blog?.emptyState || 'No blog posts yet. Check back soon!'}</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {posts.map((post) => (
            <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-200">
              <a href={`/${currentPath}blog/${post.slug}`} class="block">
                {post.data.image && (
                  <div class="relative aspect-[16/9] overflow-hidden bg-gray-100">
                    <img
                      src={post.data.image}
                      alt={post.title}
                      class="w-full h-full object-cover motion-safe:hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                )}

                <div class="p-6">
                  <div class="text-sm text-gray-500 mb-2">
                    {post.data.published && new Date(post.data.published).toLocaleDateString(lang, {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </div>

                  <h2 class="text-xl font-semibold text-gray-900 mb-3 line-clamp-2 hover:text-[#5D4E37] transition-colors">
                    {post.title}
                  </h2>

                  {post.data.excerpt && (
                    <p class="text-gray-600 mb-4 line-clamp-3">
                      {post.data.excerpt}
                    </p>
                  )}

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="mb-8 flex flex-wrap gap-2">
                      {post.data.tags.map((tag: string) => (
                        <span class="px-4 py-2 bg-stone-100 text-stone-700 text-sm rounded-full">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

