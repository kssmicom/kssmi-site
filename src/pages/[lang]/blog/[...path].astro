---
import BlogListingPage from '../../../components/pages/BlogListingPage.astro';
import BlogDetailPage from '../../../components/pages/BlogDetailPage.astro';
import { getActiveBlogFilterPaths, getBlogSlugs } from '../../../components/blog/blogData';
import { LANGUAGES } from '../../../translations';

export async function getStaticPaths() {
  const [slugs, filters] = await Promise.all([getBlogSlugs(), getActiveBlogFilterPaths()]);
  const nonEnLangs = LANGUAGES.filter((l) => l !== 'en');
  return nonEnLangs.flatMap((lang) => [
    ...slugs.map((slug) => ({
      params: { lang, path: slug },
      props: { kind: 'article' as const, slug },
    })),
    ...filters.map((filter) => ({
      params: { lang, path: filter.path },
      props: { kind: 'filter' as const, topic: filter.topic, subtopic: filter.subtopic },
    })),
  ]);
}

const { lang } = Astro.params;
const props = Astro.props;
---
{props.kind === 'article' ? (
  <BlogDetailPage lang={lang} slug={props.slug} />
) : (
  <BlogListingPage lang={lang} activeTopic={props.topic} activeSubtopic={props.subtopic ?? null} />
)}
