const t = i18n[lang] || i18n.en;
---

<Layout title={t.title} lang={lang}>
  <Header lang={lang} />

  <main id="main-content" tabindex="-1" class="w-full min-h-screen bg-stone-50 pt-12 pb-16 flex items-center focus:outline-none" dir={isRTL ? 'rtl' : 'ltr'}>
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[1240px] mx-auto px-4">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

        <!-- LEFT: Image -->
        <div class="hidden lg:block">
          <div class="relative group">
            <img
              src="/media/global/404-team.webp"
              alt={t.imageAlt}
              class="w-full h-auto rounded-2xl shadow-lg object-cover aspect-[4/3] transition-transform duration-500 group-hover:scale-[1.02]"
              loading="eager"
              decoding="async"
            />
            <div class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-sm rounded-lg px-4 py-3 shadow-sm transition-all duration-300 group-hover:bg-white group-hover:shadow-md group-hover:-translate-y-1">
              <p class="text-sm font-semibold text-[#5D4E37]">{t.companyName}</p>
              <p class="text-xs text-stone-500">{t.since}</p>
            </div>
          </div>
        </div>

        <!-- RIGHT: Content -->
        <div class={`text-center ${isRTL ? 'lg:text-right' : 'lg:text-left'}`}>
          <!-- Kssmi Logo (mobile only) -->
          <div class="inline-flex flex-col items-center justify-center mb-6 lg:hidden">
            <span class="text-xl font-bold text-[#503629] tracking-tight leading-none uppercase">KSSMI</span>
            <span class="h-[2px] w-5 bg-[#503629] mt-1"></span>
            <span class="text-[8px] font-bold uppercase tracking-[0.2em] text-[#503629] mt-1">{t.eyewear}</span>
          </div>

          <!-- 404 Badge -->
          <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-[#5D4E37] bg-[#8B7355]/10 px-3 py-1 rounded-full mb-4">
            404
          </span>

          <!-- Warm heading -->
          <h1 class="text-2xl lg:text-3xl font-bold text-[#5D4E37] mb-3 tracking-tight">
            {t.heading1}
          </h1>
          <p class="text-lg text-[#5D4E37] font-medium mb-2">
            {t.heading2}
          </p>
          <p class="text-base text-stone-500 mb-8 max-w-lg mx-auto lg:mx-0">
            {t.description}
          </p>

          <!-- 3 Targeted Links -->
          <div class="mb-10">
            <p class="text-sm font-bold text-stone-400 uppercase tracking-wider mb-4">
              {t.lookingFor}
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-xl mx-auto lg:mx-0">
              <a href={`/${currentPath}quote`}
                class="group flex items-center gap-3 bg-white rounded-xl p-4 border border-stone-200 hover:border-[#8B7355] hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                <span class="flex-shrink-0 w-10 h-10 bg-[#8B7355]/10 rounded-lg flex items-center justify-center group-hover:bg-[#4A3D2E]/20 transition-colors">
                  <svg class="w-5 h-5 text-[#5D4E37]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </span>
                <div class="text-left">
                  <span class="block text-sm font-semibold text-[#5D4E37] group-hover:text-[#5D4E37] transition-colors">{t.oemTitle}</span>
                  <span class="block text-xs text-stone-400">{t.oemSub}</span>
                </div>
              </a>

              <a href={`/${currentPath}product`}
                class="group flex items-center gap-3 bg-white rounded-xl p-4 border border-stone-200 hover:border-[#8B7355] hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                <span class="flex-shrink-0 w-10 h-10 bg-[#8B7355]/10 rounded-lg flex items-center justify-center group-hover:bg-[#4A3D2E]/20 transition-colors">
                  <svg class="w-5 h-5 text-[#5D4E37]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                  </svg>
                </span>
                <div class="text-left">
                  <span class="block text-sm font-semibold text-[#5D4E37] group-hover:text-[#5D4E37] transition-colors">{t.catalogTitle}</span>
                  <span class="block text-xs text-stone-400">{t.catalogSub}</span>
                </div>
              </a>

              <a href={`/${currentPath}about-us`}
                class="group flex items-center gap-3 bg-white rounded-xl p-4 border border-stone-200 hover:border-[#8B7355] hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                <span class="flex-shrink-0 w-10 h-10 bg-[#8B7355]/10 rounded-lg flex items-center justify-center group-hover:bg-[#4A3D2E]/20 transition-colors">
                  <svg class="w-5 h-5 text-[#5D4E37]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </span>
                <div class="text-left">
                  <span class="block text-sm font-semibold text-[#5D4E37] group-hover:text-[#5D4E37] transition-colors">{t.factoryTitle}</span>
                  <span class="block text-xs text-stone-400">{t.factorySub}</span>
                </div>
              </a>
            </div>
          </div>

          <!-- Divider with humor -->
          <div class={`flex items-center gap-3 mb-8 ${isRTL ? 'justify-center lg:justify-end' : 'justify-center lg:justify-start'}`}>
            <span class="h-[1px] w-10 bg-[#8B7355]/20"></span>
            <p class="text-xs text-stone-400 italic">
              {t.humor}
            </p>
            <span class="h-[1px] w-10 bg-[#8B7355]/20"></span>
          </div>

          <!-- Mini Rescue Form (with Turnstile) -->
          <div class="bg-white rounded-xl p-6 border border-stone-200 shadow-sm max-w-xl mx-auto lg:mx-0 mb-8">
            <p class="text-sm font-bold text-[#5D4E37] mb-1">{t.formHeading}</p>
            <p class="text-xs text-stone-400 mb-4">{t.formSub}</p>

            <div id="form-error" class="hidden text-center py-2 mb-3 bg-red-50 rounded-lg">
              <span id="error-message" class="text-xs text-red-600"></span>
            </div>

            <form id="rescue-form" class="space-y-3">
              <label for="rescue-email" class="sr-only">{t.emailPlaceholder}</label>
              <input
                type="email"
                name="email"
                id="rescue-email"
                placeholder={t.emailPlaceholder}
                required
                class="w-full px-4 py-2.5 text-sm border border-stone-200 rounded-lg focus:border-[#8B7355] focus:ring-2 focus:ring-[#8B7355]/10 outline-none transition-all bg-stone-50"
              />
              <label for="rescue-message" class="sr-only">{t.formSub}</label>
              <textarea
                id="rescue-message"
                name="details"
                rows="3"
                placeholder=""
                required
                class="w-full px-4 py-2.5 text-sm border border-stone-200 rounded-lg focus:border-[#8B7355] focus:ring-2 focus:ring-[#8B7355]/10 outline-none transition-all bg-stone-50 resize-y min-h-[80px]"
              ></textarea>

              <input type="hidden" name="name" value="404 Rescue" />
              <input type="hidden" name="product_name" id="field-page" value="" />
              <input type="hidden" name="source" value="404 Page" />
              <input type="hidden" name="language" value={lang} />
              <input type="hidden" name="client_ip" id="client-ip" value="" />
              <input type="hidden" name="client_country" id="client-country" value="" />

              <div id="turnstile-container" class={`flex justify-center ${isDev ? 'hidden' : ''}`}></div>
              <div id="turnstile-error" class="hidden text-center py-2 px-3 bg-red-50 rounded-lg">
                <span id="turnstile-error-message" class="text-xs text-red-600">{t.turnstileError}</span>
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-[#5D4E37] text-white py-2.5 rounded-lg text-sm font-semibold hover:bg-[#4A3D2E] transition-colors duration-300 flex items-center justify-center gap-2 disabled:opacity-50">
                <svg id="btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span id="btn-text">{t.submitBtn}</span>
                <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
              </button>
            </form>

            <div id="form-success" class="hidden text-center py-4">
              <svg class="w-10 h-10 text-green-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-sm font-semibold text-[#5D4E37]">{t.successTitle}</p>
              <p class="text-xs text-stone-400">{t.successSub}</p>
            </div>
          </div>

          <!-- Back to Home -->
          <a href={`/${lang}`}
            class="inline-flex items-center gap-2 text-sm font-medium text-[#5D4E37] hover:text-[#5D4E37] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            {t.backHome}
          </a>
        </div>
      </div>

      <!-- Search Bar -->
      <div class="mt-16 max-w-2xl mx-auto">
        <p class="text-center text-xs font-bold text-stone-400 uppercase tracking-wider mb-4">
          {t.searchHeading}
        </p>
        <form id="search-form" action={`/${currentPath}search`} method="GET" class="relative group">
          <div class="flex items-center border-2 border-stone-200 bg-white rounded-full overflow-hidden focus-within:border-[#8B7355] shadow-sm transition-all duration-300 focus-within:ring-4 focus-within:ring-[#8B7355]/10">
            <input
              id="search-input"
              type="search"
              name="q"
              autocomplete="off"
              class="flex-grow py-3.5 px-5 bg-transparent border-none outline-none text-sm text-stone-900 placeholder-stone-400 font-medium focus:ring-0"
              placeholder={t.searchPlaceholder}
            />
            <button type="button" id="search-clear" class="hidden px-3 text-stone-400 hover:text-[#5D4E37] transition-colors flex-shrink-0" aria-label="Clear search">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
            <button type="submit" class="px-5 py-2 mr-1.5 bg-[#5D4E37] text-white rounded-full hover:bg-[#4A3D2E] transition-all duration-300 font-bold tracking-wide text-xs uppercase shadow-md flex-shrink-0 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <span>{t.searchBtn}</span>
            </button>
          </div>
        </form>
      </div>

    </div>

    <!-- Search clear button logic (inline, no Vite processing) -->
    <script is:inline>
      (function() {
        var searchInput = document.getElementById('search-input');
        var searchClear = document.getElementById('search-clear');
        if (!searchInput || !searchClear) return;

        function updateClearButton() {
          if (searchInput.value.trim()) {
            searchClear.classList.remove('hidden');
          } else {
            searchClear.classList.add('hidden');
          }
        }

        searchInput.addEventListener('input', updateClearButton);
        searchClear.addEventListener('click', function() {
          searchInput.value = '';
          searchClear.classList.add('hidden');
          searchInput.focus();
        });
        updateClearButton();
      })();
    </script>
  </main>

  <Footer lang={lang} />
</Layout>

<style is:global>
  input[type="search"]::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }
  input[type="search"]::-moz-search-clear-button {
    display: none;
  }
</style>

<!-- Turnstile: define callback BEFORE loading script (production only) -->
{!isDev && (
  <script is:inline>
    window.TURNSTILE_SITE_KEY = "0x4AAAAAACGlmQDIODBgCmpo";
    window.turnstileToken = null;

    window.onTurnstileLoad = function() {
      var container = document.getElementById('turnstile-container');
      if (!container) return;
      container.innerHTML = '';
      var widgetDiv = document.createElement('div');
      container.appendChild(widgetDiv);
      try {
        window.turnstile.render(widgetDiv, {
          sitekey: window.TURNSTILE_SITE_KEY,
          theme: 'light',
          callback: function(token) {
            window.turnstileToken = token;
            var errorEl = document.getElementById('turnstile-error');
            if (errorEl) errorEl.classList.add('hidden');
          },
          'expired-callback': function() {
            window.turnstileToken = null;
          }
        });
      } catch (e) {
        console.error('Turnstile render error:', e);
      }
    };
  </script>
)}

{!isDev && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>
)}

<script define:vars={{ isDev, lang, sending: t.sending, submitBtn: t.submitBtn, errorFallback: t.errorFallback, generalError: t.generalError, detailsPlaceholder: t.detailsPlaceholder }}>
  // --- Set 2-line textarea placeholder (JS handles \n correctly for multiline placeholders) ---
  var detailsTextarea = document.getElementById('rescue-message');
  if (detailsTextarea) detailsTextarea.placeholder = detailsPlaceholder;

  // --- Set page URL in hidden field ---
  var pageField = document.getElementById('field-page');
  if (pageField) pageField.value = window.location.pathname;

  // --- Fetch client IP ---
  async function fetchClientIP() {
    try {
      var response = await fetch('https://ipapi.co/json/', {
        method: 'GET',
        headers: { 'Accept': 'application/json' }
      });
      if (response.ok) {
        var data = await response.json();
        var ipInput = document.getElementById('client-ip');
        var countryInput = document.getElementById('client-country');
        if (ipInput && data.ip) ipInput.value = data.ip;
        if (countryInput && data.country_code) countryInput.value = data.country_code;
      }
    } catch (e) { /* silent */ }
  }
  fetchClientIP();

  // --- Form elements ---
  function getEls() {
    return {
      form: document.getElementById('rescue-form'),
      submitBtn: document.getElementById('submit-btn'),
      btnText: document.getElementById('btn-text'),
      btnIcon: document.getElementById('btn-icon'),
      btnSpinner: document.getElementById('btn-spinner'),
      errorContainer: document.getElementById('form-error'),
      errorMessage: document.getElementById('error-message'),
      turnstileError: document.getElementById('turnstile-error'),
      successEl: document.getElementById('form-success'),
    };
  }

  function setLoading(loading) {
    var els = getEls();
    if (els.submitBtn) els.submitBtn.disabled = loading;
    els.btnText.textContent = loading ? sending : submitBtn;
    if (loading) { els.btnIcon.classList.add('hidden'); els.btnSpinner.classList.remove('hidden'); }
    else { els.btnIcon.classList.remove('hidden'); els.btnSpinner.classList.add('hidden'); }
  }

  // --- Form submission ---
  function setupForm() {
    var els = getEls();
    var form = els.form;
    if (!form) return;

    var newForm = form.cloneNode(true);
    form.parentNode.replaceChild(newForm, form);

    newForm.addEventListener('submit', async function(e) {
      e.preventDefault();

      var els2 = getEls();
      els2.errorContainer.classList.add('hidden');
      els2.turnstileError.classList.add('hidden');

      var token = window.turnstileToken;
      if (!isDev && !token) {
        els2.turnstileError.classList.remove('hidden');
        return;
      }

      var formData = new FormData(newForm);
      if (!isDev && token) {
        formData.append('cf-turnstile-response', token);
      }

      setLoading(true);

      try {
        var apiUrl = isDev ? 'http://localhost:4325/send-mail.php' : '/send-mail.php';
        var response = await fetch(apiUrl, { method: 'POST', body: formData });

        if (!response.ok) {
          var ct = response.headers.get('content-type');
          if (ct && ct.includes('text/html')) throw new Error('PHP_NOT_CONFIGURED');
          throw new Error('HTTP ' + response.status);
        }

        var result = await response.json();

        if (result.success) {
          window.location.href = '/' + lang + '/thank-you/';
        } else {
          els2.errorMessage.textContent = result.message || generalError;
          els2.errorContainer.classList.remove('hidden');
          setLoading(false);
        }
      } catch (err) {
        console.error('404 form error:', err);
        els2.errorMessage.textContent = errorFallback;
        els2.errorContainer.classList.remove('hidden');
        setLoading(false);
      }
    });
  }

  setupForm();
</script>
