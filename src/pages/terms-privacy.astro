---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';
---

<Layout title="Terms & Privacy | Kssmi Eyewear" lang={lang} noindex={true}>
  <Header lang={lang} />

  <main class="w-full min-h-[70vh] bg-stone-50 pt-12 pb-24 flex items-center">
    <div class="w-[95%] lg:w-[92%] 2xl:w-[87%] max-w-[820px] mx-auto px-4 text-center">
      <div class="inline-flex flex-col items-center justify-center mb-8">
        <span class="text-3xl font-bold text-[#503629] tracking-tight leading-none uppercase">KSSMI</span>
        <span class="h-[2px] w-8 bg-[#503629] mt-1.5"></span>
        <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-[#503629] mt-1.5">Eyewear Mfg.</span>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold text-[#5D4E37] mb-4 tracking-tight">Terms &amp; Privacy</h1>

      <div class="inline-flex items-center justify-center w-16 h-16 bg-white border border-stone-200 rounded-full mb-8 shadow-sm">
        <svg class="w-6 h-6 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>

      <p class="text-lg text-stone-600 mb-3 font-medium">This page is under construction.</p>
      <p class="text-base text-stone-600 mb-10 max-w-md mx-auto">
        Our legal team is finalizing the terms and privacy policy. Check back soon or explore our product catalog.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/product" class="inline-flex items-center px-8 py-3 bg-[#5D4E37] text-white font-bold uppercase tracking-wider text-xs rounded-full hover:bg-[#4A3D2E] transition-colors duration-300 shadow-lg">
          Browse Products
        </a>
        <a href="/" class="inline-flex items-center px-8 py-3 border-2 border-[#5D4E37] text-[#5D4E37] font-bold uppercase tracking-wider text-xs rounded-full hover:bg-[#5D4E37] hover:text-white transition-all duration-300">
          Back to Home
        </a>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
