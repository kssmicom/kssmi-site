---
import InquiryForm from '../../components/InquiryForm.astro';
import TurnstileApiLoader from '../../components/TurnstileApiLoader.astro';

export async function getStaticPaths() {
  const languages = ['en','it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<!-- Legacy standalone fragment: pages now render the form inline, so nothing
     fetches this route. It must never be indexed. OpenLiteSpeed ignores the
     conditional X-Robots-Tag in .htaccess, so the meta tag is the control.
     It comes before any content, so parsers place it in the implied <head>. -->
<meta name="robots" content="noindex, nofollow" />
<!-- Product context is injected by InquiryFormLazy in the browser. This route is static. -->
<!-- This fragment has no Layout, so it brings its own Turnstile API loader. -->
<TurnstileApiLoader />
<InquiryForm lang={lang} source="inquiry_fragment" />
