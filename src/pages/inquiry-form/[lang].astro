---
import InquiryForm from '../../components/InquiryForm.astro';

export async function getStaticPaths() {
  const languages = ['en','it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const productName = Astro.url.searchParams.get('product') || '';
---

<InquiryForm lang={lang} productName={productName} />
