---
import InquiryForm from '../../components/InquiryForm.astro';

export async function getStaticPaths() {
  const languages = ['en','it','es','fr','de','pt','ru','ja','tr','ar','ko','zh','hi','vi','jv','ms','tg'];
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<!-- Product context is injected by InquiryFormLazy in the browser. This route is static. -->
<InquiryForm lang={lang} source="inquiry_fragment" />
