---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { translations } from '../translations';
import VisitorTracker from '../components/VisitorTracker.astro';
import CookieBanner from '../components/CookieBanner.astro';

// Props
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  lcpImage?: string;  // URL of the LCP image to preload (product cover on listing pages)
  lang?: string;
  canonical?: string;
  type?: 'website' | 'product' | 'article';
  noindex?: boolean;
  noHreflang?: boolean;
  preconnectVideo?: boolean;  // Preconnect to the gumlet video CDN (home hero only)
}

const {
  title,
  description: propDescription,
  keywords,
  image = "/media/global/404-team.webp",
  lcpImage,
  lang = 'en',
  canonical,
  type = 'website',
  noindex = false,
  noHreflang = false,
  preconnectVideo = false
} = Astro.props;

const t = translations[lang] || translations.en;
const layoutMeta = t.layout || translations.en.layout;

const description = propDescription || layoutMeta.description;

// Detect if language is Right-to-Left (Arabic)
const isRTL = lang === 'ar';
const dir = isRTL ? 'rtl' : 'ltr';

	// Root path without language prefix (for hreflang alternates)
	let currentPath = Astro.url.pathname.replace(`/${lang}/`, '').replace(`/${lang}`, '').replace(/^\//, '');
	// Self-referencing URL with language prefix (for canonical + OG)
	const selfUrl = lang === 'en' ? currentPath : `/${lang}/${currentPath}`;

// All supported languages
const languages = ['en', 'it', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'tr', 'ar', 'ko', 'zh', 'hi', 'vi', 'jv', 'ms', 'tg'];

// Locale code mapping for og:locale
const localeMap: Record<string, string> = {
  "en": "en_US",
  "it": "it_IT",
  "es": "es_ES",
  "fr": "fr_FR",
  "de": "de_DE",
  "pt": "pt_PT",
  "ru": "ru_RU",
  "ja": "ja_JP",
  "tr": "tr_TR",
  "ar": "ar_SA",
  "ko": "ko_KR",
  "zh": "zh_CN",
  "hi": "hi_IN",
  "vi": "vi_VN",
  "jv": "jv_ID",
  "ms": "ms_MY",
  "tg": "tg_TJ",
};

// Organization Schema (Google Knowledge Graph)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://kssmi.com/#organization",
  "name": "Kssmi Eyewear",
  "url": "https://kssmi.com",
  "logo": "https://kssmi.com/favicon.svg",
  "image": "https://kssmi.com/media/global/404-team.webp",
  "description": layoutMeta.schemaDescription,
  "foundingDate": "2003",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "CN"
  },
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "sales",
    "telephone": "+86-135-1053-2553",
    "email": "sales@kssmi.com",
    "areaServed": ["US", "EU", "IT", "FR", "DE", "JP", "TR", "RU", "CN", "BR", "PT"]
  }
};
// WebSite Schema (Google Sitelinks Search Box)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://kssmi.com/#website",
  "name": "Kssmi Eyewear",
  "url": "https://kssmi.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://kssmi.com/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FCFAF8" />

  <!-- Google Tag Manager (loads on user interaction — never blocks critical path) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({'gtm.start': new Date().getTime(), event:'gtm.js'});
    var _gtmLoaded = false;
    function loadGTM() {
      if (_gtmLoaded) return; _gtmLoaded = true;
      var d=document,s='script',l='dataLayer',i='GTM-TSW9LBMG';
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s);
      j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+'&l='+l;
      f.parentNode.insertBefore(j,f);
    }
    // Load on first user interaction (scroll, click, touch, keypress)
    var _events = ['scroll','click','touchstart','keydown'];
    function _onInteraction(e) {
      loadGTM();
      for (var i=0;i<_events.length;i++) document.removeEventListener(_events[i],_onInteraction,{once:true,passive:true});
    }
    for (var i=0;i<_events.length;i++) document.addEventListener(_events[i],_onInteraction,{once:true,passive:true});
    // Fallback: load after 8s even with no interaction
    setTimeout(loadGTM, 8000);
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <!-- End Google Tag Manager -->
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}

  <!-- Noindex for thank-you pages -->
	{noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image.startsWith('http') ? image : `https://kssmi.com${image}`} />
  <meta property="og:url" content={canonical || `https://kssmi.com/${selfUrl}`} />
  <meta property="og:type" content={type} />
	<meta property="og:locale" content={localeMap[lang] || "en_US"} />
  <meta property="og:site_name" content="Kssmi Eyewear" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image.startsWith('http') ? image : `https://kssmi.com${image}`} />

  <!-- Canonical URL -->
  {canonical ? (
    <link rel="canonical" href={canonical} />
  ) : (
    <link rel="canonical" href={`https://kssmi.com/${selfUrl}`} />
  )}

  <!-- Hreflang Tags for Multilingual SEO -->
  {!noHreflang && languages.map((l) => (
    <link
      rel="alternate"
      hreflang={l}
      href={`https://kssmi.com/${l === 'en' ? '' : l + '/'}${currentPath}`}
    />
  ))}
  {!noHreflang && <link rel="alternate" hreflang="x-default" href={`https://kssmi.com/${currentPath}`} />}<!-- Warm the connection to the hero video CDN ASAP (home page only). -->
  <!-- No crossorigin: the <video> fetch is non-CORS, so the reused socket must match. -->
  {preconnectVideo && (
    <>
      <link rel="preconnect" href="https://video.gumlet.io" />
      <link rel="dns-prefetch" href="//video.gumlet.io" />
      <link rel="dns-prefetch" href="//play.gumlet.io" />
    </>
  )}

  <!-- Preload LCP image: tells browser to fetch it immediately, before HTML is fully parsed -->
  <!-- This is the single most impactful fix for Largest Contentful Paint on image-heavy pages -->
  {lcpImage && (
    <link rel="preload" as="image" href={lcpImage} type={lcpImage.endsWith('.webp') ? 'image/webp' : undefined} fetchpriority="high" />
  )}

  <!-- View Transitions for SPA-like speed -->
  <ClientRouter />

  <!-- Preconnect to font origins to save DNS+TLS on critical path -->
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />
  <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />

  <!-- Google Fonts: deferred to after load so ~61KB of fonts don't starve the LCP image on Slow 4G.
       display=optional means first paint already uses the system fallback — zero visual change. -->
  <!-- Preconnect to font origins so DNS/TLS is ready when fonts load later -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Web fonts loaded AFTER load: their ~61KB no longer compete with the LCP poster on Slow 4G.
       display=optional means first paint already uses the system fallback, so this changes nothing visually. -->
  <script>
    (function () {
      var FONTS = [
        'https://fonts.googleapis.com/css2?family=Manrope:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=optional',
        'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Raleway:wght@600;700&display=optional'
      ];
      // Arabic (RTL) font — only injected on RTL pages
      if (document.documentElement.dir === 'rtl') {
        FONTS.push('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&display=swap');
      }
      function load() {
        FONTS.forEach(function (href) {
          var l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = href;
          document.head.appendChild(l);
        });
      }
      if (document.readyState === 'complete') {
        ('requestIdleCallback' in window) ? requestIdleCallback(load) : setTimeout(load, 200);
      } else {
        window.addEventListener('load', function () {
          ('requestIdleCallback' in window) ? requestIdleCallback(load) : setTimeout(load, 200);
        }, { once: true });
      }
    })();
  </script>
  <!-- Fallback for users with JS disabled -->
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=optional" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Raleway:wght@600;700&display=optional" />
  </noscript>

  <!-- Organization Schema for Google Graph -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Cloudflare Web Analytics (loads after GTM, never blocks critical path) -->
  <script>
    (function(){var s=document.createElement('script');s.defer=true;
    s.src='https://static.cloudflareinsights.com/beacon.min.js';
    s.setAttribute('data-cf-beacon','{"token":"70e1c20d83a34e0ebfa6b3fb9053e96a"}');
    setTimeout(function(){document.head.appendChild(s)},6000);
    })();
  </script>

  <!-- Clean tracking query parameters from URL (GA4 _gl, UTM, GCLID, FBCLID, etc.) -->
  <script is:inline>
    (function() {
      var dirty = false;
      var params = new URLSearchParams(location.search);
      // GA4 cross-domain linker parameter — the main culprit
      if (params.has('_gl')) { params.delete('_gl'); dirty = true; }
      // Google Ads
      if (params.has('gclid')) { params.delete('gclid'); dirty = true; }
      if (params.has('gclsrc')) { params.delete('gclsrc'); dirty = true; }
      if (params.has('gbraid')) { params.delete('gbraid'); dirty = true; }
      if (params.has('wbraid')) { params.delete('wbraid'); dirty = true; }
      // Facebook
      if (params.has('fbclid')) { params.delete('fbclid'); dirty = true; }
      // Bing / Microsoft
      if (params.has('msclkid')) { params.delete('msclkid'); dirty = true; }
      // Other common marketing trackers
      if (params.has('dclid')) { params.delete('dclid'); dirty = true; }
      if (params.has('mc_cid')) { params.delete('mc_cid'); dirty = true; }
      if (params.has('mc_eid')) { params.delete('mc_eid'); dirty = true; }
      if (params.has('wickedid')) { params.delete('wickedid'); dirty = true; }
      // Any utm_* parameter
      var utmKeys = [];
      params.forEach(function(_, k) { if (k.indexOf('utm_') === 0) utmKeys.push(k); });
      utmKeys.forEach(function(k) { params.delete(k); dirty = true; });

      if (dirty) {
        var cleaned = location.pathname;
        var qs = params.toString();
        if (qs) cleaned += '?' + qs;
        cleaned += location.hash;
        history.replaceState(history.state, '', cleaned);
      }
    })();
  </script>
</head>
<body class={`${isRTL ? 'font-arabic' : 'font-sans'} antialiased relative min-h-screen`}>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TSW9LBMG"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <!-- Page Transition Loader -->
  <div id="page-loader" class="fixed top-0 left-0 w-full h-[3px] bg-[#8B7355] z-[99999] origin-left scale-x-0 transition-transform duration-300 pointer-events-none" style="transform:translateZ(0)"></div>
  <script is:inline>
    document.addEventListener('astro:before-preparation', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        loader.style.transitionDuration = '3s';
        loader.style.transform = 'scaleX(0.6)';
        document.body.style.cursor = 'wait';
      }
    });
    document.addEventListener('astro:after-preparation', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        loader.style.transitionDuration = '0.3s';
        loader.style.transform = 'scaleX(1)';
        document.body.style.cursor = 'default';
      }
    });
    document.addEventListener('astro:page-load', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        setTimeout(() => {
          loader.style.transitionDuration = '0s';
          loader.style.transform = 'scaleX(0)';
          document.body.style.cursor = 'default';
        }, 300);
      }

      // Re-run URL cleanup after View Transitions
      var p2 = new URLSearchParams(location.search);
      if (p2.has('_gl') || p2.has('gclid') || p2.has('fbclid') || p2.has('msclkid')) {
        ['_gl','gclid','gclsrc','fbclid','msclkid','dclid','gbraid','wbraid','mc_cid','mc_eid','wickedid'].forEach(function(k){p2.delete(k)});
        var utmK = [];
        p2.forEach(function(_,k){if(k.indexOf('utm_')===0)utmK.push(k)});
        utmK.forEach(function(k){p2.delete(k)});
        var c = location.pathname;
        var q = p2.toString();
        if (q) c += '?' + q;
        c += location.hash;
        history.replaceState(history.state, '', c);
      }
    });
  </script>
  <!-- Accessibility: Skip to Content Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[9999] bg-[#5D4E37] text-white px-4 py-2 font-bold rounded-md shadow-lg outline-none focus:ring-4 focus:ring-[#8B7355]/50">
    {t.nav?.skipToContent || 'Skip to content'}
  </a>
  <style define:vars={{
    '--font-sans': "'Plus Jakarta Sans', sans-serif",
    '--font-arabic': "'Noto Sans Arabic', sans-serif"
  }}>
    /* Base styles */
    html {
      scroll-behavior: smooth;
      overflow-x: hidden;
    }

    /* Default Latin Font */
    body {
      font-family: var(--font-sans);
    }
    body.font-arabic {
      font-family: var(--font-arabic);
    }

    /* RTL-aware spacing */
    :dir(rtl) {
      direction: rtl;
      text-align: right;
    }
    :dir(rtl) .prose {
      text-align: right;
    }
  </style>
  <main id="main-content">
    <slot />
  </main>
  <VisitorTracker />
  <CookieBanner lang={lang} />
</body>
</html>
