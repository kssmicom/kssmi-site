---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { translations } from '../translations';
import VisitorTracker from '../components/VisitorTracker.astro';

// Props
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  lcpImage?: string;  // URL of the LCP image to preload (product cover on listing pages)
  lang?: string;
  canonical?: string;
  type?: 'website' | 'product' | 'article';
  noindex?: boolean;
}

const {
  title,
  description: propDescription,
  keywords,
  image = "/media/global/logo.png",
  lcpImage,
  lang = 'en',
  canonical,
  type = 'website',
  noindex = false
} = Astro.props;

const t = translations[lang] || translations.en;
const layoutMeta = t.layout || translations.en.layout;

const description = propDescription || layoutMeta.description;

// Detect if language is Right-to-Left (Arabic)
const isRTL = lang === 'ar';
const dir = isRTL ? 'rtl' : 'ltr';

	// Root path without language prefix (for hreflang alternates)
	const currentPath = Astro.url.pathname.replace(`/${lang}/`, '').replace(/^\//, '');
	// Self-referencing URL with language prefix (for canonical + OG)
	const selfUrl = lang === 'en' ? currentPath : `/${lang}/${currentPath}`;

// All supported languages
const languages = ['en', 'it', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'tr', 'ar', 'ko', 'zh', 'hi', 'vi', 'jv', 'ms', 'tg'];

// Organization Schema (Google Knowledge Graph)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://kssmi.com/#organization",
  "name": "Kssmi Eyewear",
  "url": "https://kssmi.com",
  "logo": "https://kssmi.com/media/global/logo.png",
  "description": layoutMeta.schemaDescription,
  "foundingDate": "2003",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "CN"
  },
  "sameAs": [
    "https://kssmi.com"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+86-135-1053-2553",
    "contactType": "sales",
    "areaServed": ["US", "EU", "IT", "FR", "DE", "JP", "TR", "RU", "CN", "BR", "PT"]
  }
};
---

<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}

  <!-- Noindex for thank-you pages -->
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image.startsWith('http') ? image : `https://kssmi.com${image}`} />
  <meta property="og:url" content={canonical || `https://kssmi.com/${selfUrl}`} />
  <meta property="og:type" content={type} />

  <!-- Canonical URL -->
  {canonical ? (
    <link rel="canonical" href={canonical} />
  ) : (
    <link rel="canonical" href={`https://kssmi.com/${selfUrl}`} />
  )}

  <!-- Hreflang Tags for Multilingual SEO -->
  {languages.map((l) => (
    <link
      rel="alternate"
      hreflang={l}
      href={`https://kssmi.com/${l === 'en' ? '' : l + '/'}${currentPath}`}
    />
  ))}
  <link rel="alternate" hreflang="x-default" href={`https://kssmi.com/${currentPath}`} />

  <!-- Preload LCP image: tells browser to fetch it immediately, before HTML is fully parsed -->
  <!-- This is the single most impactful fix for Largest Contentful Paint on image-heavy pages -->
  {lcpImage && (
    <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />
  )}

  <!-- View Transitions for SPA-like speed -->
  <ClientRouter />

  <!-- Google Fonts: split-load strategy to minimize font-swap reflow -->
  <!-- Step 1: Preconnect to font origins so DNS/TLS is ready early -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Step 2a: Critical body + heading fonts → display=swap (renders text immediately, swaps when ready) -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <!-- Step 2b: Decorative accent fonts → display=optional (uses fallback on first visit, instant on cached visits — zero reflow) -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Raleway:wght@600;700&display=optional"
    media="print"
    onload="this.media='all'"
  />
  <!-- Step 3: Fallback for users with JS disabled -->
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Raleway:wght@600;700&display=optional" />
  </noscript>
  {isRTL && (
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
  )}

  <!-- Organization Schema for Google Graph -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Cloudflare Web Analytics (defer = non-blocking) -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "70e1c20d83a34e0ebfa6b3fb9053e96a"}'></script>
</head>
<body class="font-sans antialiased relative min-h-screen">
  <!-- Page Transition Loader -->
  <div id="page-loader" class="fixed top-0 left-0 w-full h-[3px] bg-[#8B7355] z-[99999] origin-left scale-x-0 transition-transform duration-300 pointer-events-none will-change-transform"></div>
  <script is:inline>
    document.addEventListener('astro:before-preparation', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        loader.style.transitionDuration = '3s';
        loader.style.transform = 'scaleX(0.6)';
        document.body.style.cursor = 'wait';
      }
    });
    document.addEventListener('astro:after-preparation', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        loader.style.transitionDuration = '0.3s';
        loader.style.transform = 'scaleX(1)';
        document.body.style.cursor = 'default';
      }
    });
    document.addEventListener('astro:page-load', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        setTimeout(() => {
          loader.style.transitionDuration = '0s';
          loader.style.transform = 'scaleX(0)';
          document.body.style.cursor = 'default';
        }, 300);
      }


    });
  </script>
  <!-- Accessibility: Skip to Content Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[9999] bg-[#5D4E37] text-white px-4 py-2 font-bold rounded-md shadow-lg outline-none focus:ring-4 focus:ring-[#8B7355]/50">
    Skip to content
  </a>
  <style define:vars={{
    '--font-sans': "'Plus Jakarta Sans', sans-serif",
    '--font-heading': "'Manrope', sans-serif",
    '--font-raleway': "'Raleway', sans-serif",
    '--font-arabic': "'Noto Sans Arabic', sans-serif"
  }}>
    /* Base styles */
    html {
      scroll-behavior: smooth;
      overflow-x: hidden;
    }

    /* Default Latin Font */
    body {
      font-family: var(--font-sans);
    }

    /* RTL-aware spacing */
    :dir(rtl) {
      /* Arabic-specific overrides if needed */
    }
  </style>
  <slot />
  <VisitorTracker />
</body>
</html>
