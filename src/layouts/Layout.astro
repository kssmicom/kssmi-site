---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getTranslations, type Translations } from '../translations';
import VisitorTracker from '../components/VisitorTracker.astro';
import { runtimeAssetUrl } from '../config/runtimeAssets.mjs';

// Props
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  lcpImage?: string;  // URL of the LCP image to preload (product cover on listing pages)
  lang?: string;
  canonical?: string;
  type?: 'website' | 'product' | 'article';
  noindex?: boolean;
  noHreflang?: boolean;
}

const {
  title,
  description: propDescription,
  keywords,
  image = "/media/global/404-team.webp",
  lcpImage,
  lang = 'en',
  canonical,
  type = 'website',
  noindex = false,
  noHreflang = false
} = Astro.props;

const t = await getTranslations(lang);
const fallbackTranslations = await getTranslations('en');
const layoutMeta = t.layout || fallbackTranslations.layout;

const description = propDescription || layoutMeta.description;
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
const cookieBannerScriptUrl = import.meta.env.DEV
  ? '/cookie-banner.js'
  : runtimeAssetUrl('cookie-banner');

// Detect if language is Right-to-Left (Arabic)
const isRTL = lang === 'ar';
const dir = isRTL ? 'rtl' : 'ltr';

// All supported languages
const languages = ['en', 'it', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'tr', 'ar', 'ko', 'zh', 'hi', 'vi', 'jv', 'ms', 'tg'];

// Build canonical and alternate URLs from absolute paths. This avoids //de/...
// URLs and only removes a locale when it is the leading URL segment.
const localePrefix = lang === 'en' ? '' : `/${lang}`;
const basePath = localePrefix && (Astro.url.pathname === localePrefix || Astro.url.pathname.startsWith(localePrefix + '/'))
  ? (Astro.url.pathname.slice(localePrefix.length) || '/')
  : Astro.url.pathname;
const normalizedBasePath = basePath.startsWith('/') ? basePath : `/${basePath}`;
const localizedPath = (locale: string) => locale === 'en'
  ? normalizedBasePath
  : `/${locale}${normalizedBasePath}`;
const absoluteUrl = (pathname: string) => new URL(pathname, Astro.site ?? 'https://kssmi.com').href;
const selfCanonical = absoluteUrl(localizedPath(lang));
// A noindex page must not advertise itself as an indexable language variant.
const shouldRenderHreflang = !noindex && !noHreflang;

// Locale code mapping for og:locale
const localeMap: Record<string, string> = {
  "en": "en_US",
  "it": "it_IT",
  "es": "es_ES",
  "fr": "fr_FR",
  "de": "de_DE",
  "pt": "pt_PT",
  "ru": "ru_RU",
  "ja": "ja_JP",
  "tr": "tr_TR",
  "ar": "ar_SA",
  "ko": "ko_KR",
  "zh": "zh_CN",
  "hi": "hi_IN",
  "vi": "vi_VN",
  "jv": "jv_ID",
  "ms": "ms_MY",
  "tg": "tg_TJ",
};

// Organization Schema (Google Knowledge Graph)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://kssmi.com/#organization",
  "name": "Kssmi Eyewear",
  "url": "https://kssmi.com",
  "logo": "https://kssmi.com/favicon.svg",
  "image": "https://kssmi.com/media/global/404-team.webp",
  "description": layoutMeta.schemaDescription,
  "foundingDate": "2003",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "905, Bldg. 1, Baiwangda Health Tech Park, Yuanshan St., Longgang Dist.",
    "addressLocality": "Shenzhen",
    "addressRegion": "Guangdong",
    "postalCode": "518172",
    "addressCountry": "CN"
  },
  "sameAs": [
    "https://www.linkedin.com/company/kssmi-eyewear",
    "https://www.instagram.com/kssmieyewear/",
    "https://www.facebook.com/KssmiEyewear/"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "sales",
    "telephone": "+86-135-1053-2553",
    "email": "sales@kssmi.com",
    "areaServed": "Worldwide"
  }
};
// WebSite Schema (Google Sitelinks Search Box)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://kssmi.com/#website",
  "name": "Kssmi Eyewear",
  "url": "https://kssmi.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://kssmi.com/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FCFAF8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />

  <!-- Google Tag Manager (loads on user interaction — never blocks critical path) -->
  <!-- Google Consent Mode v2 — default: denied (no ads yet). When Google Ads enabled, update via cookie banner. -->
  <script is:inline>
    // Google Consent Mode v2 — single source of truth (must run before GTM).
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 500,
    });
    gtag('set', 'ads_data_redaction', true);
    gtag('set', 'url_passthrough', true);
    // Restore a returning visitor's stored choice so GA/Ads consent is re-granted
    // on every load — even when the deferred cookie-banner script is NOT loaded
    // for them (it only loads when no consent is stored). Without this, returning
    // visitors who accepted would stay in denied/cookieless mode.
    try {
      var _vjtRawConsent = localStorage.getItem('cookie-consent');
      var _vjtConsent = _vjtRawConsent ? JSON.parse(_vjtRawConsent) : null;
      if (typeof _vjtConsent === 'object' && _vjtConsent !== null) {
        gtag('consent', 'update', {
          ad_storage: _vjtConsent.ads ? 'granted' : 'denied',
          ad_user_data: _vjtConsent.ads ? 'granted' : 'denied',
          ad_personalization: _vjtConsent.ads ? 'granted' : 'denied',
          analytics_storage: _vjtConsent.analytics ? 'granted' : 'denied',
        });
      }
    } catch (e) {}
  </script>
  <script>
    window.dataLayer ??= [];
    window.dataLayer.push({'gtm.start': new Date().getTime(), event:'gtm.js'});
    let gtmLoaded = false;

    function loadGTM(): void {
      if (gtmLoaded) return;
      gtmLoaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-TSW9LBMG&l=dataLayer';

      const firstScript = document.scripts.item(0);
      if (firstScript?.parentNode) {
        firstScript.parentNode.insertBefore(script, firstScript);
      } else {
        document.head.appendChild(script);
      }
    }

    // Load on first user interaction (scroll, click, touch, keypress)
    const interactionEvents = ['scroll', 'click', 'touchstart', 'keydown'] as const;

    function onInteraction(): void {
      loadGTM();
      for (const eventName of interactionEvents) {
        document.removeEventListener(eventName, onInteraction);
      }
    }

    for (const eventName of interactionEvents) {
      document.addEventListener(eventName, onInteraction, {
        once: true,
        passive: true,
      });
    }

    // Fallback: load after 8s even with no interaction
    setTimeout(loadGTM, 8000);
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <!-- End Google Tag Manager -->
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}

  <!-- Noindex for thank-you pages -->
	{noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image.startsWith('http') ? image : `https://kssmi.com${image}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonical || selfCanonical} />
  <meta property="og:type" content={type} />
	<meta property="og:locale" content={localeMap[lang] || "en_US"} />
  <meta property="og:site_name" content="Kssmi Eyewear" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image.startsWith('http') ? image : `https://kssmi.com${image}`} />

  <!-- Canonical URL -->
  {canonical ? (
    <link rel="canonical" href={canonical} />
  ) : (
    <link rel="canonical" href={selfCanonical} />
  )}

  <!-- Hreflang Tags for Multilingual SEO -->
  {shouldRenderHreflang && languages.map((l) => (
    <link
      rel="alternate"
      hreflang={l}
      href={absoluteUrl(localizedPath(l))}
    />
  ))}
  {shouldRenderHreflang && <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizedPath('en'))} />}

  <!-- Preload LCP image: tells browser to fetch it immediately, before HTML is fully parsed -->
  <!-- This is the single most impactful fix for Largest Contentful Paint on image-heavy pages -->
  {lcpImage && (
    <link rel="preload" as="image" href={lcpImage} type={lcpImage.endsWith('.webp') ? 'image/webp' : undefined} fetchpriority="high" />
  )}

  <!-- View Transitions for SPA-like speed -->
  <ClientRouter />

  <!-- Preconnect to font origins to save DNS+TLS on critical path -->
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />
  {cloudflareAnalyticsToken && <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />}

  <!-- Keep the first and settled frames on the same local system-font metrics.
       Late web-font injection caused mobile text reflow and avoidable third-party requests. -->

  <!-- Organization Schema for Google Graph -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Cloudflare Web Analytics is opt-in and never runs on local preview hosts. -->
  {cloudflareAnalyticsToken && (
    <script is:inline define:vars={{ cloudflareAnalyticsToken }}>
      (function(){
        var hostname = window.location.hostname;
        if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '::1') return;
        var s = document.createElement('script');
        s.defer = true;
        s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        s.setAttribute('data-cf-beacon', JSON.stringify({ token: cloudflareAnalyticsToken }));
        setTimeout(function(){document.head.appendChild(s)}, 6000);
      })();
    </script>
  )}

  <!-- Clean tracking query parameters from URL (GA4 _gl, UTM, GCLID, FBCLID, etc.) -->
  <script is:inline>
    (function() {
      var dirty = false;
      var params = new URLSearchParams(location.search);
      // GA4 cross-domain linker parameter — the main culprit
      if (params.has('_gl')) { params.delete('_gl'); dirty = true; }
      // Google Ads
      if (params.has('gclid')) { params.delete('gclid'); dirty = true; }
      if (params.has('gclsrc')) { params.delete('gclsrc'); dirty = true; }
      if (params.has('gbraid')) { params.delete('gbraid'); dirty = true; }
      if (params.has('wbraid')) { params.delete('wbraid'); dirty = true; }
      // Facebook
      if (params.has('fbclid')) { params.delete('fbclid'); dirty = true; }
      // Bing / Microsoft
      if (params.has('msclkid')) { params.delete('msclkid'); dirty = true; }
      // Other common marketing trackers
      if (params.has('dclid')) { params.delete('dclid'); dirty = true; }
      if (params.has('mc_cid')) { params.delete('mc_cid'); dirty = true; }
      if (params.has('mc_eid')) { params.delete('mc_eid'); dirty = true; }
      if (params.has('wickedid')) { params.delete('wickedid'); dirty = true; }
      // Any utm_* parameter
      var utmKeys = [];
      params.forEach(function(_, k) { if (k.indexOf('utm_') === 0) utmKeys.push(k); });
      utmKeys.forEach(function(k) { params.delete(k); dirty = true; });

      if (dirty) {
        var cleaned = location.pathname;
        var qs = params.toString();
        if (qs) cleaned += '?' + qs;
        cleaned += location.hash;
        history.replaceState(history.state, '', cleaned);
      }
    })();
  </script>
</head>
<body
  class={`${isRTL ? 'font-arabic' : 'font-sans'} antialiased relative min-h-screen`}
  data-cookie-banner-url={cookieBannerScriptUrl}
>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TSW9LBMG"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <!-- Page Transition Loader -->
  <div id="page-loader" class="fixed top-0 left-0 w-full h-[3px] bg-[#8B7355] z-[99999] origin-left scale-x-0 transition-transform duration-300 pointer-events-none" style="transform:translateZ(0)"></div>
  <script is:inline>
    (() => {
    const lifecycleKey = '__kssmiClientRouterLifecycle';
    const previousLifecycle = window[lifecycleKey];
    if (previousLifecycle && typeof previousLifecycle.destroy === 'function') {
      previousLifecycle.destroy();
    }

    const controller = new AbortController();
    let resetTimer = 0;

    function clearResetTimer() {
      if (!resetTimer) return;
      window.clearTimeout(resetTimer);
      resetTimer = 0;
    }

    document.addEventListener('astro:before-preparation', () => {
      clearResetTimer();
      const loader = document.getElementById('page-loader');
      if (loader) {
        loader.style.transitionDuration = '3s';
        loader.style.transform = 'scaleX(0.6)';
        document.body.style.cursor = 'wait';
      }
    }, { signal: controller.signal });
    document.addEventListener('astro:after-preparation', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        loader.style.transitionDuration = '0.3s';
        loader.style.transform = 'scaleX(1)';
        document.body.style.cursor = 'default';
      }
    }, { signal: controller.signal });
    document.addEventListener('astro:page-load', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        clearResetTimer();
        resetTimer = window.setTimeout(() => {
          resetTimer = 0;
          loader.style.transitionDuration = '0s';
          loader.style.transform = 'scaleX(0)';
          document.body.style.cursor = 'default';
        }, 300);
      }

      // Re-run URL cleanup after View Transitions
      var p2 = new URLSearchParams(location.search);
      if (p2.has('_gl') || p2.has('gclid') || p2.has('fbclid') || p2.has('msclkid')) {
        ['_gl','gclid','gclsrc','fbclid','msclkid','dclid','gbraid','wbraid','mc_cid','mc_eid','wickedid'].forEach(function(k){p2.delete(k)});
        var utmK = [];
        p2.forEach(function(_,k){if(k.indexOf('utm_')===0)utmK.push(k)});
        utmK.forEach(function(k){p2.delete(k)});
        var c = location.pathname;
        var q = p2.toString();
        if (q) c += '?' + q;
        c += location.hash;
        history.replaceState(history.state, '', c);
      }
    }, { signal: controller.signal });

    window[lifecycleKey] = {
      destroy() {
        controller.abort();
        clearResetTimer();
        document.body.style.cursor = 'default';
      },
    };
    })();
  </script>
  <!-- Accessibility: Skip to Content Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[9999] bg-[#5D4E37] text-white px-4 py-2 font-bold rounded-md shadow-lg outline-hidden focus:ring-4 focus:ring-[#8B7355]/50">
    {t.nav?.skipToContent || 'Skip to content'}
  </a>
  <style define:vars={{
    '--font-sans': 'system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif',
    '--font-arabic': 'Tahoma, Arial, sans-serif'
  }}>
    /* Base styles */
    html {
      scroll-behavior: smooth;
      overflow-x: hidden;
    }

    /* Default Latin Font */
    body {
      font-family: var(--font-sans);
    }
    body.font-arabic {
      font-family: var(--font-arabic);
    }

    /* RTL-aware spacing */
    :dir(rtl) {
      direction: rtl;
      text-align: right;
    }
    :dir(rtl) .prose {
      text-align: right;
    }
  </style>
  <main id="main-content">
    <slot />
  </main>
  <VisitorTracker />

  <!-- Cookie Banner — deferred: 18KB fetched only when consent not yet given -->
  <script>
    type StoredConsent = {
      ads?: boolean;
      analytics?: boolean;
    };

    function isStoredConsent(value: unknown): value is StoredConsent {
      return typeof value === 'object' && value !== null;
    }

    (function () {
      try {
        const rawConsent = localStorage.getItem('cookie-consent');
        const consent: unknown = rawConsent ? JSON.parse(rawConsent) : null;
        if (isStoredConsent(consent)) return; // Already consented — skip loading banner
      } catch (_) {}
      const script = document.createElement('script');
      script.src = document.body.dataset.cookieBannerUrl || '/cookie-banner.js';
      script.async = true;
      document.body.appendChild(script);
    })();
  </script>
</body>
</html>
