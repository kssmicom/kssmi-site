# ─── Gzip compression ──────────────────────────────────────────────────────
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
AddOutputFilterByType DEFLATE application/json application/xml
AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff

# ─── Brotli compression (if available on host) ─────────────────────────────
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript text/javascript
AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml

# ─── Browser cache policy ──────────────────────────────────────────────────
# OpenLiteSpeed reads rewrite rules from .htaccess but does not implement the
# Apache Header/FilesMatch cache directives here. Static Cache-Control headers
# are installed as native vhost contexts by scripts/ols-add-headers.py. Dynamic
# PHP endpoints set their own Cache-Control response header.

# ─── CSP scope override ────────────────────────────────────────────────────
# The legacy global CSP above is intentionally cleared here. Static Astro HTML
# receives a generated hash-only policy after every build. The two PHP admin
# pages are Cloudflare Access-protected and still require inline UI code, so
# they receive a narrowly scoped policy instead of breaking their rendering.
Header always unset Content-Security-Policy

<FilesMatch "\.html$">
  # Static HTML CSP BEGIN
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-hashes' sha256-qYb8LzKmV6IcWo3MyKn6oi/SuA1ICQDpUknb2WAPMSc= sha256-yDvsBa6QqVqNGBZ3j6QOJuJX/TKU5Px5JE/lyd9K4mo= sha256-gWy6zRK1lxvO5npZcmX5ubDir8+H1JKk+qPhSxV4OcI= sha256-0XtLNzajjKWx4LRI8qy80KO4+0If1qVDuGoSEWmab30= sha256-1MfhmgqALaVhlKmMfKFc3dwSVaQinpLByEq+RBP/y3E= sha256-1WD7On3n8t/2GZFjSrkMI8lSUpb7pnrkc2pcB1WmNaA= sha256-1XdNUOTII2T4SYXqrfiArd/UVMfTa3UIzSp9eF6EOQc= sha256-4e5xCYedvL9fpL/RGAeQc7X7rG5hOoSv8qQSD/Hw7D8= sha256-4onshjz2CMoc6hrLvj6QAM4XvYzCWBsWBM9lKpjS1sU= sha256-4rW/vjPMgvCg4YxkSJc+AyRDURlG3DFDd6f2vscGLqg= sha256-5ScBFEld0y6cFR/wI3K4d+wXtlOoXK6ft3ZLJfFwUuE= sha256-5h81CXe7gFHEddlzdxslfXp9dVMN8Uvp/n9FR9+0Er8= sha256-7l863TPGgFddo/SOifDKzkFwrnpUYEjp2oHSH/yBjhM= sha256-8/JNZnYmm3FLIZDuOPismcvpO5dIlfTubTO9ZFy2IzM= sha256-9p4KsfRo3B8RNeud4xODMsWg61U1YrbAjd6yThBZ1Z4= sha256-B+SbaWnrDdktb+2qjx+0vpd0mFF8AQymLPdkUkhbXhU= sha256-C3GaWvtx6xcPYcAkGKDn3Pzr+tAKFoSRtXoQD9WlRH4= sha256-DSmUIkUmb7IerEnWQXY6BuGxc4nfZhKQ5KX94vNwkH4= sha256-IfY8sT6rBvc6lbE4t27DKjc1xUx2cFMU60cG0d9KElA= sha256-JTbxpU6veEooFDA+gbEXuTvRjhYd+YQ0kH82eXaEJXs= sha256-KlZRCBaTB4JuW1jjNMGxnOel7sbUBCsj1xP0FRcyCYs= sha256-M0xGDEN9rE7QMAarKd2P0ixqt+e7PY6odIidIR2c1dc= sha256-Mg9QmRm5p5i/x0k/wOs15z8FUlDnQtyJeInAihzPSHs= sha256-MguIPR6qNR8D3B+eAlK+bIRTZe8t3wkOY4B/56Me9FU= sha256-NJW00qngrOy6UYrCfm3MO1mI+WfwRjY1AfHQr4xmQ38= sha256-P2KtN2cGDMzYSasiU76sNye7WJYBb7yFGWFQrJW9yW8= sha256-PMpYZ6HJCn5Cxk9FKOwP6U5v/ZzKnFkdPxlN9pIMrk0= sha256-Qoqnq5GpYGUFcKHo+a886dKlvwswlEfsFe9kmmQHaec= sha256-R5Xtr/TKXZkv7RBo/X7ypKCw/pjPWUy9d429ODc21LA= sha256-RmdW5kUZZhAYfO/6sJeLfQKH/8d4ibVOYghUfZFphpc= sha256-StxQILmcw36QFuzi/xfljykIyPLJoq+4tQG6/SNFfpc= sha256-TlPax0u4yzFXXe0Un6WcAx0RzheCPxep9pfA1N5f6gI= sha256-UacvZHRK8dHje/Wo1dhpsewUDibk0WgZrbxDOWqTKCA= sha256-UlEF9LDZqxQ381mI6YWMQnsvqdxQLSNKUSmQ7mme1Wc= sha256-X6ILfimB2Eieze5SNY4JzvxERoRj7miFiOmRLdVWkIk= sha256-YROGp+zkjVkM3GcOFNb0pmxo/O8goS3Z36Lw7C