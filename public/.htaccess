# KSSMI Site — OpenLiteSpeed Configuration
# IMPORTANT: OLS does NOT recognize <IfModule mod_headers.c> etc.
# All directives must be bare (no IfModule wrappers) or OLS silently skips them.

# Enable rewrite engine
Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ─── Block sensitive files (403 Forbidden) ───────────────────────────────────
RewriteRule ^email-logs\.json$ - [F,L]
RewriteRule ^\.email_logs_password$ - [F,L]
RewriteRule ^\.email_reset_tokens\.json$ - [F,L]
RewriteRule ^ip-debug\.log$ - [F,L]
RewriteRule ^ip-debug\.php$ - [F,L]
RewriteRule ^php-status\.php$ - [F,L]
RewriteRule ^vjt-db-setup\.php$ - [F,L]

# ─── Block VJT data directory (contains raw visitor JSON files with IPs, emails) ──
RewriteRule ^api/vjt_data(/.*)?$ - [F,L]

# ─── Admin backends: IP whitelist (REPLACE 'all denied' with 'ip YOUR.PUBLIC.IP' after deploy) ──
# Default is 'Require all denied' so that forgetting to replace still keeps the admin pages
# safely locked. To enable your own access:
#   1. Run in FinalShell: curl -s ifconfig.me            (note the IP, e.g. 203.0.113.45)
#   2. Run in FinalShell:
#        sed -i 's/Require all denied/Require ip 203.0.113.45/' /home/kssmi.com/public_html/.htaccess
#      (replace 203.0.113.45 with your real IP)
#   3. Reload https://kssmi.com/email-logs.php in browser — should now load login page
# To allow multiple IPs (e.g. office + home): add multiple `Require ip x.x.x.x` lines.
# If your IP changes frequently (dynamic IP), consider Cloudflare Access (Zero Trust) instead.
<Files "email-logs.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
<Files "visitor-journey.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# ─── PHP API endpoints (pass through as-is) ────────────────────────────────
RewriteRule ^send-mail\.php$ - [L]
RewriteRule ^email-logs\.php$ - [L]

# ─── /en has no homepage — force branded 404 ──────────────────────────────
# English is the default locale (prefixDefaultLocale: false), so it lives at the
# site root and there is NO /en/index.html. The /en/ directory only exists to
# hold generated files (/en/sitemap.xml, /en/llms.txt, …). A bare request to
# /en or /en/ would otherwise match the directory pass-through below (-d) and
# return an empty/403 listing instead of the 404 page. Route it to the PHP
# router explicitly. Real sub-files like /en/sitemap.xml still pass through via
# the static-asset rule (they are matched by -f). MUST stay above the -d rule.
RewriteRule ^en/?$ /404-router.php [L]

# ─── HTTPS redirect (MUST be before static-asset [L] rules) ────────────────
# Checks both Cloudflare proxy (X-Forwarded-Proto) and direct connections
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── Static assets (pass through as-is) ────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ─── Astro static site: serve index.html for clean URLs ────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# ─── 404 handler — internal rewrite to PHP router ──────────────────────────
# Any path that is not a real file/dir and was not served as a clean URL above
# is handed to the PHP router, which sets a real 404 status and serves the
# correct-language 404 page. No [R=404] (OLS discards the target and shows the
# default server error page) and no reliance on ErrorDocument firing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/404-router\.php$
RewriteRule ^ /404-router.php [L]

# Backup layer in case the rewrite above is bypassed.
ErrorDocument 404 /404-router.php

# ─── Security headers (bare — no IfModule wrappers for OLS compatibility) ───
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-hashes' sha256-cHRZznX9WCI4PbyToF2KXT+0Hk8m7dNdutQVT+T86Cc= sha256-1KlLGlbXswujz+I4OhO1Ou9vsyLyjt4ZmllJd6Egv7E= sha256-TbeHB1Un+++Q1iQytUuo0J0zSW32KsEfpZL4xHSfhAo= sha256-EMw88XkhypSkzSrvl5FHAquiVFepN1XVj540uHINCb4= sha256-a6eRVfEDMZYoWEk4qDGAysOdxI56IlSpP1DYgIu7NDM= sha256-WF6ADSl9aRtoUFfuq8FmEJxHNbhhGs6vB+pws25GuSY= sha256-1OcPBjVyzyhiPhK+dq2Qwme9akIe0qux+bDiVEvUkrI= sha256-Tx9JCleNafKzGE6qUuHntd3RgtIlrpfo1f0GI9zsQOg= sha256-LCxR+YE24pY4TwiwSXHunyUDDkZItVnkEv5ay6E+Ajw= sha256-BrwsPFZwj72vaHMoFJhxZ+UyJwF41YNdB3E7jhZy5H4= sha256-KV+5qJP/nBgOgV+X2XxwFE+YiITY444WfEqEL2lqnAQ= sha256-VcOiq6o1WFsvwDrUKmtR8Bj+wojyvz4wtOwyt4DAd7A= sha256-qYb8LzKmV6IcWo3MyKn6oi/SuA1ICQDpUknb2WAPMSc= sha256-yDvsBa6QqVqNGBZ3j6QOJuJX/TKU5Px5JE/lyd9K4mo= sha256-gWy6zRK1lxvO5npZcmX5ubDir8+H1JKk+qPhSxV4OcI= sha256-GGCCObxaG2OUV1I/q1CSN0g+fcbfP7FWzFEiH+Cmryw= sha256-49PrVDAzriB71+zhdnyIWbkN3xxTHFhqAcVdrXp0f04= sha256-MguIPR6qNR8D3B+eAlK+bIRTZe8t3wkOY4B/56Me9FU= sha256-RmdW5kUZZhAYfO/6sJeLfQKH/8d4ibVOYghUfZFphpc= sha256-PMpYZ6HJCn5Cxk9FKOwP6U5v/ZzKnFkdPxlN9pIMrk0= https://static.cloudflareinsights.com https://challenges.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' sha256-Rsr9KierypRmdOrY4fX6kHqN43U4uBc1Qpu57W+g6qo= sha256-WJFXpYjh1nqKuom60I3CXwKvDdZOKeh439LBxrIwbm4= sha256-PzEFu4f0B4ybzSklHnwYq5nuc6M5s6VcbmDzvSXaFy0= sha256-NchA/Hy5p/QhIrmEEiish+SNixEb6u34/a9AuDn/S1U= sha256-0mHKfvsAmKi6V6mW60nixZZhDFnap7QJKFgUnQg5/vY= sha256-50vi+mmN/MAcZQ/eBN2mc6/6bhm3LPBKpxLyeVRDVh4= sha256-qJ+K/dexjqoy+bccgDWC8rvaptg+d1QlfZ0PHMlYqQE= sha256-UVPBpYYO3fBmlKU9dIy0ULUxxVXdhPsjqg5sLZtmVG8= sha256-8WYUooVKhv7rkNCOZig4LjYKvJwzx4KxksdkDpaXeTE= https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' blob: https://video.gumlet.io https://*.gumlet.io; connect-src 'self' https://ipapi.