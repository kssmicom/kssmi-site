# ─── Gzip compression ──────────────────────────────────────────────────────
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
AddOutputFilterByType DEFLATE application/json application/xml
AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff

# ─── Brotli compression (if available on host) ─────────────────────────────
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript text/javascript
AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml

# ─── Browser cache policy ──────────────────────────────────────────────────
# OpenLiteSpeed reads rewrite rules from .htaccess but does not implement the
# Apache Header/FilesMatch cache directives here. Static Cache-Control headers
# are installed as native vhost contexts by scripts/ols-add-headers.py. Dynamic
# PHP endpoints set their own Cache-Control response header.

# ─── CSP scope override ────────────────────────────────────────────────────
# The legacy global CSP above is intentionally cleared here. Static Astro HTML
# receives a generated hash-only policy after every build. The two PHP admin
# pages are Cloudflare Access-protected and still require inline UI code, so
# they receive a narrowly scoped policy instead of breaking their rendering.
Header always unset Content-Security-Policy

<FilesMatch "\.html$">
  # Static HTML CSP BEGIN
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-hashes' 'sha256-+kM8cg5taZgWGGzZFGDss1B3MvJ1Fl5Obkg8U3htE54=' 'sha256-/sk7dWR1FmAra5caP5kqnSXWdyzeDpSrnoHEP4gKox0=' 'sha256-1COh61GSgUZGbQVZ9WU6K7YLSwNAM6+gUGZF5zrCn1E=' 'sha256-1vc8hTvZa9Etj31YHJ7f/vtD5wB0HCe+g4dqt/Yp0h8=' 'sha256-2TEk5KSxPkViJVpiZc5JoDHAaDExWvMTZyk5Y2fl+X8=' 'sha256-4rW/vjPMgvCg4YxkSJc+AyRDURlG3DFDd6f2vscGLqg=' 'sha256-6ZD9EPRYNXhjb/lNa496ljYMozHZimzvzhRWLAMBzFM=' 'sha256-7Z6Ohwf/CwnHigwog5RMbNaDe50m9CQXwbB2T7C57Jk=' 'sha256-8JudFnU8PKp1LRhvLrvYbihsy1WvlNLqYndce10TpR0=' 'sha256-9tYar7GY1bBM0GKQbdnBfhIHt+elL1Bbxrhfddwbdgw=' 'sha256-Au4URVzuXjbmLxY+6afRPZWctDxRgXuKNU4brCp9Bzk=' 'sha256-D15iwbE1qS8bN5yHpC37HqYDELi8WB5XIdpZiUS8oP8=' 'sha256-D90bqub8zO51pjdZyLb+eYUO8YzWSbmwNg2Mjnpr5Gg=' 'sha256-D9eB5Sxh3LSH2OEr4AnzqWd3Hr38nAUqwyf/zwRv5EQ=' 'sha256-EeYuXoq6LMMaYkaiHQg53CP3BxktNnDvSj8IcJG3ZOA=' 'sha256-IfY8sT6rBvc6lbE4t27DKjc1xUx2cFMU60cG0d9KElA=' 'sha256-InD56flGWlb+v+Le3cI88weNH8xK31Kv6r2NjyNFs6I=' 'sha256-J3g2MoSvB6+QJeDxzu45onWcWnxgFxZjwYtibJBA6f4=' 'sha256-JGL2Izj223qCu69B466U7tQslh2A5MdN9pQ/s7xqr8g=' 'sha256-JNKPsE+uq35dVukKEFmrNud0AEYbBerVpvzbu9Ouorg=' 'sha256-M0xGDEN9rE7QMAarKd2P0ixqt+e7PY6odIidIR2c1dc=' 'sha256-MguIPR6qNR8D3B+eAlK+bIRTZe8t3wkOY4B/56Me9FU=' 'sha256-O+6WcOVN0IyguZ5BmxZiVg0Td1nB8WCf6yTw7bkktys=' 'sha256-Q9leI+aL1PdKLjpFHbCInRGWWgTIuUO0QfaaeejP/yY=' 'sha256-QK1N+ZfUX3SFQVSyc4Gh6F1xOspsMdH1Yo+IWgIllC0=' 'sha256-R88n/geJUoTSVmP5e4Tu62fiOIueZq86Z8Sh3tDPpxI=' 'sha256-RmRFLKIv9HF/sxgjpRUFDYKrwfEV9hr23Ae5FMTyzQo=' 'sha256-SifyoKnjIAbhbxDo/0ddIT+IDEol5+ZdCPfXHTuEysI=' 'sha256-T0WgIVaejzMWBF9FwZ0deILeO1s5qTL3cFyRQn0LmwE=' 'sha256-TOmZ7lEHHFF+pDYKKBrDjsfDJYv9IDkSlukXiWWdrUo=' 'sha256-UHyZYLBUVa4s8QFQnQSSgtkJKIss88JZ/yw5ZpRh8ZU=' 'sha256-VRLkENRLaYdeBUyeyf2kMNFRQQH4vPcKgVaeIEszxv4=' 'sha256-WJy3s97cvj/+n9TVP+jy+rr9SaOAQ1OlmEWF8FOFGc4=' 'sha256-WTO7iByY2ffxHWuFSIc6lFKI0ueE/7h9HhQS9PBVGKA=' 'sha256-WVQfTlDMiUfiR/wbrqjKA