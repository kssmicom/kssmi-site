# KSSMI Site — OpenLiteSpeed Configuration
# IMPORTANT: OLS does NOT recognize <IfModule mod_headers.c> etc.
# All directives must be bare (no IfModule wrappers) or OLS silently skips them.

# Enable rewrite engine
Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ─── Block sensitive files (403 Forbidden) ───────────────────────────────────
RewriteRule ^email-logs\.json$ - [F,L]
RewriteRule ^\.email_logs_password$ - [F,L]
RewriteRule ^\.email_reset_tokens\.json$ - [F,L]
RewriteRule ^ip-debug\.log$ - [F,L]
RewriteRule ^ip-debug\.php$ - [F,L]
RewriteRule ^php-status\.php$ - [F,L]
RewriteRule ^vjt-db-setup\.php$ - [F,L]

# ─── Block VJT data directory (contains raw visitor JSON files with IPs, emails) ──
RewriteRule ^api/vjt_data(/.*)?$ - [F,L]

# ─── Admin backends: IP whitelist (REPLACE 'all denied' with 'ip YOUR.PUBLIC.IP' after deploy) ──
# Default is 'Require all denied' so that forgetting to replace still keeps the admin pages
# safely locked. To enable your own access:
#   1. Run in FinalShell: curl -s ifconfig.me            (note the IP, e.g. 203.0.113.45)
#   2. Run in FinalShell:
#        sed -i 's/Require all denied/Require ip 203.0.113.45/' /home/kssmi.com/public_html/.htaccess
#      (replace 203.0.113.45 with your real IP)
#   3. Reload https://kssmi.com/email-logs.php in browser — should now load login page
# To allow multiple IPs (e.g. office + home): add multiple `Require ip x.x.x.x` lines.
# If your IP changes frequently (dynamic IP), consider Cloudflare Access (Zero Trust) instead.
<Files "email-logs.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
<Files "visitor-journey.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# ─── PHP API endpoints (pass through as-is) ────────────────────────────────
RewriteRule ^send-mail\.php$ - [L]
RewriteRule ^email-logs\.php$ - [L]

# ─── /en has no homepage — force branded 404 ──────────────────────────────
# English is the default locale (prefixDefaultLocale: false), so it lives at the
# site root and there is NO /en/index.html. The /en/ directory only exists to
# hold generated files (/en/sitemap.xml, /en/llms.txt, …). A bare request to
# /en or /en/ would otherwise match the directory pass-through below (-d) and
# return an empty/403 listing instead of the 404 page. Route it to the PHP
# router explicitly. Real sub-files like /en/sitemap.xml still pass through via
# the static-asset rule (they are matched by -f). MUST stay above the -d rule.
RewriteRule ^en/?$ /404-router.php [L]

# ─── Static assets (pass through as-is) ────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ─── Astro static site: serve index.html for clean URLs ────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]


# ─── HTTPS redirect ────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# ─── 404 handler — internal rewrite to PHP router ──────────────────────────
# Any path that is not a real file/dir and was not served as a clean URL above
# is handed to the PHP router, which sets a real 404 status and serves the
# correct-language 404 page. No [R=404] (OLS discards the target and shows the
# default server error page) and no reliance on ErrorDocument firing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/404-router\.php$
RewriteRule ^ /404-router.php [L]

# Backup layer in case the rewrite above is bypassed.
ErrorDocument 404 /404-router.php

# ─── Security headers (bare — no IfModule wrappers for OLS compatibility) ───
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' blob: https://video.gumlet.io https://*.gumlet.io; connect-src 'self' https://ipapi.co https://cloudflareinsights.com https://www.google-analytics.com https://video.gumlet.io https://*.gumlet.io; frame-src 'self' https://play.gumlet.io https://challenges.cloudflare.com https://www.googletagmanager.com; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests;"

# ─── Report-Only CSP (P2-5 target: hash-based, no 'unsafe-inline') ─────────
# This is the GOAL — browsers evaluate & report violations but do NOT block.
# Once 30-day monitoring shows zero unexpected violations, switch this from
# Report-Only → Content-Security-Policy (replacing the enforcing header above).
#
# Hashes were computed from src/ Astro source; re-run on build output before
# final switch (Astro may modify scripts during SSR/build).
# Regenerate with: node -e "const c=require('crypto');process.stdin.setEncoding('utf8');let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>console.log('sha256-'+c.createHash('sha256').update(d).digest('base64')))" < script.js
#
# Layout.astro (7 scripts + 1 style):
#   sha256-vmsxtuhHypdK60yNyo/XvRCbgBpuGsHj/PA0Oc1M9lg=  Consent Mode v2
#   sha256-xsUXGXAkmBFwIsM3Bv4wCB1D6ZPSYxKGM/gc0YxaI7k=  GTM lazy-load
#   sha256-ujAkpxfS/7Iq0WS8rjQmbOzB+FTQSiEpRGKUqbdaO50=  Deferred Google Fonts
#   sha256-qnGLSerJCltoEbLjeFj6yKLeBELUlYR2mqlJCiHEZ7s=  Cloudflare Analytics
#   sha256-XLcb45yydkObZtjgjn4sKpkD69AVBUu7trf9yMSeE10=  URL tracking cleanup
#   sha256-INLA7yjYJIHCsIh7QFedpNv3lSeUensH6XV1ncRy0Ks=  Page Transition Loader
#   sha256-yrHYvgqgevZ77i22HBTRTBtYltbGa7Lgcvq27pjJIR4=  Cookie Banner lazy-load
#   sha256-MUMhOVB+cxlHpzShb0W4kfsTG8Kxwlvk7Sk+5Wz5Rjc=  Layout base styles
# Footer.astro:      sha256-Ba/SW79UVJIuLJnujE8wstzMITGMVY7WFiEIwVQuImI=  scrollTop+email
# Header.astro:      sha256-eBTDmQ3958OKknRtT6loWJKwNpz8fenOWBjbgE/rWxQ=  megaMenu+lang+transparent header
#   style:           sha256-tYJGnnIHHUQH2WgiOOS1Zh79b5TsM4xHBOWwOjiHXH8=  Header scoped CSS
#   style:           sha256-kfTv1x2ch9ACUiH+Az2G13zoqKMVyW29wzctbObEm0Y=  search input hide
#   style:           sha256-tORKHB248Ajf6snE+JNeZyKps2pn1nBYfxPM6moClLY=  transparent header scroll
# InquiryForm.astro: sha256-bR+ozgTMTT1ncT4+if/ll+IC41yBdNpYSvYz6DAHJ6I=  Turnstile config
#                    sha256-eMrR5c7YYBKC7Af5bGQY90xWgpt2iTWGDAKtMA1wzPk=  Turnstile lazy-load
#                    sha256-9ngk949lEpahr0akdIAQzTfuiHNJO+U14ILK1Glm5Y0=  Form submission handler
# LanguagePicker:    sha256-s5n3Ee6jJwOPGOYzCfjm9w1ZLigokkrBReNnSLB74S0=  custom element
#   style:           sha256-/Xz+IhMaXszH14U7zd/EezYSq+xjAHLRo7G4QLGMfLI=  scrollbar hide
#
# ⚠️  Missing hashes (will appear as violations during monitoring):
#   - NotFoundPage.astro (Turnstile + mailto form)
#   - SearchPage.astro (search results pagination)
#   - Product gallery pages (zoom, thumbnail swap)
#   - TechnicalSpecs.astro (print onclick)
#   - RelatedProducts.astro (img onerror)
#   - InquiryFormLazy.astro (dynamic form loader)
#   - Pagination.astro (search clear button)
#   - Collection components (various keyframe styles)
Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-vmsxtuhHypdK60yNyo/XvRCbgBpuGsHj/PA0Oc1M9lg=' 'sha256-xsUXGXAkmBFwIsM3Bv4wCB1D6ZPSYxKGM/gc0YxaI7k=' 'sha256-ujAkpxfS/7Iq0WS8rjQmbOzB+FTQSiEpRGKUqbdaO50=' 'sha256-qnGLSerJCltoEbLjeFj6yKLeBELUlYR2mqlJCiHEZ7s=' 'sha256-XLcb45yydkObZtjgjn4sKpkD69AVBUu7trf9yMSeE10=' 'sha256-INLA7yjYJIHCsIh7QFedpNv3lSeUensH6XV1ncRy0Ks=' 'sha256-yrHYvgqgevZ77i22HBTRTBtYltbGa7Lgcvq27pjJIR4=' 'sha256-Ba/SW79UVJIuLJnujE8wstzMITGMVY7WFiEIwVQuImI=' 'sha256-eBTDmQ3958OKknRtT6loWJKwNpz8fenOWBjbgE/rWxQ=' 'sha256-bR+ozgTMTT1ncT4+if/ll+IC41yBdNpYSvYz6DAHJ6I=' 'sha256-eMrR5c7YYBKC7Af5bGQY90xWgpt2iTWGDAKtMA1wzPk=' 'sha256-9ngk949lEpahr0akdIAQzTfuiHNJO+U14ILK1Glm5Y0=' 'sha256-s5n3Ee6jJwOPGOYzCfjm9w1ZLigokkrBReNnSLB74S0=' https://static.cloudflareinsights.com https://challenges.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'sha256-MUMhOVB+cxlHpzShb0W4kfsTG8Kxwlvk7Sk+5Wz5Rjc=' 'sha256-tYJGnnIHHUQH2WgiOOS1Zh79b5TsM4xHBOWwOjiHXH8=' 'sha256-kfTv1x2ch9ACUiH+Az2G13zoqKMVyW29wzctbObEm0Y=' 'sha256-tORKHB248Ajf6snE+JNeZyKps2pn1nBYfxPM6moClLY=' 'sha256-/Xz+IhMaXszH14U7zd/EezYSq+xjAHLRo7G4QLGMfLI=' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' blob: https://video.gumlet.io https://*.gumlet.io; connect-src 'self' https://ipapi.co https://cloudflareinsights.com https://www.google-analytics.com https://video.gumlet.io https://*.gumlet.io; frame-src 'self' https://play.gumlet.io https://challenges.cloudflare.com https://www.googletagmanager.com; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests;"

# ─── Gzip compression ──────────────────────────────────────────────────────
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
AddOutputFilterByType DEFLATE application/json application/xml
AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff

# ─── Brotli compression (if available on host) ─────────────────────────────
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript text/javascript
AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml

# ─── Cache static assets via Expires ───────────────────────────────────────
ExpiresActive On

# Images — 1 year
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/png  "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/gif  "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

# Fonts — 1 year
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff  "access plus 1 year"
ExpiresByType application/font-woff2 "access plus 1 year"

# CSS — 1 year
ExpiresByType text/css "access plus 1 year"

# JS — 1 year (all common MIME types)
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType application/x-javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"

# ─── Cache-Control headers ─────────────────────────────────────────────────
# CSS bundles — immutable (Astro hashes filenames)
<FilesMatch "\.css$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# JS bundles — immutable (Astro hashes filenames)
<FilesMatch "\.js$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Exception: vjt-tracker.js has NO content hash, so it must NOT be immutable
<FilesMatch "^vjt-tracker\.js$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>

# All image types — 1 year
<FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|avif)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>

# Fonts — 1 year
<FilesMatch "\.(woff2|woff|ttf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML — short cache so updates deploy quickly
<FilesMatch "\.html$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>
