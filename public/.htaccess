# KSSMI Site — Apache Configuration
# Ensure AllowOverride All is set on the server for this to work

# Enable rewrite engine
Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ─── Block sensitive files (403 Forbidden) — LiteSpeed compatible ────────────
RewriteRule ^email-logs\.json$ - [F,L]
RewriteRule ^\.email_logs_password$ - [F,L]
RewriteRule ^\.email_reset_tokens\.json$ - [F,L]
RewriteRule ^ip-debug\.log$ - [F,L]
RewriteRule ^ip-debug\.php$ - [F,L]
RewriteRule ^php-status\.php$ - [F,L]
RewriteRule ^vjt-db-setup\.php$ - [F,L]

# ─── Block VJT data directory (contains raw visitor JSON files with IPs, emails) ──
RewriteRule ^api/vjt_data(/.*)?$ - [F,L]

# ─── PHP API endpoints (pass through as-is) ────────────────────────────────
RewriteRule ^send-mail\.php$ - [L]
RewriteRule ^email-logs\.php$ - [L]

# ─── Static assets (pass through as-is) ────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ─── Astro static site: serve index.html for clean URLs ────────────────────
# e.g. /product → /product/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# ─── HTTPS redirect ────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── 404 handler ───────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# LiteSpeed/Apache fallback: internally serve 404.html for any missing file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /404.html [L]

# ─── Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── Gzip compression ──────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# ─── Brotli compression (if available on host) ─────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# ─── Cache static assets ───────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Images — 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # Fonts — 1 year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Astro hashed JS/CSS bundles — 1 year immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# ─── Cache-Control headers ─────────────────────────────────────────────────
# NOTE: FilesMatch in Apache/LiteSpeed matches the FILENAME only, not the path.
<IfModule mod_headers.c>
  # Astro hashed JS bundles — immutable (filename contains content hash)
  # Exception: vjt-tracker.js has no hash, must NOT be immutable
  <FilesMatch "^(?!vjt-tracker).*\.(js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # VJT tracker — short cache so fixes deploy quickly
  <FilesMatch "^vjt-tracker\.js$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # CSS bundles — immutable
  <FilesMatch "\.(css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # All image types — 1 year
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Fonts — 1 year
  <FilesMatch "\.(woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — short cache so updates deploy quickly
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
