{
  "name": "kssmi-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/validate-content.mjs && node scripts/validate-email-log-policy.mjs && node src/scripts/generate-llms.js && node src/scripts/generate-sitemap.js",
    "build": "astro build && node scripts/materialize-runtime-assets.mjs dist && node scripts/generate-csp-hashes.mjs dist && node scripts/validate-hreflang.mjs dist",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate-content.mjs",
    "validate:cache": "node scripts/validate-cache-policy.mjs",
    "validate:dom": "node scripts/validate-dom-policy.mjs",
    "validate:lcp": "node scripts/validate-lcp-policy.mjs",
    "validate:email-logs": "node scripts/validate-email-log-policy.mjs",
    "validate:astro-syntax": "node scripts/validate-astro-syntax.mjs",
    "validate:translations": "node scripts/validate-translations.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.1.3",
    "astro-pagefind": "^2.0.1",
    "baseline-browser-mapping": "^2.10.40",
    "caniuse-lite": "^1.0.30001800",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "pagefind": "^1.4.0"
  }
}
