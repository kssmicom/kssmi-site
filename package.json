    "test:runtime-assets": "node scripts/test-runtime-assets.mjs",
    "test:permissions": "bash scripts/test-permission-policy.sh",
    "test:runtime-identity": "php scripts/runtime-capability-probe.php --identity-self-test",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
