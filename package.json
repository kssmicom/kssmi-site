    "build": "node scripts/prepare-short-link-map-assets.mjs && astro build && node scripts/materialize-runtime-assets.mjs dist && node scripts/generate-csp-hashes.mjs dist && node scripts/validate-hreflang.mjs dist",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate-content.mjs",
    "validate:cache": "node scripts/validate-cache-policy.mjs",
    "validate:dom": "node scripts/validate-dom-policy.mjs",
    "validate:lcp": "node scripts/validate-lcp-policy.mjs",
    "validate:email-logs": "node scripts/validate-email-log-policy.mjs",
    "validate:astro-syntax": "node scripts/validate-astro-syntax.mjs",
    "validate:translations": "node scripts/validate-translations.mjs",
    "validate:release": "node scripts/validate-release-policy.mjs",
    "validate:admin-origin": "node scripts/validate-admin-origin-policy.mjs",
    "validate:password-reset": "node scripts/validate-password-reset-policy.mjs",
    "validate:admin-input-session": "node scripts/validate-admin-input-session-policy.mjs",
    "validate:security": "node scripts/validate-security-policy.mjs",
    "validate:cloudflare-ranges": "node scripts/validate-cloudflare-ranges.mjs",
    "validate:cloudflare-audit": "node scripts/validate-cloudflare-audit-policy.mjs",
    "validate:tls-policy": "node scripts/validate-tls-policy.mjs",
    "validate:runtime-assets": "node scripts/validate-runtime-assets.mjs",
    "validate:interactions": "node scripts/validate-interaction-policy.mjs",
    "validate:permissions": "node scripts/validate-permission-policy.mjs",
    "validate:runtime-identity": "node scripts/validate-runtime-identity-policy.mjs",
    "validate:promotion": "node scripts/validate-promotion-policy.mjs",
    "validate:rollback-safety": "node scripts/validate-rollback-safety-policy.mjs",
    "validate:release-evidence": "node scripts/validate-release-evidence-policy.mjs",
