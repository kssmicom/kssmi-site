  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.1.3",
    "astro-pagefind": "^2.0.1",
    "baseline-browser-mapping": "^2.10.40",
    "caniuse-lite": "^1.0.30001800",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "leaflet": "^1.9.4",
