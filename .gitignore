# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
build*.log
check*.log
# Generated build logs (inline comments are not supported in ignore patterns).
/build-output.txt
/_build.log

# environment variables
.env
.env.production
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Private configuration (contains secrets - server has separate copy)
private_config.php

# Email logs (sensitive data - don't commit)
public/email-logs.json
public/email-logs.php
public/.email_logs_password
public/.email_reset_tokens.json

# Admin credentials and email data that the PHP backends create at the
# repository root when run locally (production keeps them in /home/kssmi.com).
/.email_logs_password
/.email_reset_tokens.json
/.email_reset_tokens.json.lock
/.admin_credential_generation
/.admin_credential_generation.lock
/.admin_credential_version
/email_data/

# Local agent tool settings (machine-specific commands and paths)
.agent/

# Short-links tool accounts (bcrypt hashes - lives on the server only)
short-links-users.txt
private/short-links-reset-tokens.json
# Runtime flock sidecars (created next to the files they guard)
.email_logs_password.lock
short-links-users.txt.lock
private/short-links-reset-tokens.json.lock

# PHPMailer is installed by CI (deploy.yml "Install PHPMailer" step) from
# public/composer.lock — never commit a local copy
public/vendor/autoload.php
public/vendor/composer/
public/vendor/phpmailer/

# Windows files
Thumbs.db
desktop.ini

# Generated sitemap files (produced by npm run prebuild)
public/sitemap.xml
public/sitemap.xsl

# Rate limiter cache directory (created at runtime by public/api/rate-limit.php
# when APCu is unavailable; lives at <repo_root>/rate_limit/ in dev or
# /home/kssmi.com/rate_limit/ in production — outside webroot in both cases)
rate_limit/

# Build artifacts in public/ language directories (generated by prebuild scripts)
public/ar/
public/de/
public/en/
public/es/
public/fr/
public/hi/
public/it/
public/ja/
public/jv/
public/ko/
public/ms/
public/pt/
public/ru/
public/tg/
public/tr/
public/vi/
public/zh/
public/pagefind/
.gstack/

# Generated by the prebuild step (src/scripts/generate-sitemap.js and
# generate-llms.js) on every build. Not tracked, so a local build no longer
# leaves dozens of modified files behind.
/public/sitemap.xml
/public/sitemap.xsl
/public/llms.txt
/public/*/sitemap*.xml
/public/*/llms*.txt

# Playwright browser smoke test output
test-results/
playwright-report/
